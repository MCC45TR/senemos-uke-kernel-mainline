+/* Caller holds the transaction lock; cache validity never grants control. */
+static bool qcom_battmgr_uke_protection_cache_live(struct qcom_battmgr *battmgr, u64 now)
+{
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+
+	return battmgr->protection.received_ns && now >= battmgr->protection.received_ns &&
+		now - battmgr->protection.received_ns <= 5ULL * NSEC_PER_SEC &&
+		battmgr->protection.generation == tx->generation &&
+		battmgr->protection.firmware == tx->firmware_generation &&
+		battmgr->protection.source == tx->source_generation && battmgr->service_up &&
+		!tx->desynced && !tx->suspended && !tx->removing;
+}
