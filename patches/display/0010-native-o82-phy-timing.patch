From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] drm/msm/dsi: retain the exact Uke O82 PHY timings

Both Uke O82 panel variants override the same fourteen PHY timing cells in
MiCode display-DT 4a3e1c391130237c5e8c2b250d1c94f3e25b9b11,
display/uke-sde-display.dtsi. The GPL-2.0-only display driver at
44275c404a677d9d9e5230fedd1af2ef02fc7b9a writes those cells directly in
msm/dsi/dsi_phy_hw_v4_0.c:dsi_phy_hw_v4_0_commit_phy_timing().
The active native12 register capture differs in six fields despite its
approximately identical 60 Hz link clock. This is a physical test candidate,
not evidence that these differences caused the blank image.

Use named timing fields and the existing PHY register writer, then preserve
its normal shared pre/post propagation to the host. Require the isolated
O82/Uke-specific PHY compatible, exact Uke/SM7675 root identity, D-PHY, valid
link id and the reviewed 60 Hz clock window before replacing the calculated
fields. Other PHYs keep their existing calculation. Higher rates stay refused
until separately qualified. Clock division, PLL and runtime PM are unchanged.
The 14 raw timing cells require no new userspace writer or generic override API.

Signed-off-by: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
---
diff --git a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
index 5d805a7..19a0330 100644
--- a/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
+++ b/drivers/gpu/drm/msm/dsi/phy/dsi_phy_7nm.c
@@ -8,6 +8,7 @@
 #include <linux/clk.h>
 #include <linux/clk-provider.h>
 #include <linux/iopoll.h>
+#include <linux/of.h>
 
 #include "dsi_phy.h"
 #include "dsi.xml.h"
@@ -957,6 +958,36 @@ static void dsi_phy_hw_v4_0_lane_settings(struct msm_dsi_phy *phy)
 	}
 }
 
+static int dsi_7nm_uke_o82_timing(struct msm_dsi_phy *phy,
+		const struct msm_dsi_phy_clk_request *clk_req)
+{
+	struct msm_dsi_dphy_timing *timing = &phy->timing;
+
+	if (!of_device_is_compatible(phy->pdev->dev.of_node,
+				    "xiaomi,uke-o82-dsi-phy-4nm"))
+		return 0;
+	/* shortcut: 60 Hz only; widen after per-mode physical qualification. */
+	if (phy->cphy_mode || phy->id < 0 || phy->id >= 2 ||
+	    !of_machine_is_compatible("xiaomi,uke") ||
+	    !of_machine_is_compatible("qcom,sm7675") ||
+	    clk_req->bitclk_rate < 1189187000UL ||
+	    clk_req->bitclk_rate > 1189191000UL)
+		return -EINVAL;
+
+	/* Exact Uke O82 PHY bytes from MiCode display-DT 4a3e1c391130. */
+	timing->clk_zero = 0x27;
+	timing->clk_prepare = 0x0a;
+	timing->clk_trail = 0x0a;
+	timing->hs_exit = 0x1b;
+	timing->hs_zero = 0x19;
+	timing->hs_prepare = 0x0a;
+	timing->hs_trail = 0x0b;
+	timing->hs_rqst = 0x0a;
+	timing->shared_timings.clk_pre = 0x20;
+	timing->shared_timings.clk_post = 0x0f;
+	return 0;
+}
+
 static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 			      struct msm_dsi_phy_clk_request *clk_req)
 {
@@ -981,6 +1012,8 @@ static int dsi_7nm_phy_enable(struct msm_dsi_phy *phy,
 		ret = msm_dsi_cphy_timing_calc_v4(timing, clk_req);
 	else
 		ret = msm_dsi_dphy_timing_calc_v4(timing, clk_req);
+	if (!ret)
+		ret = dsi_7nm_uke_o82_timing(phy, clk_req);
 	if (ret) {
 		DRM_DEV_ERROR(&phy->pdev->dev,
 			      "%s: PHY timing calculation failed\n", __func__);
