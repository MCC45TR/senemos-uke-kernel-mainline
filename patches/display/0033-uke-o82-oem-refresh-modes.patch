From: MCC45TR <mcc45tr@users.noreply.github.com>
Subject: [PATCH] drm/msm/dsi: admit the seven exact Uke O82 OEM modes

MiCode display-DT 4a3e1c391130237c5e8c2b250d1c94f3e25b9b11
provides three timing groups and seven VFP modes, all with the same
1.18919 GHz lane clock. Keep native50 clock quantization, grouped commands,
paired completion and quarantine. Admit only exact O82-42 modes under the
new explicit profile. Preserve the preceding isolated 120 Hz control.

--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -14,6 +14,7 @@
 #include <linux/mfd/syscon.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
+#include <drm/uke-o82-mode.h>
 #include <linux/of_irq.h>
 #include <linux/pinctrl/consumer.h>
 #include <linux/pm_opp.h>
@@ -251,6 +252,34 @@
 		msm_host->ctrl_size >= UKE_DSI_MISR_SIGNATURE + sizeof(u32);
 }
 
+static bool dsi_uke_o82_refresh_selected(struct msm_dsi_host *msm_host)
+{
+	struct device_node *panel;
+	bool selected;
+
+	if (!dsi_uke_misr_scope(msm_host))
+		return false;
+	panel = of_graph_get_remote_node(msm_host->pdev->dev.of_node, 1, -1);
+	selected = of_device_is_compatible(panel, "xiaomi,o82-42-02-0b") &&
+		of_property_read_bool(panel, "xiaomi,oem-refresh-modes");
+	of_node_put(panel);
+	return selected;
+}
+
+static bool dsi_uke_o82_refresh_modes(struct msm_dsi_host *msm_host,
+				    const struct drm_display_mode *mode)
+{
+	if (!dsi_uke_misr_scope(msm_host) || !qcom_uke_o82_mode(mode) ||
+	    msm_host->cphy_mode || msm_host->lanes != 4 ||
+	    msm_host->format != MIPI_DSI_FMT_RGB101010 ||
+	    !(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO) || !msm_host->dsc ||
+	    msm_host->dsc->bits_per_component != 10 ||
+	    msm_host->dsc->bits_per_pixel != 8 << 4 ||
+	    msm_host->dsc->slice_width != 800 || msm_host->dsc->slice_height != 24)
+		return false;
+	return dsi_uke_o82_refresh_selected(msm_host);
+}
+
 static bool dsi_uke_o82_initial120(struct msm_dsi_host *msm_host)
 {
 	struct device_node *panel;
@@ -272,6 +301,21 @@
 	return selected;
 }
 
+static bool dsi_uke_o82_powered_profile(struct msm_dsi_host *msm_host)
+{
+	return dsi_uke_o82_initial120(msm_host) ||
+		(msm_host->power_on && !READ_ONCE(msm_host->cmd_dma_blocked) &&
+		 dsi_uke_o82_refresh_modes(msm_host, msm_host->mode));
+}
+
+static u32 dsi_uke_o82_total(struct msm_dsi_host *msm_host)
+{
+	const struct drm_display_mode *mode = msm_host->mode;
+	u32 horizontal = mode->htotal / 2 - 1600 + DIV_ROUND_UP(1600 * 8, 30);
+
+	return DSI_TOTAL_H_TOTAL(horizontal - 1) | DSI_TOTAL_V_TOTAL(mode->vtotal - 1);
+}
+
 /* Trial-only, passive snapshots: do not clear sticky FIFO evidence or unmask IRQs. */
 static void dsi_uke_fifo_trace(struct msm_dsi_host *msm_host,
 			     const struct mipi_dsi_msg *msg,
@@ -917,6 +961,12 @@
 	unsigned long pclk_rate = dsi_get_pclk_rate(mode, msm_host->dsc, is_bonded_dsi);
 	unsigned long pclk_bpp;
 
+	/* OEM fixes the same lane clock for all three O82 timing groups. Keep
+	 * native50's accepted clock quantization rather than retuning per mode.
+	 */
+	if (is_bonded_dsi && dsi_uke_o82_refresh_modes(msm_host, mode))
+		return 148648500;
+
 	/* Compression adjusted the pixel clock using DSC input component depth. */
 	if (msm_host->dsc)
 		bpp = msm_host->dsc->bits_per_component * 3;
@@ -940,6 +990,8 @@
 	msm_host->pixel_clk_rate = dsi_get_pclk_rate(msm_host->mode, msm_host->dsc, is_bonded_dsi);
 	msm_host->byte_clk_rate = dsi_byte_clk_get_rate(&msm_host->base, is_bonded_dsi,
 							msm_host->mode);
+	if (is_bonded_dsi && dsi_uke_o82_refresh_modes(msm_host, msm_host->mode))
+		msm_host->pixel_clk_rate = 158558400;
 
 	DBG("pclk=%lu, bclk=%lu", msm_host->pixel_clk_rate,
 				msm_host->byte_clk_rate);
@@ -1267,6 +1319,13 @@
 	const struct drm_display_mode *mode = msm_host->mode;
 	struct device_node *panel;
 
+	if (is_bonded_dsi && dsi_uke_o82_refresh_modes(msm_host, mode)) {
+		dsi_write(msm_host, REG_DSI_HS_TIMER_CTRL,
+			DSI_HS_TIMER_CTRL_HS_TX_TO(0xbb80) |
+			DSI_HS_TIMER_CTRL_TIMER_RESOLUTION(4));
+		return;
+	}
+
 	if (!is_bonded_dsi || !mode || !msm_host->cfg_hnd ||
 	    !of_machine_is_compatible("xiaomi,uke") ||
 	    !of_machine_is_compatible("qcom,sm7675") ||
@@ -1817,20 +1876,31 @@
 {
 	struct msm_dsi_host *hosts[] = { master, slave };
 	u32 total[2], active_v[2], line;
+	u32 expected[2] = { 0x0905023b, 0x0905023b };
+	bool multi[2];
 	int i;
 
 	if (!master->enabled && !slave->enabled)
 		return 0;
 	if (master->enabled != slave->enabled)
 		return -EBUSY;
-	for (i = 0; i < ARRAY_SIZE(hosts); i++)
+	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
 		total[i] = dsi_read(hosts[i], REG_DSI_TOTAL);
+		multi[i] = dsi_uke_o82_refresh_modes(hosts[i], hosts[i]->mode);
+	}
+	if (multi[0] || multi[1]) {
+		if (!multi[0] || !multi[1] ||
+		    !drm_mode_equal(master->mode, slave->mode))
+			return -EINVAL;
+		for (i = 0; i < ARRAY_SIZE(hosts); i++)
+			expected[i] = dsi_uke_o82_total(hosts[i]);
+	}
 	/* Other O82 timing groups retain their existing command policy. */
-	if (total[0] != 0x0905023b && total[1] != 0x0905023b)
+	if (!multi[0] && total[0] != expected[0] && total[1] != expected[1])
 		return 0;
 	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
 		active_v[i] = dsi_read(hosts[i], REG_DSI_ACTIVE_V);
-		if (total[i] != 0x0905023b || active_v[i] != 0x08ec0094 ||
+		if (total[i] != expected[i] || active_v[i] != 0x08ec0094 ||
 		    (dsi_read(hosts[i], REG_DSI_CTRL) &
 		     (DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN)) !=
 		    (DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN))
@@ -2698,12 +2768,12 @@
 	 */
 	pm_runtime_get_sync(&msm_host->pdev->dev);
 	/* OEM transfers retain rates after host power-on and paired retime. */
-	if (!dsi_uke_o82_initial120(msm_host))
+	if (!dsi_uke_o82_powered_profile(msm_host))
 		cfg_hnd->ops->link_clk_set_rate(msm_host);
 	cfg_hnd->ops->link_clk_enable(msm_host);
 
 	/* Exact OEM video transfers leave the legacy within-frame DMA block clear. */
-	if (msm_host->enabled && dsi_uke_o82_initial120(msm_host)) {
+	if (msm_host->enabled && dsi_uke_o82_powered_profile(msm_host)) {
 		u32 trigger = dsi_read(msm_host, REG_DSI_TRIG_CTRL);
 
 		if (trigger & DSI_TRIG_CTRL_BLOCK_DMA_WITHIN_FRAME)
@@ -2742,7 +2812,7 @@
 	if (!(msg->flags & MIPI_DSI_MSG_USE_LPM))
 		dsi_set_tx_power_mode(1, msm_host);
 	/* OEM clears sticky write overflow after disabling the command engine. */
-	if (msm_host->enabled && dsi_uke_o82_initial120(msm_host) &&
+	if (msm_host->enabled && dsi_uke_o82_powered_profile(msm_host) &&
 	    !msg->rx_buf && !msg->rx_len &&
 	    !(msm_host->dma_cmd_ctrl_restore & DSI_CTRL_CMD_MODE_EN)) {
 		u32 overflow = dsi_read(msm_host, REG_DSI_FIFO_STATUS) &
@@ -2770,8 +2840,15 @@
 {
 	struct msm_dsi_host *master = to_msm_dsi_host(master_host);
 	struct msm_dsi_host *slave = to_msm_dsi_host(slave_host);
+	bool multi = dsi_uke_o82_refresh_modes(master, master->mode) &&
+		dsi_uke_o82_refresh_modes(slave, slave->mode);
 	int i, len = 0, ret;
 
+	/* An invalid or mismatched new profile must never fall back to PB120. */
+	if ((dsi_uke_o82_refresh_selected(master) || dsi_uke_o82_refresh_selected(slave)) &&
+	    (!multi || !drm_mode_equal(master->mode, slave->mode)))
+		return -EOPNOTSUPP;
+
 	/* The manager admits only Uke O82 bonded video writes. */
 	if (master->id != DSI_0 || slave->id != DSI_1 ||
 	    (msg->rx_buf && msg->rx_len) ||
@@ -2799,8 +2876,9 @@
 	    slave->format != MIPI_DSI_FMT_RGB101010 ||
 	    !(master->mode_flags & MIPI_DSI_MODE_VIDEO) ||
 	    !(slave->mode_flags & MIPI_DSI_MODE_VIDEO) ||
-	    dsi_read(master, REG_DSI_TOTAL) != 0x0905023b ||
-	    dsi_read(slave, REG_DSI_TOTAL) != 0x0905023b)) {
+	    (multi && !drm_mode_equal(master->mode, slave->mode)) ||
+	    dsi_read(master, REG_DSI_TOTAL) != (multi ? dsi_uke_o82_total(master) : 0x0905023b) ||
+	    dsi_read(slave, REG_DSI_TOTAL) != (multi ? dsi_uke_o82_total(slave) : 0x0905023b))) {
 		ret = -EOPNOTSUPP;
 		goto unlock;
 	}
@@ -2874,16 +2952,29 @@
 		{ 0xff, 0x10 }, { 0xfb, 0x01 }, { 0xb2, 0x91 }, { 0xb3, 0x40 },
 	};
 	struct msm_dsi_host *slave;
+	u8 selected[4][2];
+	int group;
 	int i, ret;
 
 	if (!master_host || !slave_host || !msgs)
 		return -EINVAL;
 	slave = to_msm_dsi_host(slave_host);
+	memcpy(selected, payloads, sizeof(selected));
+	if (dsi_uke_o82_refresh_modes(slave, slave->mode)) {
+		group = qcom_uke_o82_mode_group(slave->mode);
+		if (group == 1) {
+			selected[2][1] = 0x00;
+			selected[3][1] = 0x00;
+		} else if (group == 2) {
+			selected[2][1] = 0x00;
+			selected[3][1] = 0x80;
+		}
+	}
 	for (i = 0; i < ARRAY_SIZE(payloads); i++)
 		if (msgs[i].type != MIPI_DSI_DCS_LONG_WRITE || msgs[i].channel ||
 		    msgs[i].flags || msgs[i].rx_buf || msgs[i].rx_len ||
 		    msgs[i].tx_len != sizeof(payloads[i]) || !msgs[i].tx_buf ||
-		    memcmp(msgs[i].tx_buf, payloads[i], sizeof(payloads[i])))
+		    memcmp(msgs[i].tx_buf, selected[i], sizeof(selected[i])))
 			return -EINVAL;
 	mutex_lock(&slave->cmd_mutex);
 	ret = dsi_host_cmd_broadcast(master_host, slave_host, msgs, ARRAY_SIZE(payloads), false);
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -5,6 +5,7 @@
 
 #include "drm/drm_bridge_connector.h"
 #include <drm/drm_panel.h>
+#include <drm/uke-o82-mode.h>
 #include <linux/of_graph.h>
 #include <linux/qcom-uke-display.h>
 
@@ -506,6 +507,17 @@
 	struct platform_device *pdev = msm_dsi->pdev;
 	struct dev_pm_opp *opp;
 	unsigned long byte_clk_rate;
+	struct device_node *panel;
+	bool oem_modes;
+
+	panel = of_graph_get_remote_node(pdev->dev.of_node, 1, -1);
+	oem_modes = of_machine_is_compatible("xiaomi,uke") &&
+		of_machine_is_compatible("qcom,sm7675") &&
+		of_device_is_compatible(panel, "xiaomi,o82-42-02-0b") &&
+		of_property_read_bool(panel, "xiaomi,oem-refresh-modes");
+	of_node_put(panel);
+	if (oem_modes && !qcom_uke_o82_mode(mode))
+		return MODE_BAD;
 
 	byte_clk_rate = dsi_byte_clk_get_rate(host, IS_BONDED_DSI(), mode);
 
@@ -631,7 +643,8 @@
 	    dsi->host != master->host || !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
 	    IS_ERR_OR_NULL(dsi_mgr_o82_panel(master)) ||
 	    !of_device_is_compatible(dsi->dev.of_node, "xiaomi,o82-42-02-0b") ||
-	    !of_property_read_bool(dsi->dev.of_node, "xiaomi,initial-120hz-only"))
+	    (!of_property_read_bool(dsi->dev.of_node, "xiaomi,initial-120hz-only") &&
+	     !of_property_read_bool(dsi->dev.of_node, "xiaomi,oem-refresh-modes")))
 		return -EOPNOTSUPP;
 	return msm_dsi_host_cmd_on_batch(master->host, slave->host, msgs, count);
 }
@@ -648,7 +661,8 @@
 	    dsi->host != master->host || !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
 	    IS_ERR_OR_NULL(dsi_mgr_o82_panel(master)) ||
 	    !of_device_is_compatible(dsi->dev.of_node, "xiaomi,o82-42-02-0b") ||
-	    !of_property_read_bool(dsi->dev.of_node, "xiaomi,initial-120hz-only"))
+	    (!of_property_read_bool(dsi->dev.of_node, "xiaomi,initial-120hz-only") &&
+	     !of_property_read_bool(dsi->dev.of_node, "xiaomi,oem-refresh-modes")))
 		return -EOPNOTSUPP;
 	return msm_dsi_host_cmd_lp_batch(master->host, slave->host, msgs, count);
 }
