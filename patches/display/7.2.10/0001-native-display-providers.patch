-	clk_lucid_ole_pll_configure(&disp_cc_pll1, regmap, &disp_cc_pll1_config);
+	/* Firmware still scans out until the MDSS handoff drains display DMA. */
+	if (!of_device_is_compatible(pdev->dev.of_node, "qcom,sm7675-dispcc")) {
+		clk_lucid_ole_pll_configure(&disp_cc_pll0, regmap, &disp_cc_pll0_config);
+		clk_lucid_ole_pll_configure(&disp_cc_pll1, regmap, &disp_cc_pll1_config);
+	}
 
 	/* Enable clock gating for MDP clocks */
 	regmap_update_bits(regmap, DISP_CC_MISC_CMD, 0x10, 0x10);
@@ -1821,6 +1847,7 @@
 	.probe = disp_cc_sm8550_probe,
 	.driver = {
 		.name = "disp_cc-sm8550",
+		.sync_state = uke_dispcc_sync_state,
 		.of_match_table = disp_cc_sm8550_match_table,
 	},
 };
