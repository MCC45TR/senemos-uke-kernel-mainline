+bool dpu_encoder_uke_vrr_check(struct drm_encoder *drm_enc,
+		const struct drm_crtc_state *state)
+{
+	struct dpu_encoder_virt *enc = to_dpu_encoder_virt(drm_enc);
+	struct msm_drm_private *priv = drm_enc->dev->dev_private;
+	struct dpu_kms *kms = to_dpu_kms(priv->kms);
+
+	return kms->catalog == &dpu_sm7675_cfg &&
+		enc->disp_info.intf_type == INTF_DSI && !enc->disp_info.is_cmd_mode &&
+		enc->disp_info.num_of_h_tiles == 2 &&
+		enc->disp_info.h_tile_instance[0] == 0 &&
+		enc->disp_info.h_tile_instance[1] == 1 &&
+		qcom_uke_o82_avr_lines(&state->adjusted_mode, o82_vrr_test_min_hz) > 0 &&
+		msm_dsi_manager_uke_avr_check(drm_enc, &state->adjusted_mode);
+}
+
+static void dpu_encoder_uke_avr_disable(struct dpu_encoder_virt *enc)
+{
+	unsigned long flags;
+	unsigned int i;
+
+	enc->avr_failed = false;
+	if (!enc->avr_enabled)
+		return;
+	spin_lock_irqsave(&enc->enc_spinlock, flags);
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = enc->phys_encs[i];
+
+		phys->hw_intf->ops.enable_avr(phys->hw_intf, false);
+		phys->hw_ctl->ops.update_pending_flush_intf(phys->hw_ctl, phys->hw_intf->idx);
+	}
+	spin_unlock_irqrestore(&enc->enc_spinlock, flags);
+	if (msm_dsi_manager_uke_avr_set(false))
+		DRM_ERROR("O82 AVR host disable failed; modeset required\n");
+	enc->avr_enabled = false;
+}
+
+static void dpu_encoder_uke_avr_update(struct dpu_encoder_virt *enc)
+{
+	struct drm_crtc_state *state = enc->crtc ? enc->crtc->state : NULL;
+	unsigned long flags;
+	unsigned int i;
+	int lines, ret;
+	u32 periods[2];
+
+	if (!state || !state->active || !state->vrr_enabled) {
+		dpu_encoder_uke_avr_disable(enc);
+		return;
+	}
+	if (enc->avr_enabled || enc->avr_failed)
+		return;
+	if (!dpu_encoder_uke_vrr_check(&enc->base, state) || !enc->cur_master ||
+	    !dpu_encoder_uke_split_flush(enc->cur_master))
+		return;
+	lines = qcom_uke_o82_avr_lines(&state->adjusted_mode, o82_vrr_test_min_hz);
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = enc->phys_encs[i];
+
+		if (!phys->hw_intf->ops.setup_avr || !phys->hw_intf->ops.enable_avr ||
+		    !phys->hw_intf->ops.avr_trigger || phys->enable_state == DPU_ENC_DISABLED)
+			return;
+	}
+	/* No AVR is enabled until both local periods and both hosts are ready. */
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = enc->phys_encs[i];
+
+		ret = phys->hw_intf->ops.setup_avr(phys->hw_intf, lines, &periods[i]);
+		if (ret)
+			goto fail;
+	}
+	if (periods[0] != periods[1]) {
+		ret = -EINVAL;
+		goto fail;
+	}
+	ret = msm_dsi_manager_uke_avr_set(true);
+	if (ret)
+		goto fail;
+	spin_lock_irqsave(&enc->enc_spinlock, flags);
+	for (i = 0; i < enc->num_phys_encs; i++) {
+		struct dpu_encoder_phys *phys = enc->phys_encs[i];
+
+		phys->hw_intf->ops.enable_avr(phys->hw_intf, true);
+		phys->hw_ctl->ops.update_pending_flush_intf(phys->hw_ctl, phys->hw_intf->idx);
+	}
+	enc->avr_enabled = true;
+	spin_unlock_irqrestore(&enc->enc_spinlock, flags);
+	DRM_INFO("O82 unqualified AVR experiment: %d maximum lines per frame\n", lines);
+	return;
+fail:
+	/* Retry only after VRR off or a full modeset, not on every page flip. */
+	enc->avr_failed = true;
+	DRM_ERROR("O82 AVR experiment failed: %d; retaining fixed timing\n", ret);
+}
