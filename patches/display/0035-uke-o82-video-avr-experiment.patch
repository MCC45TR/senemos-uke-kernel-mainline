@@ -281,6 +281,33 @@ static void dpu_hw_intf_enable_timing_engine(
 	DPU_REG_WRITE(c, INTF_TIMING_ENGINE_EN, enable != 0);
 }
 
+/* AVR uses the programmed local INTF period, after split and DSC conversion. */
+static int dpu_hw_intf_setup_avr(struct dpu_hw_intf *intf, u32 max_lines, u32 *result)
+{
+	u32 htotal = DPU_REG_READ(&intf->hw, INTF_HSYNC_CTL) >> 16;
+	u64 period = (u64)max_lines * htotal;
+
+	if (!htotal || !max_lines || period > U32_MAX)
+		return -EINVAL;
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_VTOTAL, (u32)period);
+	if (DPU_REG_READ(&intf->hw, INTF_AVR_VTOTAL) != period)
+		return -EIO;
+	*result = period;
+	return 0;
+}
+
+static void dpu_hw_intf_enable_avr(struct dpu_hw_intf *intf, bool enable)
+{
+	/* Continuous mode follows the OEM video AVR register contract. */
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_MODE, 0);
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_CONTROL, enable ? BIT(0) : 0);
+}
+
+static void dpu_hw_intf_avr_trigger(struct dpu_hw_intf *intf)
+{
+	DPU_REG_WRITE(&intf->hw, INTF_AVR_TRIGGER, 1);
+}
+
 static void dpu_hw_intf_setup_prg_fetch(
 		struct dpu_hw_intf *intf,
 		const struct dpu_hw_intf_prog_fetch *fetch)
@@ -644,6 +671,13 @@ struct dpu_hw_intf *dpu_hw_intf_init(struct drm_device *dev,
 	c->ops.setup_misr = dpu_hw_intf_setup_misr;
 	c->ops.collect_misr = dpu_hw_intf_collect_misr;
 
+	if (mdss_rev->core_major_ver == 10 && mdss_rev->core_minor_ver == 1 &&
+	    cfg->type == INTF_DSI) {
+		c->ops.setup_avr = dpu_hw_intf_setup_avr;
+		c->ops.enable_avr = dpu_hw_intf_enable_avr;
+		c->ops.avr_trigger = dpu_hw_intf_avr_trigger;
+	}
+
 	if (mdss_rev->core_major_ver >= 5)
 		c->ops.bind_pingpong_blk = dpu_hw_intf_bind_pingpong_blk;
 
