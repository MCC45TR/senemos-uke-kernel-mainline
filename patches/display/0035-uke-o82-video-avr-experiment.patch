diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index bcebb60..d7f1484 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -3550,6 +3550,70 @@ int msm_dsi_host_set_display_mode(struct mipi_dsi_host *host,
 #define DSI_UKE_TIMING_DB_TRIGGER (0x01e4 - DSI_6G_REG_SHIFT)
 #define DSI_UKE_TIMING_DB_MODE    (0x01e8 - DSI_6G_REG_SHIFT)
 
+bool msm_dsi_host_uke_avr_check(struct mipi_dsi_host *host,
+		const struct drm_display_mode *mode)
+{
+	return dsi_uke_o82_refresh_modes(to_msm_dsi_host(host), mode) &&
+		qcom_uke_o82_mode_group(mode) == 0 && mode->vtotal == 2310;
+}
+
+int msm_dsi_host_uke_avr_pair(struct mipi_dsi_host *host0,
+		struct mipi_dsi_host *host1, bool enable)
+{
+	struct msm_dsi_host *hosts[] = { to_msm_dsi_host(host0), to_msm_dsi_host(host1) };
+	u32 before[2];
+	unsigned int i;
+	int ret = 0;
+
+	if (hosts[0]->id != DSI_0 || hosts[1]->id != DSI_1)
+		return -EINVAL;
+	/* Same order as the existing bonded timing path; never hold an INTF spinlock. */
+	mutex_lock(&hosts[0]->dev_mutex);
+	mutex_lock_nested(&hosts[1]->dev_mutex, SINGLE_DEPTH_NESTING);
+	mutex_lock(&hosts[1]->cmd_mutex);
+	mutex_lock_nested(&hosts[0]->cmd_mutex, SINGLE_DEPTH_NESTING);
+	if (enable) {
+		for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+			struct msm_dsi_host *h = hosts[i];
+
+			if (!h->power_on || !h->enabled || READ_ONCE(h->cmd_dma_blocked) ||
+			    h->uke_dfps_mode || !msm_dsi_host_uke_avr_check(&h->base, h->mode)) {
+				ret = -EPIPE;
+				goto unlock;
+			}
+		}
+		if (!hosts[0]->vm || hosts[0]->vm != hosts[1]->vm ||
+		    !drm_mode_equal(hosts[0]->mode, hosts[1]->mode)) {
+			ret = -EINVAL;
+			goto unlock;
+		}
+	}
+	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+		if (!hosts[i]->power_on)
+			continue;
+		before[i] = dsi_read(hosts[i], REG_DSI_VID_CFG0);
+		dsi_write(hosts[i], REG_DSI_VID_CFG0,
+			  (before[i] & ~BIT(29)) | (enable ? BIT(29) : 0));
+	}
+	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+		if (hosts[i]->power_on &&
+		    !!(dsi_read(hosts[i], REG_DSI_VID_CFG0) & BIT(29)) != enable)
+			ret = -EIO;
+	}
+	if (ret) {
+		/* A partial enable must leave both links at fixed timing. */
+		for (i = 0; i < ARRAY_SIZE(hosts); i++)
+			if (hosts[i]->power_on)
+				dsi_write(hosts[i], REG_DSI_VID_CFG0, before[i] & ~BIT(29));
+	}
+unlock:
+	mutex_unlock(&hosts[0]->cmd_mutex);
+	mutex_unlock(&hosts[1]->cmd_mutex);
+	mutex_unlock(&hosts[1]->dev_mutex);
+	mutex_unlock(&hosts[0]->dev_mutex);
+	return ret;
+}
