index 8a2aa5d..d7d0b0c 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -691,6 +691,41 @@ bool msm_dsi_manager_uke_dfps_prepare(struct drm_encoder *encoder,
 	return prepared;
 }
 
+bool msm_dsi_manager_uke_avr_check(struct drm_encoder *encoder,
+		const struct drm_display_mode *mode)
+{
+	struct drm_bridge *bridge = drm_bridge_chain_get_first_bridge(encoder);
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+	struct dsi_bridge *b;
+	bool supported = false;
+
+	if (!bridge || bridge->funcs != &dsi_mgr_bridge_funcs ||
+	    !IS_BONDED_DSI() || !IS_SYNC_NEEDED() || !master || !slave ||
+	    msm_dsi_manager_uke_dfps_failed() ||
+	    !msm_dsi_host_uke_avr_check(master->host, mode) ||
+	    !msm_dsi_host_uke_avr_check(slave->host, mode))
+		goto out;
+	b = to_dsi_bridge(bridge);
+	mutex_lock(&uke_dfps_panel_lock);
+	supported = b->o82_panel && IS_MASTER_DSI_LINK(b->id) &&
+		msm_dsim_glb.uke_dfps_panel == b->o82_panel && msm_dsim_glb.uke_dfps_ops;
+	mutex_unlock(&uke_dfps_panel_lock);
+out:
+	drm_bridge_put(bridge);
+	return supported;
+}
+
+int msm_dsi_manager_uke_avr_set(bool enable)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+
+	if (!IS_BONDED_DSI() || !IS_SYNC_NEEDED() || !master || !slave)
+		return -EPIPE;
+	return msm_dsi_host_uke_avr_pair(master->host, slave->host, enable);
+}
