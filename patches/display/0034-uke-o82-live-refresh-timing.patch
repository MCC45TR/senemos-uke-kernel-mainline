+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys.h
@@ -98,6 +98,7 @@ struct dpu_encoder_phys_ops {
 	void (*atomic_mode_set)(struct dpu_encoder_phys *encoder,
 			struct drm_crtc_state *crtc_state,
 			struct drm_connector_state *conn_state);
+	void (*seamless_mode_set)(struct dpu_encoder_phys *encoder);
 	void (*enable)(struct dpu_encoder_phys *encoder);
 	void (*disable)(struct dpu_encoder_phys *encoder);
 	int (*control_vblank_irq)(struct dpu_encoder_phys *enc, bool enable);
diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
index 553055c..1242797 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder_phys_vid.c
@@ -383,6 +383,15 @@ static bool dpu_encoder_phys_vid_needs_single_flush(
 		phys_enc->split_role != ENC_ROLE_SOLO;
 }
 
+static void dpu_encoder_phys_vid_seamless_mode_set(struct dpu_encoder_phys *phys)
+{
+	dpu_encoder_phys_vid_setup_timing_engine(phys);
+	if (dpu_encoder_phys_vid_needs_single_flush(phys) &&
+	    !dpu_encoder_phys_vid_is_master(phys))
+		return;
+	phys->hw_ctl->ops.update_pending_flush_intf(phys->hw_ctl, phys->hw_intf->idx);
+}
+
 static void dpu_encoder_phys_vid_atomic_mode_set(
 		struct dpu_encoder_phys *phys_enc,
 		struct drm_crtc_state *crtc_state,
@@ -747,6 +756,7 @@ static void dpu_encoder_phys_vid_init_ops(struct dpu_encoder_phys_ops *ops)
 {
 	ops->is_master = dpu_encoder_phys_vid_is_master;
 	ops->atomic_mode_set = dpu_encoder_phys_vid_atomic_mode_set;
+	ops->seamless_mode_set = dpu_encoder_phys_vid_seamless_mode_set;
 	ops->enable = dpu_encoder_phys_vid_enable;
 	ops->disable = dpu_encoder_phys_vid_disable;
 	ops->control_vblank_irq = dpu_encoder_phys_vid_control_vblank_irq;
diff --git a/drivers/gpu/drm/msm/dsi/dsi.h b/drivers/gpu/drm/msm/dsi/dsi.h
index 80f563f..b37d6a2 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.h
+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -56,6 +56,19 @@ bool msm_dsi_manager_cmd_xfer_trigger(int id, u32 dma_base, u32 len,
 int msm_dsi_manager_register(struct msm_dsi *msm_dsi);
 void msm_dsi_manager_unregister(struct msm_dsi *msm_dsi);
 void msm_dsi_manager_tpg_enable(void);
+bool msm_dsi_manager_uke_dfps_failed(void);
+void msm_dsi_manager_uke_dfps_fail(void);
+bool msm_dsi_manager_uke_dfps_pending(struct drm_encoder *encoder);
+bool msm_dsi_manager_uke_dfps_prepare(struct drm_encoder *encoder,
+		const struct drm_display_mode *old, const struct drm_display_mode *new);
+int msm_dsi_manager_uke_dfps_stage(void);
+int msm_dsi_manager_uke_dfps_complete(void);
+int msm_dsi_host_uke_dfps_queue(struct mipi_dsi_host *host,
+		const struct drm_display_mode *old, const struct drm_display_mode *new);
+bool msm_dsi_host_uke_dfps_pending(struct mipi_dsi_host *host);
+void msm_dsi_host_uke_dfps_cancel(struct mipi_dsi_host *host);
+int msm_dsi_host_uke_dfps_pair(struct mipi_dsi_host *host0,
+		struct mipi_dsi_host *host1, bool complete);
 
 /* dsi host */
 struct msm_dsi_host;
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 2561f88..50e715f 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -204,6 +204,8 @@ struct msm_dsi_host {
 	struct regmap *sfpb;
 
 	struct drm_display_mode *mode;
+	struct drm_display_mode *uke_dfps_mode;
+	bool uke_dfps_staged;
 	struct drm_dsc_config *dsc;
 
 	/* connected device info */
@@ -3493,6 +3495,119 @@ int msm_dsi_host_set_display_mode(struct mipi_dsi_host *host,
 	return ret;
 }
 
+/* MiCode 44275c404a67 and Nabu 0b3226fc8f3c: 6G timing shadow DB. */
+#define DSI_UKE_TIMING_DB_TRIGGER 0x01e4
+#define DSI_UKE_TIMING_DB_MODE    0x01e8
+
+int msm_dsi_host_uke_dfps_queue(struct mipi_dsi_host *host,
+		const struct drm_display_mode *old, const struct drm_display_mode *new_mode)
+{
+	struct msm_dsi_host *h = to_msm_dsi_host(host);
+	struct drm_display_mode *pending = drm_mode_duplicate(h->dev, new_mode);
+	int ret = 0;
+
+	if (!pending)
+		return -ENOMEM;
+	mutex_lock(&h->dev_mutex);
+	if (!h->power_on || !h->enabled || READ_ONCE(h->cmd_dma_blocked) ||
+	    h->uke_dfps_mode || !h->mode || !drm_mode_equal(h->mode, old) ||
+	    !dsi_uke_o82_refresh_modes(h, old) || !dsi_uke_o82_refresh_modes(h, new_mode) ||
+	    !qcom_uke_o82_vfp_change(old, new_mode)) {
+		ret = -EOPNOTSUPP;
+	} else {
+		h->uke_dfps_mode = pending;
+		pending = NULL;
+	}
+	mutex_unlock(&h->dev_mutex);
+	if (pending)
+		drm_mode_destroy(h->dev, pending);
+	return ret;
+}
+
+bool msm_dsi_host_uke_dfps_pending(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *h = to_msm_dsi_host(host);
+	bool pending;
+
+	mutex_lock(&h->dev_mutex);
+	pending = h->uke_dfps_mode && !h->uke_dfps_staged &&
+		h->power_on && h->enabled && !READ_ONCE(h->cmd_dma_blocked);
+	mutex_unlock(&h->dev_mutex);
+	return pending;
+}
+
+void msm_dsi_host_uke_dfps_cancel(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *h = to_msm_dsi_host(host);
+
+	mutex_lock(&h->dev_mutex);
+	if (h->uke_dfps_mode && !h->uke_dfps_staged) {
+		drm_mode_destroy(h->dev, h->uke_dfps_mode);
+		h->uke_dfps_mode = NULL;
+	}
+	mutex_unlock(&h->dev_mutex);
+}
+
+int msm_dsi_host_uke_dfps_pair(struct mipi_dsi_host *host0,
+		struct mipi_dsi_host *host1, bool complete)
+{
+	struct msm_dsi_host *hosts[] = { to_msm_dsi_host(host0), to_msm_dsi_host(host1) };
+	unsigned int i;
+	int ret = -EPIPE;
+
+	/* Clock-master DSI0 first, independent of the DRM bridge-master link. */
+	if (hosts[0]->id != DSI_0 || hosts[1]->id != DSI_1)
+		return -EINVAL;
+	mutex_lock(&hosts[0]->dev_mutex);
+	mutex_lock_nested(&hosts[1]->dev_mutex, SINGLE_DEPTH_NESTING);
+	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+		struct msm_dsi_host *h = hosts[i];
+
+		if (!h->power_on || !h->enabled || READ_ONCE(h->cmd_dma_blocked) ||
+		    !h->uke_dfps_mode || h->uke_dfps_staged != complete ||
+		    !dsi_uke_o82_refresh_modes(h, h->mode) ||
+		    !dsi_uke_o82_refresh_modes(h, h->uke_dfps_mode) ||
+		    !qcom_uke_o82_vfp_change(h->mode, h->uke_dfps_mode))
+			goto unlock;
+	}
+	if (!drm_mode_equal(hosts[0]->mode, hosts[1]->mode) ||
+	    !drm_mode_equal(hosts[0]->uke_dfps_mode, hosts[1]->uke_dfps_mode))
+		goto unlock;
+	/* Both links are validated and held before the first MMIO write. */
+	for (i = 0; i < ARRAY_SIZE(hosts); i++)
+		dsi_write(hosts[i], DSI_UKE_TIMING_DB_MODE, !complete);
+	wmb();
+	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+		struct msm_dsi_host *h = hosts[i];
+
+		if (complete) {
+			/* Atomic commit observed a vblank after the DPU timing flush. */
+			drm_mode_destroy(h->dev, h->mode);
+			h->mode = h->uke_dfps_mode;
+			h->uke_dfps_mode = NULL;
+		} else {
+			struct drm_display_mode *active = h->mode;
+
+			/* VFP alone changes: retain active area, sync, DSC and PHY. */
+			h->mode = h->uke_dfps_mode;
+			dsi_write(h, REG_DSI_TOTAL, dsi_uke_o82_total(h));
+			h->mode = active;
+		}
+		h->uke_dfps_staged = !complete;
+	}
+	wmb();
+	if (!complete) {
+		for (i = 0; i < ARRAY_SIZE(hosts); i++)
+			dsi_write(hosts[i], DSI_UKE_TIMING_DB_TRIGGER, 1);
+		wmb();
+	}
+	ret = 0;
+unlock:
+	mutex_unlock(&hosts[1]->dev_mutex);
+	mutex_unlock(&hosts[0]->dev_mutex);
+	return ret;
+}
+
 enum drm_mode_status msm_dsi_host_check_dsc(struct mipi_dsi_host *host,
 					    const struct drm_display_mode *mode)
 {
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index 4e6b453..79e0411 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -30,6 +30,7 @@ struct msm_dsi_manager {
 	bool is_bonded_dsi;
 	bool is_sync_needed;
 	int master_dsi_link_id;
+	bool uke_dfps_failed;
 };
 
 static struct msm_dsi_manager msm_dsim_glb;
@@ -492,6 +493,10 @@ static void dsi_mgr_bridge_mode_set(struct drm_bridge *bridge,
 	if (is_bonded_dsi && !IS_MASTER_DSI_LINK(id))
 		return;
 
+	/* Queued live timing is owned by the commit tail, not a power modeset. */
+	if (msm_dsi_manager_uke_dfps_pending(bridge->encoder))
+		return;
+
 	msm_dsi_host_set_display_mode(host, adjusted_mode);
 	if (is_bonded_dsi && other_dsi)
 		msm_dsi_host_set_display_mode(other_dsi->host, adjusted_mode);
@@ -560,6 +565,85 @@ static const struct drm_bridge_funcs dsi_mgr_bridge_funcs = {
 	.mode_valid = dsi_mgr_bridge_mode_valid,
 };
 
+bool msm_dsi_manager_uke_dfps_failed(void)
+{
+	return READ_ONCE(msm_dsim_glb.uke_dfps_failed);
+}
+
+void msm_dsi_manager_uke_dfps_fail(void)
+{
+	/* No teardown or reprobe after an unproved live timing latch. */
+	WRITE_ONCE(msm_dsim_glb.uke_dfps_failed, true);
+}
+
+bool msm_dsi_manager_uke_dfps_pending(struct drm_encoder *encoder)
+{
+	struct drm_bridge *bridge = drm_bridge_chain_get_first_bridge(encoder);
+	struct msm_dsi *master, *slave;
+	struct dsi_bridge *b;
+
+	if (!bridge || bridge->funcs != &dsi_mgr_bridge_funcs ||
+	    !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
+	    msm_dsi_manager_uke_dfps_failed())
+		return false;
+	b = to_dsi_bridge(bridge);
+	if (!IS_MASTER_DSI_LINK(b->id))
+		return false;
+	master = dsi_mgr_get_dsi(b->id);
+	slave = dsi_mgr_get_other_dsi(b->id);
+	return master && slave && msm_dsi_host_uke_dfps_pending(master->host) &&
+		msm_dsi_host_uke_dfps_pending(slave->host);
+}
+
+bool msm_dsi_manager_uke_dfps_prepare(struct drm_encoder *encoder,
+		const struct drm_display_mode *old, const struct drm_display_mode *new)
+{
+	struct drm_bridge *bridge = drm_bridge_chain_get_first_bridge(encoder);
+	struct dsi_bridge *b;
+	struct msm_dsi *master, *slave;
+
+	if (!bridge || bridge->funcs != &dsi_mgr_bridge_funcs ||
+	    !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
+	    msm_dsi_manager_uke_dfps_failed() || !qcom_uke_o82_vfp_change(old, new))
+		return false;
+	b = to_dsi_bridge(bridge);
+	if (!b->o82_panel || !b->o82_panel->prepared || !b->powered ||
+	    !b->video_enabled || !IS_MASTER_DSI_LINK(b->id))
+		return false;
+	master = dsi_mgr_get_dsi(b->id);
+	slave = dsi_mgr_get_other_dsi(b->id);
+	if (!master || !slave)
+		return false;
+	if (msm_dsi_host_uke_dfps_queue(master->host, old, new))
+		return false;
+	if (msm_dsi_host_uke_dfps_queue(slave->host, old, new)) {
+		/* Nothing was written; the ordinary full modeset is still safe. */
+		msm_dsi_host_uke_dfps_cancel(master->host);
+		return false;
+	}
+	return true;
+}
+
+int msm_dsi_manager_uke_dfps_stage(void)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+
+	if (!master || !slave)
+		return -EPIPE;
+	return msm_dsi_host_uke_dfps_pair(master->host, slave->host, false);
+}
+
+int msm_dsi_manager_uke_dfps_complete(void)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+
+	if (!master || !slave)
+		return -EPIPE;
+	return msm_dsi_host_uke_dfps_pair(master->host, slave->host, true);
+}
+
 static struct drm_panel *dsi_mgr_o82_panel(struct msm_dsi *msm_dsi)
 {
 	struct device_node *node;
diff --git a/drivers/gpu/drm/msm/msm_atomic.c b/drivers/gpu/drm/msm/msm_atomic.c
index a8babf1..0a104c6 100644
--- a/drivers/gpu/drm/msm/msm_atomic.c
+++ b/drivers/gpu/drm/msm/msm_atomic.c
@@ -11,6 +11,9 @@
 #include "msm_drv.h"
 #include "msm_gem.h"
 #include "msm_kms.h"
+#if IS_ENABLED(CONFIG_DRM_MSM_DSI)
+#include "dsi/dsi.h"
+#endif
 
 /*
  * Helpers to control vblanks while we flush.. basically just to ensure
@@ -181,6 +184,105 @@ static unsigned get_crtc_mask(struct drm_atomic_commit *state)
 	return mask;
 }
 
+/* Exact fixed-link Uke VFP updates retain panel power, RESX and touch RAM. */
+static bool msm_uke_dfps_failed(void)
+{
+#if IS_ENABLED(CONFIG_DRM_MSM_DSI)
+	return msm_dsi_manager_uke_dfps_failed();
+#else
+	return false;
+#endif
+}
+
+static unsigned int msm_uke_dfps_prepare(struct drm_atomic_commit *state)
+{
+	unsigned int mask = 0;
+#if IS_ENABLED(CONFIG_DRM_MSM_DSI)
+	struct drm_crtc_state *old, *new;
+	struct drm_crtc *crtc;
+	struct drm_encoder *enc;
+	int i;
+
+	for_each_oldnew_crtc_in_state(state, crtc, old, new, i) {
+		if (!old->active || !new->active || !new->mode_changed ||
+		    new->active_changed || new->connectors_changed ||
+		    new->color_mgmt_changed || old->encoder_mask != new->encoder_mask ||
+		    hweight32(new->encoder_mask) != 1)
+			continue;
+		drm_for_each_encoder_mask(enc, state->dev, new->encoder_mask) {
+			if (msm_dsi_manager_uke_dfps_prepare(enc, &old->adjusted_mode,
+							  &new->adjusted_mode))
+				mask |= drm_crtc_mask(crtc);
+		}
+	}
+#endif
+	return mask;
+}
+
+static void msm_uke_dfps_mask(struct drm_atomic_commit *state, unsigned int mask,
+			      bool hide)
+{
+	struct drm_crtc_state *new;
+	struct drm_crtc *crtc;
+	int i;
+
+	for_each_new_crtc_in_state(state, crtc, new, i) {
+		if (mask & drm_crtc_mask(crtc))
+			new->mode_changed = !hide;
+	}
+}
+
+static int msm_uke_dfps_modeset(struct drm_atomic_commit *state, unsigned int mask)
+{
+#if IS_ENABLED(CONFIG_DRM_MSM_DSI)
+	struct drm_connector_state *conn_state;
+	struct drm_connector *connector;
+	struct drm_connector_list_iter iter;
+
+	drm_connector_list_iter_begin(state->dev, &iter);
+	drm_for_each_connector_iter(connector, &iter) {
+		const struct drm_encoder_helper_funcs *funcs;
+		struct drm_crtc_state *new;
+		struct drm_encoder *enc;
+
+		conn_state = drm_atomic_get_new_connector_state(state, connector);
+		if (!conn_state)
+			conn_state = connector->state;
+		if (!conn_state->crtc || !(mask & drm_crtc_mask(conn_state->crtc)))
+			continue;
+		new = drm_atomic_get_new_crtc_state(state, conn_state->crtc);
+		enc = conn_state->best_encoder;
+		funcs = enc->helper_private;
+		if (funcs && funcs->atomic_mode_set)
+			funcs->atomic_mode_set(enc, new, conn_state);
+	}
+	drm_connector_list_iter_end(&iter);
+	return msm_dsi_manager_uke_dfps_stage();
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+
+static void msm_uke_dfps_complete(struct drm_atomic_commit *state, unsigned int mask)
+{
+#if IS_ENABLED(CONFIG_DRM_MSM_DSI)
+	struct drm_crtc *crtc;
+
+	for_each_crtc_mask(state->dev, crtc, mask) {
+		u64 sequence = drm_crtc_vblank_count(crtc);
+
+		drm_crtc_wait_one_vblank(crtc);
+		if (drm_crtc_vblank_count(crtc) == sequence)
+			goto failed;
+	}
+	if (!msm_dsi_manager_uke_dfps_complete())
+		return;
+failed:
+	msm_dsi_manager_uke_dfps_fail();
+	drm_err(state->dev, "Uke DFPS latch unproved; reboot required\n");
+#endif
+}
+
 int msm_atomic_check(struct drm_device *dev, struct drm_atomic_commit *state)
 {
 	struct msm_drm_private *priv = dev->dev_private;
@@ -189,6 +291,9 @@ int msm_atomic_check(struct drm_device *dev, struct drm_atomic_commit *state)
 	struct drm_crtc *crtc;
 	int i, ret = 0;
 
+	if (msm_uke_dfps_failed())
+		return -EIO;
+
 	/*
 	 * FIXME: stop setting allow_modeset and move this check to the DPU
 	 * driver.
@@ -218,6 +323,7 @@ void msm_atomic_commit_tail(struct drm_atomic_commit *state)
 	struct drm_crtc *async_crtc = NULL;
 	unsigned crtc_mask = get_crtc_mask(state);
 	bool async = can_do_async(state, &async_crtc);
+	unsigned int dfps_mask;
 
 	trace_msm_atomic_commit_tail_start(async, crtc_mask);
 
@@ -228,6 +334,8 @@ void msm_atomic_commit_tail(struct drm_atomic_commit *state)
 	 * completed:
 	 */
 	lock_crtcs(kms, crtc_mask);
+	if (msm_uke_dfps_failed())
+		goto quarantined;
 	trace_msm_atomic_wait_flush_start(crtc_mask);
