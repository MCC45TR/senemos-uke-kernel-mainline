From: MCC45TR <mcc45tr@users.noreply.github.com>
Subject: [PATCH] drm/msm: stage exact Uke O82 live VFP timing

Use the DSI 6G timing database for exact same-group OEM modes.
MiCode display 44275c404a677d9d9e5230fedd1af2ef02fc7b9a and
Nabu 0b3226fc8f3cab5efb8a47bd17f5d7bd3ed609d1 provide the
shadow-trigger and DPU flush ordering. Uke commands and clocks stay scoped.
Host checks do not establish a physical seamless transition.

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
index 49b8774..c7aac33 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_encoder.c
@@ -20,6 +20,9 @@
 #include <drm/drm_framebuffer.h>
 
 #include "msm_drv.h"
+#if IS_ENABLED(CONFIG_DRM_MSM_DSI)
+#include "dsi/dsi.h"
+#endif
 #include "dpu_kms.h"
 #include "dpu_hwio.h"
 #include "dpu_hw_catalog.h"
@@ -1241,6 +1244,7 @@ static void dpu_encoder_virt_atomic_mode_set(struct drm_encoder *drm_enc,
 	int num_ctl, num_pp, num_dsc, num_pp_per_intf;
 	int num_cwb = 0;
 	bool is_cwb_encoder;
+	bool uke_dfps = false;
 	unsigned int dsc_mask = 0;
 	unsigned int cwb_mask = 0;
 	int i;
@@ -1306,6 +1310,9 @@ static void dpu_encoder_virt_atomic_mode_set(struct drm_encoder *drm_enc,
 	}
 
 	dpu_enc->dsc_mask = dsc_mask;
+#if IS_ENABLED(CONFIG_DRM_MSM_DSI)
+	uke_dfps = msm_dsi_manager_uke_dfps_pending(drm_enc);
+#endif
 
 	if ((dpu_enc->disp_info.intf_type == INTF_WB && conn_state->writeback_job) ||
 	    dpu_enc->disp_info.intf_type == INTF_DP) {
@@ -1347,6 +1354,8 @@ static void dpu_encoder_virt_atomic_mode_set(struct drm_encoder *drm_enc,
 		phys->cached_mode = crtc_state->adjusted_mode;
 		if (phys->ops.atomic_mode_set)
 			phys->ops.atomic_mode_set(phys, crtc_state, conn_state);
+		if (uke_dfps && phys->ops.seamless_mode_set)
+			phys->ops.seamless_mode_set(phys);
 	}
 }
 
