+int msm_dp_display_atomic_check(struct msm_dp *display,
+			       const struct drm_display_mode *mode,
+			       struct drm_connector_state *conn_state,
+			       struct msm_dp_bridge_state *state)
+{
+	struct msm_dp_display_private *dp =
+		container_of(display, struct msm_dp_display_private, msm_dp_display);
+	const struct drm_display_info *info = &conn_state->connector->display_info;
+	bool yuv420 = drm_mode_is_420_only(info, mode);
+	int bpp, ret;
+
+	guard(mutex)(&dp->plugged_lock);
+	if (!dp->plugged || !dp->panel->link_info.rate || !dp->panel->link_info.num_lanes)
+		return -ENODEV;
+	ret = msm_dp_utils_pack_hdr_sdp(conn_state, &state->hdr_sdp);
+	if (ret)
+		return ret;
+	state->hdr_enabled = !!conn_state->hdr_output_metadata;
+	if (state->hdr_enabled && dp->panel->hw_revision < DP_HW_VERSION_1_0)
+		return -EINVAL;
+	bpp = msm_dp_utils_select_bpp(info->bpc, conn_state->max_requested_bpc ?: 8,
+			mode->clock, dp->panel->link_info.rate, dp->panel->link_info.num_lanes,
+			yuv420, state->hdr_enabled &&
+			state->hdr_sdp.db[2] != HDMI_EOTF_TRADITIONAL_GAMMA_SDR);
+	if (bpp < 0)
+		return bpp;
+	state->bpp = bpp;
+	state->colorspace = conn_state->colorspace;
+	state->vsc_enabled = yuv420 || state->hdr_enabled ||
+		state->colorspace != DRM_MODE_COLORIMETRY_DEFAULT;
+	if (!state->vsc_enabled)
+		return 0;
+	if (!dp->panel->vsc_sdp_supported)
+		return -EINVAL;
+	return msm_dp_utils_pack_vsc_sdp(&state->vsc_sdp, state->colorspace, bpp / 3, yuv420);
 }
 
