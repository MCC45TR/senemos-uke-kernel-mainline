+static ssize_t uke_dp_stream_state_show(struct device *dev,
+					struct device_attribute *attr, char *buf)
+{
+	struct msm_dp_display_private *dp = dev_get_dp_display_private(dev);
+	struct msm_dp_panel *panel = dp->panel;
+	bool active;
+
+	/* Cached software state only: no runtime resume, AUX access or MMIO. */
+	guard(mutex)(&dp->plugged_lock);
+	active = READ_ONCE(dp->msm_dp_display.power_on);
+	return sysfs_emit(buf,
+		"version=1 active=%u lanes=%u rate_khz=%u bpp=%u max_lanes=%u max_rate_khz=%u source_max_lanes=%u sink_max_lanes=%u dpcd_revision=0x%02x vsc_supported=%u hw_revision=0x%x hdr_requested=%u mst_driver=0\n",
+		active, active ? READ_ONCE(dp->link->link_params.num_lanes) : 0,
+		active ? READ_ONCE(dp->link->link_params.rate) : 0,
+		active ? READ_ONCE(panel->msm_dp_mode.bpp) : 0,
+		panel->link_info.num_lanes, panel->link_info.rate,
+		dp->link->max_dp_lanes, drm_dp_max_lane_count(panel->dpcd), panel->dpcd[DP_DPCD_REV],
+		panel->vsc_sdp_supported, panel->hw_revision, READ_ONCE(panel->hdr_active));
+}
+static DEVICE_ATTR_RO(uke_dp_stream_state);
+
+static struct attribute *uke_dp_stream_attrs[] = {
+	&dev_attr_uke_dp_stream_state.attr,
+	NULL,
+};
+static const struct attribute_group uke_dp_stream_group = {
+	.attrs = uke_dp_stream_attrs,
+};
+
+static void msm_dp_display_link_status_work(struct work_struct *work)
+{
+	struct msm_dp_display_private *dp = container_of(work,
+		struct msm_dp_display_private, link_status_work);
+	struct drm_connector *connector = dp->msm_dp_display.connector;
+	bool notify;
+
+	scoped_guard(mutex, &dp->plugged_lock) {
+		if (!dp->link_failed || !dp->plugged || !connector)
+			return;
+		notify = !dp->link_status_notified;
+		dp->link_status_notified = true;
+	}
+	/* This helper takes connection_mutex; never hold plugged_lock here. */
+	drm_connector_set_link_status_property(connector, DRM_MODE_LINK_STATUS_BAD);
+	if (notify)
+		drm_kms_helper_connector_hotplug_event(connector);
+}
