From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] drm/msm/dsi: retain exact O82 DSC rate-control parameters

Xiaomi display 44275c404a677d9d9e5230fedd1af2ef02fc7b9a uses first-line
BPG offset 13 and NT36532 max QP 8 for range zero on both O82 variants
(msm/sde_dsc_helper.c and msm/mi_disp/mi_panel_id.h, GPL-2.0-only).
The panel's OEM 0x91 sequence already contains the corresponding derived
parameters. Apply the two differences before computing encoder RC values.
Identify the remote panel through each host's graph, including the secondary
DSI device without its own OF node. Other panels retain upstream defaults.
This patch is isolated from the normal release profile.

--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -1897,5 +1897,6 @@
 static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc_config *dsc)
 {
+	struct device_node *panel_node;
 	int ret;
 
 	if (dsc->bits_per_pixel & 0xf) {
@@ -1938,6 +1939,21 @@
 		return ret;
 	}
 
+	panel_node = of_graph_get_remote_node(msm_host->pdev->dev.of_node, 1, -1);
+	if (of_device_is_compatible(panel_node, "xiaomi,o82-36-02-0a") ||
+	    of_device_is_compatible(panel_node, "xiaomi,o82-42-02-0b")) {
+		of_node_put(panel_node);
+		if (dsc->dsc_version_major != 1 || dsc->dsc_version_minor != 1 ||
+		    dsc->bits_per_component != 10 || dsc->bits_per_pixel != 8 << 4 ||
+		    dsc->slice_width != 800 || dsc->slice_height != 24)
+			return -EINVAL;
+		/* Exact Uke O82 NT36532 rate control, before derived parameters. */
+		dsc->first_line_bpg_offset = 13;
+		dsc->rc_range_params[0].range_max_qp = 8;
+	} else {
+		of_node_put(panel_node);
+	}
+
 	dsc->initial_scale_value = drm_dsc_initial_scale_value(dsc);
 	dsc->line_buf_depth = dsc->bits_per_component + 1;
 
--
