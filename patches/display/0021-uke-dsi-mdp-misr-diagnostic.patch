+/* Immutable admission is also used to serialize this board's enable/disable. */
+static bool dsi_uke_misr_scope(struct msm_dsi_host *msm_host)
+{
+	return IS_ENABLED(CONFIG_DEBUG_FS) &&
+		of_machine_is_compatible("xiaomi,uke") &&
+		of_machine_is_compatible("qcom,sm7675") &&
+		(msm_host->id == DSI_0 || msm_host->id == DSI_1) &&
+		msm_host->cfg_hnd && msm_host->cfg_hnd->cfg &&
+		msm_host->cfg_hnd->major == MSM_DSI_VER_MAJOR_6G &&
+		msm_host->cfg_hnd->minor == MSM_DSI_6G_VER_MINOR_V2_8_0 &&
+		msm_host->cfg_hnd->cfg->io_offset == DSI_6G_REG_SHIFT &&
+		msm_host->ctrl_size >= UKE_DSI_MISR_SIGNATURE + sizeof(u32);
+}
+
+/*
+ * Bounded, default-off diagnostic for a held 120 Hz video pattern. The setup
+ * matches MiCode xiaomi-display 44275c404a67 dsi_ctrl_hw_22_setup_misr().
+ * It measures the controller's MDP signature, not optical or PHY reception.
+ * No panel command, mode, link clock, or transmit-buffer state is changed.
+ */
+static int dsi_uke_misr_capture(struct msm_dsi_host *msm_host, unsigned int count)
+{
+	struct uke_dsi_misr_capture *capture = &msm_host->misr_capture;
+	struct device *dev = &msm_host->pdev->dev;
+	u64 sequence;
+	unsigned int i;
+	int ret;
+
+	if (!count || count > UKE_DSI_MISR_MAX_SAMPLES)
+		return -EINVAL;
+	ret = mutex_lock_interruptible(&msm_host->dev_mutex);
+	if (ret)
+		return ret;
+	ret = mutex_lock_interruptible(&msm_host->cmd_mutex);
+	if (ret)
+		goto unlock_dev;
+
+	sequence = capture->sequence + 1;
+	memset(capture, 0, sizeof(*capture));
+	capture->sequence = sequence;
+	capture->started_ns = ktime_get_ns();
+	capture->requested = count;
+	if (!dsi_uke_misr_scope(msm_host) ||
+	    !(msm_host->mode_flags & MIPI_DSI_MODE_VIDEO) ||
+	    msm_host->cphy_mode || msm_host->lanes != 4 || !msm_host->mode ||
+	    msm_host->mode->hdisplay != 3200 || msm_host->mode->vdisplay != 2136 ||
+	    drm_mode_vrefresh(msm_host->mode) != 120) {
+		ret = -EOPNOTSUPP;
+		goto done;
+	}
+	if (!msm_host->power_on || !msm_host->enabled ||
+	    READ_ONCE(msm_host->cmd_dma_blocked)) {
+		ret = -EBUSY;
+		goto done;
+	}
+	/* Never wake an inactive controller or change the running link clocks. */
+	ret = pm_runtime_get_if_active(dev);
+	if (ret <= 0) {
+		if (!ret)
+			ret = -EAGAIN;
+		goto done;
+	}
+	capture->engine_before = dsi_read(msm_host, REG_DSI_CTRL);
+	if ((capture->engine_before & (DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN)) !=
+	    (DSI_CTRL_ENABLE | DSI_CTRL_VID_MODE_EN)) {
+		ret = -EBUSY;
+		goto put;
+	}
+	capture->control_before = dsi_read(msm_host, UKE_DSI_MISR_CTRL);
+	/* Bit9 remains set after OEM disable; do not replay it as configuration. */
+	if (capture->control_before & ~UKE_DSI_MISR_STATUS) {
+		ret = -EBUSY;
+		goto put;
+	}
+	dsi_write(msm_host, UKE_DSI_MISR_CTRL, 0);
+	wmb();
+	dsi_write(msm_host, UKE_DSI_MISR_CTRL, UKE_DSI_MISR_CONFIG);
+	wmb();
+	ret = 0;
+	for (i = 0; i < count; i++) {
+		/* More than three admitted frames; sticky status is not freshness. */
+		if (msleep_interruptible(30)) {
+			ret = -ERESTARTSYS;
+			break;
+		}
+		capture->samples[i].control = dsi_read(msm_host, UKE_DSI_MISR_CTRL);
+		capture->samples[i].signature = dsi_read(msm_host, UKE_DSI_MISR_SIGNATURE);
+		capture->completed++;
+		if ((capture->samples[i].control & ~UKE_DSI_MISR_STATUS) !=
+		    UKE_DSI_MISR_CONFIG) {
+			ret = -EIO;
+			break;
+		}
+		if (!(capture->samples[i].control & UKE_DSI_MISR_STATUS)) {
+			ret = -ETIMEDOUT;
+			break;
+		}
+	}
+	/* Restore the admitted writable state, including every interrupted path. */
+	dsi_write(msm_host, UKE_DSI_MISR_CTRL, 0);
+	wmb();
+	capture->control_after = dsi_read(msm_host, UKE_DSI_MISR_CTRL);
+	capture->engine_after = dsi_read(msm_host, REG_DSI_CTRL);
+	if ((capture->control_after & ~UKE_DSI_MISR_STATUS) ||
+	    capture->engine_before != capture->engine_after)
+		ret = -EIO;
+put:
+	pm_runtime_put(dev);
+done:
+	capture->result = ret;
+	capture->finished_ns = ktime_get_ns();
+	mutex_unlock(&msm_host->cmd_mutex);
+unlock_dev:
+	mutex_unlock(&msm_host->dev_mutex);
+	return ret;
+}
+
+static ssize_t dsi_uke_misr_write(struct file *file, const char __user *buf,
+				size_t len, loff_t *ppos)
+{
+	struct msm_dsi_host *msm_host = file->private_data;
+	unsigned int count;
+	int ret;
+
+	if (!len || len > 16)
+		return -EINVAL;
+	ret = kstrtouint_from_user(buf, len, 10, &count);
+	if (ret)
+		return ret;
+	ret = dsi_uke_misr_capture(msm_host, count);
+	return ret ? ret : len;
+}
+
+static ssize_t dsi_uke_misr_read(struct file *file, char __user *buf,
+			       size_t len, loff_t *ppos)
+{
+	struct msm_dsi_host *msm_host = file->private_data;
+	struct uke_dsi_misr_capture capture;
+	char text[1024];
+	unsigned int i;
+	int used;
+
+	mutex_lock(&msm_host->dev_mutex);
+	capture = msm_host->misr_capture;
+	mutex_unlock(&msm_host->dev_mutex);
+	if (!capture.sequence)
+		return -ENODATA;
+	used = scnprintf(text, sizeof(text),
+		"host=%d cached=1 sequence=%llu result=%d requested=%u completed=%u "
+		"started_ns=%llu finished_ns=%llu\n"
+		"control_before=%08x control_after=%08x engine_before=%08x engine_after=%08x\n",
+		msm_host->id, capture.sequence, capture.result, capture.requested,
+		capture.completed, capture.started_ns, capture.finished_ns,
+		capture.control_before, capture.control_after,
+		capture.engine_before, capture.engine_after);
+	for (i = 0; i < capture.completed; i++)
+		used += scnprintf(text + used, sizeof(text) - used,
+			"sample=%u control=%08x signature=%08x\n", i,
+			capture.samples[i].control, capture.samples[i].signature);
+	return simple_read_from_buffer(buf, len, ppos, text, used);
+}
+
+static const struct file_operations dsi_uke_misr_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = dsi_uke_misr_read,
+	.write = dsi_uke_misr_write,
+	.llseek = no_llseek,
+};
