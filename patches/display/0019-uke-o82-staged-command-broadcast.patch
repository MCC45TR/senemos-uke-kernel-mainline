 	int bllp_len = msm_host->mode->hdisplay *
@@ -1566,7 +1690,7 @@
 		return -EINVAL;
 	}
 
-	ret = dsi_cmd_dma_tx(msm_host, len, is_read);
+	ret = dsi_cmd_dma_tx(msm_host, len, is_read, broadcast_master);
 	if (ret < 0) {
 		pr_err("%s: cmd dma tx failed, type=0x%x, data0=0x%x, len=%d, ret=%d\n",
 			__func__, msg->type, (*(u8 *)(msg->tx_buf)), len, ret);
@@ -1584,8 +1708,13 @@
 {
 	struct msm_dsi_host *msm_host =
 		container_of(work, struct msm_dsi_host, err_work);
-	u32 status = msm_host->err_work_state;
+	u32 status;
 
+	/* Do not race command DMA, its abort, or a held-reset quarantine. */
+	mutex_lock(&msm_host->cmd_mutex);
+	if (READ_ONCE(msm_host->cmd_dma_blocked))
+		goto unlock;
+	status = msm_host->err_work_state;
 	pr_err_ratelimited("%s: status=%x\n", __func__, status);
 	if (status & DSI_ERR_STATE_MDP_FIFO_UNDERFLOW)
 		dsi_sw_reset(msm_host);
@@ -1595,6 +1724,8 @@
 
 	/* enable dsi error interrupt */
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_ERROR, 1);
+unlock:
+	mutex_unlock(&msm_host->cmd_mutex);
 }
 
 static void dsi_ack_err_status(struct msm_dsi_host *msm_host)
@@ -1801,7 +1932,10 @@
 		return -EINVAL;
 
 	mutex_lock(&msm_host->cmd_mutex);
-	ret = msm_dsi_manager_cmd_xfer(msm_host->id, msg);
+	if (READ_ONCE(msm_host->cmd_dma_blocked))
+		ret = -EIO;
+	else
+		ret = msm_dsi_manager_cmd_xfer(msm_host->id, msg);
 	mutex_unlock(&msm_host->cmd_mutex);
 
 	return ret;
@@ -2156,6 +2290,8 @@
 	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
 	int ret;
 
+	if (READ_ONCE(msm_host->cmd_dma_blocked))
+		return -EIO;
 	msm_host->dev = dev;
 
 	ret = cfg_hnd->ops->tx_buf_alloc(msm_host, SZ_4K);
@@ -2239,6 +2375,8 @@
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
 
+	if (READ_ONCE(msm_host->cmd_dma_blocked))
+		goto disable_clocks;
 	dsi_intr_ctrl(msm_host, DSI_IRQ_MASK_CMD_DMA_DONE, 0);
 	dsi_write(msm_host, REG_DSI_CTRL, msm_host->dma_cmd_ctrl_restore);
 
@@ -2247,16 +2385,64 @@
 
 	/* TODO: unvote for bus bandwidth */
 
+disable_clocks:
 	cfg_hnd->ops->link_clk_disable(msm_host);
 	pm_runtime_put(&msm_host->pdev->dev);
 }
 
+int msm_dsi_host_cmd_broadcast(struct mipi_dsi_host *master_host,
+			       struct mipi_dsi_host *slave_host,
+			       const struct mipi_dsi_msg *msg)
+{
+	struct msm_dsi_host *master = to_msm_dsi_host(master_host);
+	struct msm_dsi_host *slave = to_msm_dsi_host(slave_host);
+	int ret;
+
+	/* The manager admits only Uke O82 bonded video writes. */
+	if (master->id != DSI_0 || slave->id != DSI_1 ||
+	    (msg->rx_buf && msg->rx_len) ||
+	    !master->power_on || !slave->power_on ||
+	    master->cphy_mode || slave->cphy_mode ||
+	    master->cfg_hnd->major != MSM_DSI_VER_MAJOR_6G ||
+	    slave->cfg_hnd->major != MSM_DSI_VER_MAJOR_6G ||
+	    master->cfg_hnd->minor != MSM_DSI_6G_VER_MINOR_V2_8_0 ||
+	    slave->cfg_hnd->minor != MSM_DSI_6G_VER_MINOR_V2_8_0 ||
+	    !master->vm || master->vm != slave->vm)
+		return -EINVAL;
+
+	/* dsi_host_transfer holds slave1. No primary0 transfer takes slave1. */
+	lockdep_assert_held(&slave->cmd_mutex);
+	mutex_lock_nested(&master->cmd_mutex, SINGLE_DEPTH_NESTING);
+	if (READ_ONCE(master->cmd_dma_blocked) || READ_ONCE(slave->cmd_dma_blocked)) {
+		ret = -EIO;
+		goto unlock;
+	}
+	ret = msm_dsi_host_xfer_prepare(master_host, msg);
+	if (ret)
+		goto unlock;
+	ret = msm_dsi_host_xfer_prepare(slave_host, msg);
+	if (ret)
+		goto restore_master;
+
+	/* Both TX buffers use the same KMS VM; the peer can read this IOVA. */
+	ret = dsi_cmds2buf_tx(slave, msg, false, master);
+	if (ret >= 0)
+		dev_info_once(&slave->pdev->dev,
+			      "Uke O82 staged command broadcast completed on both links\n");
+	msm_dsi_host_xfer_restore(slave_host, msg);
+restore_master:
+	msm_dsi_host_xfer_restore(master_host, msg);
+unlock:
+	mutex_unlock(&master->cmd_mutex);
+	return ret;
+}
+
