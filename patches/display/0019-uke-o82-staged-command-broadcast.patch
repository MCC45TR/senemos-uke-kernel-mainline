-static int dsi_cmd_dma_tx(struct msm_dsi_host *msm_host, int len, bool is_read)
+static int dsi_cmd_dma_wait_idle(struct msm_dsi_host *msm_host)
+{
+	u32 status;
+
+	return read_poll_timeout(dsi_read, status,
+			 !(status & DSI_STATUS0_CMD_MODE_DMA_BUSY),
+			 10, 5000, false, msm_host, REG_DSI_STATUS0);
+}
+
+static int dsi_cmd_dma_abort_broadcast(struct msm_dsi_host *master,
+				     struct msm_dsi_host *slave)
+{
+	struct msm_dsi_host *hosts[] = { master, slave };
+	int i, master_idle, slave_idle;
+
+	/* Stop both engines before resetting either member of the bonded pair. */
+	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+		dsi_intr_ctrl(hosts[i], DSI_IRQ_MASK_CMD_DMA_DONE, 0);
+		dsi_op_mode_config(hosts[i], false, false);
+		hosts[i]->enabled = false;
+		hosts[i]->dma_cmd_ctrl_restore &= ~(DSI_CTRL_ENABLE |
+				DSI_CTRL_CMD_MODE_EN | DSI_CTRL_VID_MODE_EN);
+	}
+	for (i = 0; i < ARRAY_SIZE(hosts); i++)
+		synchronize_irq(hosts[i]->irq);
+	for (i = 0; i < ARRAY_SIZE(hosts); i++)
+		dsi_sw_reset(hosts[i]);
+
+	master_idle = dsi_cmd_dma_wait_idle(master);
+	slave_idle = dsi_cmd_dma_wait_idle(slave);
+	if (master_idle || slave_idle) {
+		/* Do not restore command roles, reuse or release a possibly live TX. */
+		/* shortcut: trial-only quarantine; reboot without unbind/reprobe,
+		 * module unload or KMS teardown. VM references do not retain the
+		 * SMMU attachment across teardown. No production recovery claim.
+		 */
+		for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+			WRITE_ONCE(hosts[i]->cmd_dma_blocked, true);
+			dsi_write(hosts[i], REG_DSI_RESET, 1);
+		}
+		wmb();
+		pr_err("%s: DMA still busy after reset: master=%d slave=%d; reboot required\n",
+		       __func__, master_idle, slave_idle);
+		return -EIO;
+	}
+
+	/* Clear latched status and finish any stale handler before reusing TX. */
+	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+		dsi_intr_ctrl(hosts[i], DSI_IRQ_MASK_CMD_DMA_DONE, 0);
+		synchronize_irq(hosts[i]->irq);
+		reinit_completion(&hosts[i]->dma_comp);
+	}
+	return 0;
+}
+
+static int dsi_cmd_dma_broadcast(struct msm_dsi_host *master,
+			       struct msm_dsi_host *slave, u32 dma_base, int len)
+{
+	u32 master_ctrl, slave_ctrl;
+	unsigned long master_done, slave_done;
+
+	dsi_wait4video_eng_busy(slave);
+	master_ctrl = dsi_read(master, REG_DSI_CMD_DMA_CTRL);
+	slave_ctrl = dsi_read(slave, REG_DSI_CMD_DMA_CTRL);
+	reinit_completion(&master->dma_comp);
+	reinit_completion(&slave->dma_comp);
+
+	/* Stage both links before arming slave1 and starting master0. */
+	dsi_write(master, REG_DSI_CMD_DMA_CTRL,
+		  master_ctrl | DSI_CMD_DMA_CTRL_BROADCAST_EN |
+		  DSI_CMD_DMA_CTRL_BROADCAST_MASTER);
+	dsi_write(slave, REG_DSI_CMD_DMA_CTRL,
+		  (slave_ctrl | DSI_CMD_DMA_CTRL_BROADCAST_EN) &
+		  ~DSI_CMD_DMA_CTRL_BROADCAST_MASTER);
+	dsi_write(master, REG_DSI_DMA_BASE, dma_base);
+	dsi_write(master, REG_DSI_DMA_LEN, len);
+	dsi_write(slave, REG_DSI_DMA_BASE, dma_base);
+	dsi_write(slave, REG_DSI_DMA_LEN, len);
+	wmb();
+	dsi_write(slave, REG_DSI_TRIG_DMA, 1);
+	dsi_write(master, REG_DSI_TRIG_DMA, 1);
+	wmb();
+
+	master_done = wait_for_completion_timeout(&master->dma_comp,
+						msecs_to_jiffies(200));
+	/* Wait for the peer even if the master times out. */
+	slave_done = wait_for_completion_timeout(&slave->dma_comp,
+					       msecs_to_jiffies(200));
+	if (!master_done || !slave_done) {
+		pr_err("%s: DMA completion timeout: master=%lu slave=%lu\n",
+		       __func__, master_done, slave_done);
+		if (dsi_cmd_dma_abort_broadcast(master, slave))
+			return -EIO;
+		dsi_write(slave, REG_DSI_CMD_DMA_CTRL, slave_ctrl);
+		dsi_write(master, REG_DSI_CMD_DMA_CTRL, master_ctrl);
+		return -ETIMEDOUT;
+	}
+	dsi_write(slave, REG_DSI_CMD_DMA_CTRL, slave_ctrl);
+	dsi_write(master, REG_DSI_CMD_DMA_CTRL, master_ctrl);
+
+	return len;
+}
+
+static int dsi_cmd_dma_tx(struct msm_dsi_host *msm_host, int len, bool is_read,
+			   struct msm_dsi_host *broadcast_master)
 {
 	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
 	int ret;
@@ -1465,6 +1582,12 @@
 		pr_err("%s: failed to get iova: %d\n", __func__, ret);
 		return ret;
 	}
+	if (broadcast_master) {
+		if (dma_base > U32_MAX)
+			return -ERANGE;
+		return dsi_cmd_dma_broadcast(broadcast_master, msm_host,
+					    dma_base, len);
+	}
 
 	reinit_completion(&msm_host->dma_comp);
 
@@ -1537,7 +1660,8 @@
 }
 
