From: Uke Linux development <noreply@github.com>
Subject: [PATCH] drm/msm/dsi: preserve installed O82 post-start LP groups

The working Uke O82-42 display uses one two-packet LP normal-pixel group
and one four-packet LP dimming group. Its selected runtime DT and command
metadata differ from the published common panel table. Admit only these
exact groups on the isolated initial-120-Hz profile and reuse the existing
synchronous paired broadcast, final-only LAST, scheduling and quarantine.
No delay, rate, reset, packet payload or normal-release policy changes.

Source: MiCode display 44275c404a677d9d9e5230fedd1af2ef02fc7b9a,
msm/dsi/dsi_display.c and msm/dsi/dsi_ctrl.c, GPL-2.0-only; copyright
The Linux Foundation and Qualcomm Innovation Center, Inc. Same-SoC Nord 4
1138e00fee63582a0cc6a53af3286621786827b7 corroborates shared transport only.
Host checks and physical display acceptance remain separate.

diff --git a/drivers/gpu/drm/msm/dsi/dsi.h b/drivers/gpu/drm/msm/dsi/dsi.h
--- a/drivers/gpu/drm/msm/dsi/dsi.h
+++ b/drivers/gpu/drm/msm/dsi/dsi.h
@@ -71,6 +71,9 @@
 int msm_dsi_host_cmd_tp_fps(struct mipi_dsi_host *master_host,
 			  struct mipi_dsi_host *slave_host,
 			  const struct mipi_dsi_msg msgs[4]);
+int msm_dsi_host_cmd_lp_batch(struct mipi_dsi_host *master_host,
+			    struct mipi_dsi_host *slave_host,
+			    const struct mipi_dsi_msg *msgs, unsigned int count);
 int msm_dsi_host_cmd_on_batch(struct mipi_dsi_host *master_host,
 			    struct mipi_dsi_host *slave_host,
 			    const struct mipi_dsi_msg *msgs, unsigned int count);
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -2894,6 +2894,38 @@
 	return ret;
 }
 
+int msm_dsi_host_cmd_lp_batch(struct mipi_dsi_host *master_host,
+			    struct mipi_dsi_host *slave_host,
+			    const struct mipi_dsi_msg *msgs, unsigned int count)
+{
+	static const u8 normal[2][3] = {
+		{ 0x15, 0xff, 0x10 }, { 0x39, 0x13, 0x00 },
+	};
+	static const u8 dimming[4][3] = {
+		{ 0x39, 0xff, 0x27 }, { 0x39, 0xd1, 0x28 },
+		{ 0x15, 0xff, 0x10 }, { 0x15, 0x53, 0x2c },
+	};
+	const u8 (*commands)[3];
+	struct msm_dsi_host *slave;
+	unsigned int i;
+	int ret;
+
+	if (!master_host || !slave_host || !msgs || (count != 2 && count != 4))
+		return -EINVAL;
+	commands = count == 2 ? normal : dimming;
+	for (i = 0; i < count; i++)
+		if (msgs[i].type != commands[i][0] || msgs[i].channel ||
+		    msgs[i].flags != MIPI_DSI_MSG_USE_LPM ||
+		    msgs[i].rx_buf || msgs[i].rx_len || msgs[i].tx_len != 2 ||
+		    !msgs[i].tx_buf || memcmp(msgs[i].tx_buf, &commands[i][1], 2))
+			return -EINVAL;
+	slave = to_msm_dsi_host(slave_host);
+	mutex_lock(&slave->cmd_mutex);
+	ret = dsi_host_cmd_broadcast(master_host, slave_host, msgs, count, false);
+	mutex_unlock(&slave->cmd_mutex);
+	return ret;
+}
+
 int msm_dsi_host_cmd_on_batch(struct mipi_dsi_host *master_host,
 			    struct mipi_dsi_host *slave_host,
 			    const struct mipi_dsi_msg *msgs, unsigned int count)
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -638,5 +638,22 @@
 EXPORT_SYMBOL_GPL(qcom_uke_dsi_on_batch);
 
+int qcom_uke_dsi_lp_batch(struct mipi_dsi_device *dsi,
+			 const struct mipi_dsi_msg *msgs, unsigned int count)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_0);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_1);
+
+	if (!dsi || !msgs || !dsi->host || !master || !slave ||
+	    !master->host || !slave->host ||
+	    dsi->host != master->host || !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
+	    IS_ERR_OR_NULL(dsi_mgr_o82_panel(master)) ||
+	    !of_device_is_compatible(dsi->dev.of_node, "xiaomi,o82-42-02-0b") ||
+	    !of_property_read_bool(dsi->dev.of_node, "xiaomi,initial-120hz-only"))
+		return -EOPNOTSUPP;
+	return msm_dsi_host_cmd_lp_batch(master->host, slave->host, msgs, count);
+}
+EXPORT_SYMBOL_GPL(qcom_uke_dsi_lp_batch);
+
 int msm_dsi_manager_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
 {
 	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
