+int msm_dp_utils_select_pcon(const struct drm_display_info *info,
+		const u8 dpcd[DP_RECEIVER_CAP_SIZE], const u8 ports[DP_MAX_DOWNSTREAM_PORTS],
+		const struct drm_display_mode *mode, unsigned int bpp, bool source420,
+		enum drm_colorspace colorspace, struct msm_dp_pcon_config *config)
+{
+	u8 cap, conversion;
+	u32 tmds = info->max_tmds_clock;
+	bool detailed = drm_dp_is_branch(dpcd) && dpcd[DP_DPCD_REV] >= 0x13 &&
+		(dpcd[DP_DOWNSTREAMPORT_PRESENT] & DP_DETAILED_CAP_INFO_AVAILABLE) &&
+		(ports[0] & DP_DS_PORT_TYPE_MASK) == DP_DS_PORT_TYPE_HDMI;
+
+	memset(config, 0, sizeof(*config));
+	if (detailed && ports[1])
+		tmds = tmds ? min(tmds, ports[1] * 2500U) : ports[1] * 2500U;
+	config->format = source420 ? DP_PIXELFORMAT_YUV420 : DP_PIXELFORMAT_RGB;
+	config->configure = detailed && !!(ports[3] &
+		(DP_DS_HDMI_YCBCR444_TO_422_CONV | DP_DS_HDMI_YCBCR444_TO_420_CONV |
+		 DP_DS_HDMI_BT709_RGB_YCBCR_CONV | DP_DS_HDMI_BT2020_RGB_YCBCR_CONV));
+	if (!info->is_hdmi)
+		return 0;
+	if (source420 && drm_dp_is_branch(dpcd) && !drm_dp_downstream_420_passthrough(dpcd, ports))
+		return -EOPNOTSUPP;
+	if (msm_dp_utils_tmds_fits(mode->clock, bpp, tmds, source420))
+		return 0;
+	if (source420 || !detailed)
+		return -ENOSPC;
+	if (colorspace == DRM_MODE_COLORIMETRY_BT2020_RGB) {
+		cap = DP_DS_HDMI_BT2020_RGB_YCBCR_CONV;
+		conversion = DP_CONVERSION_BT2020_RGB_YCBCR_ENABLE;
+	} else if (colorspace == DRM_MODE_COLORIMETRY_DEFAULT) {
+		cap = DP_DS_HDMI_BT709_RGB_YCBCR_CONV;
+		conversion = DP_CONVERSION_BT709_RGB_YCBCR_ENABLE;
+	} else {
+		return -EOPNOTSUPP;
+	}
+	if (!drm_dp_downstream_rgb_to_ycbcr_conversion(dpcd, ports, cap))
+		return -ENOSPC;
+	/* HDMI 4:2:2 uses the pixel clock at every supported component depth. */
+	if ((info->color_formats & BIT(DRM_CONNECTOR_COLOR_FORMAT_YCBCR422)) &&
+	    (ports[3] & DP_DS_HDMI_YCBCR444_TO_422_CONV) &&
+	    msm_dp_utils_tmds_fits(mode->clock, 24, tmds, false)) {
+		config->format = DP_PIXELFORMAT_YUV422;
+		config->control2 = conversion | DP_CONVERSION_TO_YCBCR422_ENABLE;
+		return 0;
+	}
+	if (drm_mode_is_420(info, mode) &&
+	    (bpp <= 24 || (info->hdmi.y420_dc_modes & DRM_EDID_YCBCR420_DC_30)) &&
+	    drm_dp_downstream_444_to_420_conversion(dpcd, ports) &&
+	    msm_dp_utils_tmds_fits(mode->clock, bpp, tmds, true)) {
+		config->format = DP_PIXELFORMAT_YUV420;
+		config->control1 = DP_CONVERSION_TO_YCBCR420_ENABLE;
+		config->control2 = conversion;
+		return 0;
+	}
+	return -ENOSPC;
+}
+
+int msm_dp_utils_configure_pcon(struct drm_dp_aux *aux,
+			       const struct msm_dp_pcon_config *config)
+{
+	u8 before[2], value[2], readback[2];
+	u8 masks[2] = { DP_CONVERSION_TO_YCBCR420_ENABLE,
+		DP_CONVERSION_RGB_YCBCR_MASK | DP_CONVERSION_TO_YCBCR422_ENABLE };
+	unsigned int i;
+	int ret;
+
+	if (!config->configure)
+		return 0;
+	ret = drm_dp_dpcd_read_data(aux, DP_PROTOCOL_CONVERTER_CONTROL_1, before, 2);
+	if (ret)
+		return ret;
+	value[0] = (before[0] & ~masks[0]) | config->control1;
+	value[1] = (before[1] & ~masks[1]) | config->control2;
+	for (i = 0; i < 2; i++) {
+		ret = drm_dp_dpcd_write_byte(aux, DP_PROTOCOL_CONVERTER_CONTROL_1 + i, value[i]);
+		if (ret)
+			goto rollback;
+	}
+	ret = drm_dp_dpcd_read_data(aux, DP_PROTOCOL_CONVERTER_CONTROL_1, readback, 2);
+	if (!ret && !memcmp(value, readback, sizeof(value)))
+		return 0;
+	ret = ret ?: -EIO;
+rollback:
+	/* Keep DSC encoder/PPS and scrambling control bits outside this transaction. */
+	for (i = 0; i < 2; i++)
+		drm_dp_dpcd_write_byte(aux, DP_PROTOCOL_CONVERTER_CONTROL_1 + i, before[i]);
+	return ret;
+}
