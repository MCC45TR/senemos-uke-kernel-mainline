 		msm_dp_panel->dsc_caps_valid = !rc;
@@ -593,9 +599,17 @@
 		msm_dp_write_link(panel, REG_DP_PPS_DATA + i * 4,
 				  get_unaligned_le32(payload + i * 4));
 	msm_dp_write_pn(panel, MMSS_DP_DSC_DTO_COUNT, config->dto_count);
-	/* 8 compressed bpp on the two-pixel RGB interface uses the OEM 1/3 DTO. */
-	msm_dp_write_pn(panel, MMSS_DP_DSC_DTO, BIT(0) | BIT(3) | (1 << 8) | (3 << 16));
-	msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, config->compression_ctrl);
+	msm_dp_write_pn(panel, MMSS_DP_DSC_DTO, config->dto);
+	/* MST BE placement depends on the compressed line's last three-byte group. */
+	if (msm_dp_panel->mst_fec) {
+		u32 bytes = config->dsc.slice_chunk_size * config->dsc.slice_count;
+		u32 be = bytes % 12 ? BIT(DIV_ROUND_UP(bytes % 12, 3) - 1) : 8;
+
+		msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL,
+			(config->compression_ctrl & ~GENMASK(13, 10)) | (be << 10));
+	} else {
+		msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, config->compression_ctrl);
+	}
 	flush = msm_dp_read_link(panel, REG_DP_SDP_FLUSH);
 	/* OEM bit 0 sends PPS; clear bit 2 to repeat it with the stream. */
 	msm_dp_write_link(panel, REG_DP_SDP_FLUSH, (flush & ~BIT(2)) | BIT(0));
