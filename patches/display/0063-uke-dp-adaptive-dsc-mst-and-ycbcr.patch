 	if (id == DP_STREAM_0)
 		return reg;
+	/* SM7675 has two DSC packet banks, independent of the stream timing bank. */
+	if (is_s1 && reg >= REG_DP_COMPRESSION_MODE_CTRL &&
+	    reg < REG_DP_PPS_DATA + MSM_DP_DSC_RGB_PPS_BYTES)
+		return reg + 0x3e0;
+	if (is_s1 && reg == REG_DP_SDP_FLUSH)
+		return reg + 4;
 
 	switch (reg) {
 	case REG_DP_STATE_CTRL:
@@ -204,7 +210,7 @@
 	    dpcd[DP_DPCD_REV] >= 0x14) {
 		rc = drm_dp_dpcd_read_data(panel->aux, DP_DSC_SUPPORT,
 			msm_dp_panel->dsc_dpcd, sizeof(msm_dp_panel->dsc_dpcd));
-		if (!rc && drm_dp_sink_supports_dsc(msm_dp_panel->dsc_dpcd))
+		if (!rc)
