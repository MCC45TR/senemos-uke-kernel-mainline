+/* Serialize shared decompression/passthrough AUX flags under mst_lock. */
+static int msm_dp_mst_dsc_flag(struct msm_dp_mst *mst, struct msm_dp_panel *panel,
+			      struct drm_dp_aux *aux, u8 mask, bool enable)
+{
+	u8 value;
+	unsigned int i;
+	int ret;
+
+	if (!aux)
+		return 0;
+	for (i = 0; i < mst->max_streams; i++) {
+		struct msm_dp_panel *peer = mst->mst_encoders[i].dp_panel;
+
+		if (!peer || peer == panel || !peer->dsc_active)
+			continue;
+		if ((mask == DP_DECOMPRESSION_EN && peer->dsc_aux == aux) ||
+		    (mask == DP_DSC_PASSTHROUGH_EN && peer->passthrough_aux == aux))
+			return 0;
+	}
+	ret = drm_dp_dpcd_read_byte(aux, DP_DSC_ENABLE, &value);
+	if (ret)
+		return ret;
+	return drm_dp_dpcd_write_byte(aux, DP_DSC_ENABLE,
+				      enable ? value | mask : value & ~mask);
+}
+
+static int msm_dp_mst_set_dsc(struct msm_dp_mst *mst, struct msm_dp_panel *panel, bool enable)
+{
+	int ret, pass_ret;
+
+	if (!panel->dsc.dsc.bits_per_pixel)
+		return 0;
+	ret = msm_dp_mst_dsc_flag(mst, panel, panel->dsc_aux, DP_DECOMPRESSION_EN, enable);
+	pass_ret = msm_dp_mst_dsc_flag(mst, panel, panel->passthrough_aux,
+				      DP_DSC_PASSTHROUGH_EN, enable);
+	if (enable && (ret || pass_ret)) {
+		msm_dp_mst_dsc_flag(mst, panel, panel->passthrough_aux, DP_DSC_PASSTHROUGH_EN, false);
+		msm_dp_mst_dsc_flag(mst, panel, panel->dsc_aux, DP_DECOMPRESSION_EN, false);
+	}
+	panel->dsc_active = enable && !ret && !pass_ret;
+	return ret ?: pass_ret;
+}
