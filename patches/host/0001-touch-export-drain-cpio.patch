From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] host: drain the source CPIO before selecting touch inputs

Backport only the extraction correction from hardware-support commit
2b5530f2412a4a1040ecdfafd0820ec51dc4645c. Keep the frozen capture and
readiness sources; the newer owner also changes those runtime inputs.
Remove the temporary CPIO after extraction to retain the frozen export layout.

--- a/uke-sensors/src/prepare-touch-runtime.sh
+++ b/uke-sensors/src/prepare-touch-runtime.sh
@@ -16,7 +16,9 @@
 mkdir -p "$(dirname -- "$output")"
 stage=$(mktemp -d "$(dirname -- "$output")/.uke-touch-export.XXXXXX")
 trap 'rm -rf -- "$stage"' EXIT
-rpm2cpio "$source_rpm" | cpio --extract --quiet --to-stdout "./$archive" > "$stage/source.tar.xz"
+rpm2cpio "$source_rpm" > "$stage/source.cpio"
+cpio --extract --quiet --to-stdout "./$archive" < "$stage/source.cpio" > "$stage/source.tar.xz"
+rm -- "$stage/source.cpio"
 tar -tJf "$stage/source.tar.xz" > "$stage/paths"
 awk -v prefix="$prefix/" 'index($0,prefix)!=1 || /^\/|(^|\/)\.\.($|\/)/ {bad=1} END{exit bad}' "$stage/paths"
 tar -tvJf "$stage/source.tar.xz" | awk 'substr($0,1,1)!="-" && substr($0,1,1)!="d"{bad=1} END{exit bad}'
