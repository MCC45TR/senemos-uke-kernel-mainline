From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] ufs: preserve QCOM ICE and HCE notification errors

Return ICE errors from both QCOM HCE callbacks and stop before allocator
setup after PHY/crypto failure. Return PRE/POST notification errors from
both normal and broken-HCE core paths. Existing host init/reset callers
already stop on controller enable failure.

This inactive source correction does not alter an accepted DT or enable
crypto. The separate MMC void-CQE enable path remains unqualified.

diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
index 0a9366f..b8c6a27 100644
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -5083,7 +5083,7 @@ EXPORT_SYMBOL_GPL(ufshcd_hba_stop);
  */
 static int ufshcd_hba_execute_hce(struct ufs_hba *hba)
 {
-	int retry;
+	int retry, ret;
 
 	for (retry = 3; retry > 0; retry--) {
 		if (ufshcd_is_hba_active(hba))
@@ -5093,7 +5093,9 @@ static int ufshcd_hba_execute_hce(struct ufs_hba *hba)
 		/* UniPro link is disabled at this point */
 		ufshcd_set_link_off(hba);
 
-		ufshcd_vops_hce_enable_notify(hba, PRE_CHANGE);
+		ret = ufshcd_vops_hce_enable_notify(hba, PRE_CHANGE);
+		if (ret)
+			return ret;
 
 		/* start controller initialization sequence */
 		ufshcd_hba_start(hba);
@@ -5124,9 +5126,7 @@ static int ufshcd_hba_execute_hce(struct ufs_hba *hba)
 	/* enable UIC related interrupts */
 	ufshcd_enable_intr(hba, UFSHCD_UIC_MASK);
 
-	ufshcd_vops_hce_enable_notify(hba, POST_CHANGE);
-
-	return 0;
+	return ufshcd_vops_hce_enable_notify(hba, POST_CHANGE);
 }
 
 int ufshcd_hba_enable(struct ufs_hba *hba)
@@ -5135,7 +5135,9 @@ int ufshcd_hba_enable(struct ufs_hba *hba)
 
 	if (hba->quirks & UFSHCI_QUIRK_BROKEN_HCE) {
 		ufshcd_set_link_off(hba);
-		ufshcd_vops_hce_enable_notify(hba, PRE_CHANGE);
+		ret = ufshcd_vops_hce_enable_notify(hba, PRE_CHANGE);
+		if (ret)
+			return ret;
 
 		/* enable UIC related interrupts */
 		ufshcd_enable_intr(hba, UFSHCD_UIC_MASK);
@@ -5151,7 +5153,7 @@ int ufshcd_hba_enable(struct ufs_hba *hba)
 			return ret;
 		}
 
-		ufshcd_vops_hce_enable_notify(hba, POST_CHANGE);
+		ret = ufshcd_vops_hce_enable_notify(hba, POST_CHANGE);
 	} else {
 		ret = ufshcd_hba_execute_hce(hba);
 	}
diff --git a/drivers/ufs/host/ufs-qcom.c b/drivers/ufs/host/ufs-qcom.c
index 9da224e..e9636cc 100644
--- a/drivers/ufs/host/ufs-qcom.c
+++ b/drivers/ufs/host/ufs-qcom.c
@@ -157,10 +157,12 @@ static void ufs_qcom_config_ice_allocator(struct ufs_qcom_host *host)
 	ufshcd_writel(hba, config, REG_UFS_MEM_ICE_NUM_CORE);
 }
 
-static inline void ufs_qcom_ice_enable(struct ufs_qcom_host *host)
+static inline int ufs_qcom_ice_enable(struct ufs_qcom_host *host)
 {
 	if (host->hba->caps & UFSHCD_CAP_CRYPTO)
-		qcom_ice_enable(host->ice);
+		return qcom_ice_enable(host->ice);
+
+	return 0;
 }
 
 static const struct blk_crypto_ll_ops ufs_qcom_crypto_ops; /* forward decl */
@@ -317,8 +319,9 @@ static const struct blk_crypto_ll_ops ufs_qcom_crypto_ops = {
 
 #else
 
-static inline void ufs_qcom_ice_enable(struct ufs_qcom_host *host)
+static inline int ufs_qcom_ice_enable(struct ufs_qcom_host *host)
 {
+	return 0;
 }
 
 static int ufs_qcom_ice_init(struct ufs_qcom_host *host)
@@ -608,8 +611,12 @@ static int ufs_qcom_hce_enable_notify(struct ufs_hba *hba,
 	case POST_CHANGE:
 		/* check if UFS PHY moved from DISABLED to HIBERN8 */
 		err = ufs_qcom_check_hibern8(hba);
+		if (err)
+			break;
 		ufs_qcom_enable_hw_clk_gating(hba);
-		ufs_qcom_ice_enable(host);
+		err = ufs_qcom_ice_enable(host);
+		if (err)
+			break;
 		ufs_qcom_config_ice_allocator(host);
 		break;
 	default:
@@ -631,8 +638,7 @@ static int ufs_qcom_fw_managed_hce_enable_notify(struct ufs_hba *hba,
 		break;
 	case POST_CHANGE:
 		ufs_qcom_enable_hw_clk_gating(hba);
-		ufs_qcom_ice_enable(host);
-		break;
+		return ufs_qcom_ice_enable(host);
 	default:
 		dev_err(hba->dev, "Invalid status %d\n", status);
 		return -EINVAL;
