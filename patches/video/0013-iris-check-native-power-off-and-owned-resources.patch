+					return ret;
+			}
+		}
+		power->hardware_quiesced = true;
+	}
+	ret = iris_disable_power_domains(core, core->pmdomain_tbl->pd_devs[IRIS_HW_POWER_DOMAIN]);
 	if (ret)
-		dev_err(core->dev, "Iris33 2P quiesce failed: %d\n", ret);
+		return ret;
+	ret = iris_disable_unprepare_clock(core, IRIS_BSE_HW_CLK);
+	if (ret)
+		return ret;
+	ret = iris_disable_unprepare_clock(core, IRIS_HW_AHB_CLK);
+	if (ret)
+		return ret;
+	ret = iris_disable_unprepare_clock(core, IRIS_HW_CLK);
+	if (ret)
+		return ret;
+	power->hardware_started = false;
+	power->hardware_quiesced = false;
 
-disable_power:
-	/* Keep the native forced-shutdown policy; runtime fault handling is unqualified. */
-	iris_vpu_power_off_hw(core);
+	return 0;
 }
 
 static void iris_vpu33_2p_set_preset_registers(struct iris_core *core)
@@ -216,26 +238,37 @@ static void iris_vpu33_2p_set_preset_registers(struct iris_core *core)
 
 static int iris_vpu33_power_off_controller(struct iris_core *core)
 {
+	struct iris_core_power *power = &core->power;
+	bool checked = core->iris_platform_data->vpu_ops->power_off_checked;
 	u32 xo_rst_tbl_size = core->iris_platform_data->controller_rst_tbl_size;
 	u32 clk_rst_tbl_size = core->iris_platform_data->clk_rst_tbl_size;
 	u32 val = 0;
 	int ret;
 
+	if (checked && (!power->controller_started || power->controller_quiesced))
+		goto disable_ctrl_clock;
+
 	writel(MSK_SIGNAL_FROM_TENSILICA | MSK_CORE_POWER_ON, core->reg_base + CPU_CS_X2RPMH);
 
 	writel(REQ_POWER_DOWN_PREP, core->reg_base + WRAPPER_IRIS_CPU_NOC_LPI_CONTROL);
 
 	ret = readl_poll_timeout(core->reg_base + WRAPPER_IRIS_CPU_NOC_LPI_STATUS,
 				 val, val & BIT(0), 200, 2000);
-	if (ret)
+	if (ret) {
+		if (checked)
+			return ret;
 		goto disable_power;
+	}
 
 	writel(0x0, core->reg_base + WRAPPER_DEBUG_BRIDGE_LPI_CONTROL);
 
 	ret = readl_poll_timeout(core->reg_base + WRAPPER_DEBUG_BRIDGE_LPI_STATUS,
 				 val, val == 0, 200, 2000);
-	if (ret)
+	if (ret) {
+		if (checked)
+			return ret;
 		goto disable_power;
+	}
 
 	writel(CTL_AXI_CLK_HALT | CTL_CLK_HALT,
 	       core->reg_base + WRAPPER_TZ_CTL_AXI_CLOCK_CONFIG);
@@ -243,7 +276,9 @@ static int iris_vpu33_power_off_controller(struct iris_core *core)
 	writel(0x0, core->reg_base + WRAPPER_TZ_QNS4PDXFIFO_RESET);
 	writel(0x0, core->reg_base + WRAPPER_TZ_CTL_AXI_CLOCK_CONFIG);
 
-	reset_control_bulk_reset(clk_rst_tbl_size, core->resets);
+	ret = reset_control_bulk_reset(clk_rst_tbl_size, core->resets);
+	if (checked && ret)
+		return ret;
 
 	/* Disable MVP NoC clock */
 	val = readl(core->reg_base + AON_WRAPPER_MVP_NOC_CORE_CLK_CONTROL);
@@ -258,15 +293,20 @@ static int iris_vpu33_power_off_controller(struct iris_core *core)
 	/* poll AON spare register bit0 to become zero with 50ms timeout */
 	ret = readl_poll_timeout(core->reg_base + AON_WRAPPER_SPARE,
 				 val, (val & BIT(0)) == 0, 1000, 50000);
-	if (ret)
+	if (ret) {
+		if (checked)
+			return ret;
 		goto disable_power;
+	}
 
 	/* enable bit(1) to avoid cvp noc xo reset */
 	val = readl(core->reg_base + AON_WRAPPER_SPARE);
 	val |= BIT(1);
 	writel(val, core->reg_base + AON_WRAPPER_SPARE);
 
-	reset_control_bulk_assert(xo_rst_tbl_size, core->controller_resets);
+	ret = reset_control_bulk_assert(xo_rst_tbl_size, core->controller_resets);
+	if (checked && ret)
+		return ret;
 
 	/* De-assert MVP NoC reset */
 	val = readl(core->reg_base + AON_WRAPPER_MVP_NOC_CORE_SW_RESET);
@@ -275,7 +315,9 @@ static int iris_vpu33_power_off_controller(struct iris_core *core)
 
 	usleep_range(80, 100);
 
-	reset_control_bulk_deassert(xo_rst_tbl_size, core->controller_resets);
+	ret = reset_control_bulk_deassert(xo_rst_tbl_size, core->controller_resets);
+	if (checked && ret)
+		return ret;
 
 	/* reset AON spare register */
 	writel(0, core->reg_base + AON_WRAPPER_SPARE);
@@ -285,11 +327,55 @@ static int iris_vpu33_power_off_controller(struct iris_core *core)
 	val &= ~NOC_HALT;
 	writel(val, core->reg_base + AON_WRAPPER_MVP_NOC_CORE_CLK_CONTROL);
 
-	iris_disable_unprepare_clock(core, IRIS_CTRL_CLK);
+disable_ctrl_clock:
+	if (checked) {
+		power->controller_quiesced = true;
+		ret = iris_disable_unprepare_clock(core, IRIS_AHB_CLK);
+		if (ret)
+			return ret;
+	}
+	ret = iris_disable_unprepare_clock(core, IRIS_CTRL_CLK);
+	if (checked && ret)
+		return ret;
 
 disable_power:
-	iris_disable_power_domains(core, core->pmdomain_tbl->pd_devs[IRIS_CTRL_POWER_DOMAIN]);
-	iris_disable_unprepare_clock(core, IRIS_AXI_CLK);
+	ret = iris_disable_power_domains(core, core->pmdomain_tbl->pd_devs[IRIS_CTRL_POWER_DOMAIN]);
+	if (checked && ret)
+		return ret;
+	ret = iris_disable_unprepare_clock(core, IRIS_AXI_CLK);
+	if (checked && ret)
+		return ret;
+	if (checked) {
+		power->controller_started = false;
+		power->controller_quiesced = false;
+	}
+
+	return 0;
+}
+
+static int iris_vpu33_2p_power_off_checked(struct iris_core *core)
+{
+	struct iris_core_power *power = &core->power;
+	int ret;
+
+	ret = iris_vpu33_2p_power_off_hardware(core);
+	if (ret)
+		return ret;
+	ret = iris_vpu33_power_off_controller(core);
+	if (ret)
+		return ret;
+	if (power->opp_voted) {
+		ret = dev_pm_opp_set_opp(core->dev, NULL);
+		if (ret)
+			return ret;
+		power->opp_voted = false;
+	}
+	if (power->icc_voted) {
+		ret = iris_unset_icc_bw(core);
+		if (ret)
+			return ret;
+		power->icc_voted = false;
+	}
 
 	return 0;
 }
@@ -353,7 +439,7 @@ const struct vpu_ops iris_vpu33_ops = {
 };
 
 const struct vpu_ops iris_vpu33_2p_ops = {
-	.power_off_hw = iris_vpu33_2p_power_off_hardware,
+	.power_off_checked = iris_vpu33_2p_power_off_checked,
 	.power_on_hw = iris_vpu_power_on_hw,
 	.power_off_controller = iris_vpu33_power_off_controller,
 	.power_on_controller = iris_vpu_power_on_controller,
diff --git a/drivers/media/platform/qcom/iris/iris_vpu_common.c b/drivers/media/platform/qcom/iris/iris_vpu_common.c
index 6ca4d41..1457365 100644
--- a/drivers/media/platform/qcom/iris/iris_vpu_common.c
+++ b/drivers/media/platform/qcom/iris/iris_vpu_common.c
@@ -238,13 +238,27 @@ void iris_vpu_power_off_hw(struct iris_core *core)
 	iris_disable_unprepare_clock(core, IRIS_HW_CLK);
 }
 
-void iris_vpu_power_off(struct iris_core *core)
+bool iris_vpu_power_resources_held(struct iris_core *core)
+{
+	struct iris_core_power *power = &core->power;
+
+	return core->iris_platform_data->vpu_ops->power_off_checked &&
+		(power->clock_mask || power->domain_mask || power->icc_voted ||
+		 power->opp_voted || power->controller_started || power->hardware_started ||
+		 power->controller_quiesced || power->hardware_quiesced);
+}
+
+int iris_vpu_power_off(struct iris_core *core)
 {
 	iris_hfi_irq_disable(core);
+	if (core->iris_platform_data->vpu_ops->power_off_checked)
+		return core->iris_platform_data->vpu_ops->power_off_checked(core);
 	iris_opp_set_rate(core->dev, 0);
