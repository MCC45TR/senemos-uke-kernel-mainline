@@ -6,6 +6,7 @@
 
 #include <linux/iopoll.h>
 #include <linux/pm_domain.h>
+#include <linux/pm_opp.h>
 #include <linux/reset.h>
 
 #include "iris_instance.h"
@@ -191,22 +192,43 @@ static int iris_vpu33_2p_quiesce(struct iris_core *core)
 	return 0;
 }
 
-static void iris_vpu33_2p_power_off_hardware(struct iris_core *core)
+static int iris_vpu33_2p_power_off_hardware(struct iris_core *core)
 {
+	struct iris_core_power *power = &core->power;
+	bool collapsed;
 	int ret;
 
-	if (iris_vpu3x_hw_power_collapsed(core))
-		goto disable_power;
-
-	ret = dev_pm_genpd_set_hwmode(core->pmdomain_tbl->pd_devs[IRIS_HW_POWER_DOMAIN], false);
-	if (!ret)
-		ret = iris_vpu33_2p_quiesce(core);
+	if (!power->hardware_quiesced) {
+		if (power->hardware_started) {
+			collapsed = iris_vpu3x_hw_power_collapsed(core);
+			ret = dev_pm_genpd_set_hwmode(core->pmdomain_tbl->pd_devs
+						    [IRIS_HW_POWER_DOMAIN], false);
