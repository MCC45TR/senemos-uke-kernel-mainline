From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] media: iris: check native power-off and resource ownership

Add a checked power-off operation only for the inactive SM7675 two-pipe
candidate. Check hardware quiescence, controller polls/resets and domain
release before dropping remaining votes. Record partial release so a retry
does not access registers after clock removal or put a domain twice.
Restore the consumed domain reference after a failed runtime-PM put.

Keep native clock/domain request ownership separate from legacy reference
semantics: VPU35 legitimately enables its shared AXI clock twice. Treat
partial ICC/OPP requests conservatively. Disable the native OPP table after
both subblocks stop; a recommended frequency of zero selects the lowest
OPP and is not a vote release. Preserve the original failure during unwind.

Retain queues on uncertain native power cleanup. Mark partial suspend fatal
instead of returning a retry code that promises an operational device.
Recovery must acquire a fresh runtime-PM reference before firmware reload;
it must not clear framework fatal state or restart after a failed PM get.

Uke OEM Venus and OnePlus Iris33 are framework/IP comparisons. No donor
board resources, active match, boot profile or firmware payload is added.
Provider recovery, complete file/DMA-BUF removal and physical quiescence
remain separate activation gates.

Link: https://github.com/MiCode/Xiaomi_Kernel_OpenSource/tree/5712080a4b0c0b1a879e6d145c601c649ddaddfd
Link: https://github.com/OnePlusOSS/android_kernel_modules_and_devicetree_oneplus_sm7675/tree/1138e00fee63582a0cc6a53af3286621786827b7
Link: https://github.com/torvalds/linux/tree/72a16bcff25e9f4a1d6d42a243301b1b76db2f32
Link: https://docs.kernel.org/power/runtime_pm.html
Signed-off-by: MCC45TR <75160848+MCC45TR@users.noreply.github.com>

diff --git a/drivers/media/platform/qcom/iris/iris_core.c b/drivers/media/platform/qcom/iris/iris_core.c
index 1b2ecb4..6d4a693 100644
--- a/drivers/media/platform/qcom/iris/iris_core.c
+++ b/drivers/media/platform/qcom/iris/iris_core.c
@@ -75,8 +75,13 @@ int iris_core_deinit(struct iris_core *core)
 			goto unlock;
 		}
 
-		if (pm_ret >= 0)
-			iris_vpu_power_off(core);
+		if (pm_ret >= 0 || iris_vpu_power_resources_held(core)) {
+			ret = iris_vpu_power_off(core);
+			if (ret) {
+				core->state = IRIS_CORE_ERROR;
+				goto unlock;
+			}
+		}
 
 		iris_hfi_queues_deinit(core);
 		core->state = IRIS_CORE_DEINIT;
@@ -93,6 +98,9 @@ unlock:
 
 	mutex_unlock(&core->lifecycle_lock);
 
+	if (!ret && pm_ret < 0)
+		ret = pm_ret;
+
 	return ret;
 }
 
@@ -126,7 +134,7 @@ static int iris_wait_for_system_response(struct iris_core *core)
 
 int iris_core_init(struct iris_core *core)
 {
-	int ret;
+	int ret, cleanup_ret;
 
 	mutex_lock(&core->lifecycle_lock);
 	mutex_lock(&core->lock);
@@ -152,8 +160,13 @@ int iris_core_init(struct iris_core *core)
 		goto error;
 
 	ret = iris_vpu_power_on(core);
-	if (ret)
+	if (ret) {
+		if (iris_vpu_power_resources_held(core)) {
+			core->state = IRIS_CORE_ERROR;
+			goto exit;
+		}
 		goto error_queue_deinit;
+	}
 
 	ret = iris_fw_load(core);
 	if (ret)
@@ -191,7 +204,13 @@ error_power_off_drained:
 		core->state = IRIS_CORE_ERROR;
 		goto exit;
 	}
-	iris_vpu_power_off(core);
+	cleanup_ret = iris_vpu_power_off(core);
+	if (cleanup_ret) {
+		core->state = IRIS_CORE_ERROR;
+		dev_err(core->dev, "power cleanup failed: %d (original error %d)\n",
+			cleanup_ret, ret);
+		goto exit;
+	}
 error_queue_deinit:
 	iris_hfi_queues_deinit(core);
 error:
diff --git a/drivers/media/platform/qcom/iris/iris_hfi_common.c b/drivers/media/platform/qcom/iris/iris_hfi_common.c
index 3e7c824..3f851e9 100644
--- a/drivers/media/platform/qcom/iris/iris_hfi_common.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_common.c
@@ -150,10 +150,21 @@ int iris_hfi_pm_suspend(struct iris_core *core)
 	ret = iris_set_hw_state(core, false);
 	if (ret) {
 		core->state = IRIS_CORE_ERROR;
+		if (ret == -EBUSY || ret == -EAGAIN) {
+			dev_err(core->dev, "uncertain remote suspend: %d\n", ret);
+			ret = -EIO;
+		}
 		goto error;
 	}
 
-	iris_vpu_power_off(core);
+	ret = iris_vpu_power_off(core);
+	if (ret) {
+		core->state = IRIS_CORE_ERROR;
+		dev_err(core->dev, "partial power-off failed: %d\n", ret);
+		if (ret == -EBUSY || ret == -EAGAIN)
+			ret = -EIO;
+		goto error;
+	}
 
 	return 0;
 
@@ -169,8 +180,10 @@ int iris_hfi_pm_resume(struct iris_core *core)
 	int ret, suspend_ret;
 
 	ret = iris_vpu_power_on(core);
-	if (ret)
+	if (ret) {
+		core->state = IRIS_CORE_ERROR;
 		goto error;
+	}
 
 	ret = iris_set_hw_state(core, true);
 	if (ret)
@@ -198,7 +211,12 @@ err_suspend_hw:
 			suspend_ret, ret);
 		goto error;
 	}
-	iris_vpu_power_off(core);
+	suspend_ret = iris_vpu_power_off(core);
+	if (suspend_ret) {
+		core->state = IRIS_CORE_ERROR;
+		dev_err(core->dev, "power rollback failed: %d (original error %d)\n",
+			suspend_ret, ret);
+	}
 error:
 	dev_err(core->dev, "failed to resume\n");
 
