diff --git a/drivers/media/platform/qcom/iris/iris_probe.c b/drivers/media/platform/qcom/iris/iris_probe.c
index e6744d7..3dfaf24 100644
--- a/drivers/media/platform/qcom/iris/iris_probe.c
+++ b/drivers/media/platform/qcom/iris/iris_probe.c
@@ -260,9 +260,15 @@ static void iris_sys_error_handler(struct work_struct *work)
 {
 	struct iris_core *core =
 			container_of(work, struct iris_core, sys_error_handler.work);
+	int ret;
 
-	if (!READ_ONCE(core->removing) && !iris_core_deinit(core))
-		iris_core_init(core);
+	if (READ_ONCE(core->removing) || iris_core_deinit(core))
+		return;
+	ret = pm_runtime_resume_and_get(core->dev);
+	if (ret < 0)
+		return;
+	iris_core_init(core);
+	pm_runtime_put_autosuspend(core->dev);
 }
 
 static int iris_probe(struct platform_device *pdev)
diff --git a/drivers/media/platform/qcom/iris/iris_resources.c b/drivers/media/platform/qcom/iris/iris_resources.c
index 1281ec8..a75708d 100644
--- a/drivers/media/platform/qcom/iris/iris_resources.c
+++ b/drivers/media/platform/qcom/iris/iris_resources.c
@@ -3,6 +3,7 @@
  * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/bitops.h>
 #include <linux/clk.h>
 #include <linux/devfreq.h>
 #include <linux/interconnect.h>
@@ -13,6 +14,7 @@
 
 #include "iris_core.h"
 #include "iris_resources.h"
+#include "iris_vpu_common.h"
 
 #define BW_THRESHOLD 50000
 
@@ -73,15 +75,45 @@ int iris_opp_set_rate(struct device *dev, unsigned long freq)
 	return dev_pm_opp_set_opp(dev, opp);
 }
 
+static int iris_owned_domain_id(struct iris_core *core, struct device *pd_dev)
+{
+	u32 i;
+
+	if (!core->pmdomain_tbl || core->pmdomain_tbl->num_pds > BITS_PER_LONG)
+		return -EINVAL;
+	for (i = 0; i < core->pmdomain_tbl->num_pds; i++)
+		if (core->pmdomain_tbl->pd_devs[i] == pd_dev)
+			return i;
+
+	return -EINVAL;
+}
+
 int iris_enable_power_domains(struct iris_core *core, struct device *pd_dev)
 {
-	int ret;
+	bool tracked = core->iris_platform_data->vpu_ops->power_off_checked;
+	int ret, id = 0;
+
+	if (tracked) {
+		id = iris_owned_domain_id(core, pd_dev);
+		if (id < 0)
+			return id;
+		if (core->power.domain_mask & BIT(id))
+			return 0;
+		if (core->power.opp_voted)
+			goto get_domain;
+		core->power.opp_voted = true;
+	}
 
 	ret = iris_opp_set_rate(core->dev, ULONG_MAX);
 	if (ret)
 		return ret;
 
-	return pm_runtime_resume_and_get(pd_dev);
+get_domain:
+	ret = pm_runtime_resume_and_get(pd_dev);
+	if (tracked && ret >= 0)
+		core->power.domain_mask |= BIT(id);
+
+	return ret < 0 ? ret : 0;
 }
 
 int iris_disable_power_domains(struct iris_core *core, struct device *pd_dev)
@@ -89,6 +121,23 @@ int iris_disable_power_domains(struct iris_core *core, struct device *pd_dev)
 	int ret;
 	int pm_ret;
 
+	if (core->iris_platform_data->vpu_ops->power_off_checked) {
+		int id = iris_owned_domain_id(core, pd_dev);
+
+		if (id < 0)
+			return id;
+		if (!(core->power.domain_mask & BIT(id)))
+			return 0;
+		ret = pm_runtime_put_sync(pd_dev);
+		if (ret < 0) {
+			/* put_sync consumes the reference even when suspend fails. */
+			pm_runtime_get_noresume(pd_dev);
+			return ret;
+		}
+		core->power.domain_mask &= ~BIT(id);
+		return 0;
+	}
+
 	ret = iris_opp_set_rate(core->dev, 0);
 
 	pm_ret = pm_runtime_put_sync(pd_dev);
@@ -121,23 +170,46 @@ static struct clk *iris_get_clk_by_type(struct iris_core *core, enum platform_cl
 int iris_prepare_enable_clock(struct iris_core *core, enum platform_clk_type clk_type)
 {
 	struct clk *clock;
+	bool tracked = core->iris_platform_data->vpu_ops->power_off_checked;
+	int ret;
+
+	if (tracked) {
+		if ((unsigned int)clk_type >= BITS_PER_LONG)
+			return -EINVAL;
+		if (core->power.clock_mask & BIT(clk_type))
+			return 0;
+	}
 
 	clock = iris_get_clk_by_type(core, clk_type);
 	if (!clock)
 		return -ENOENT;
 
-	return clk_prepare_enable(clock);
+	ret = clk_prepare_enable(clock);
+	if (!ret && tracked)
+		core->power.clock_mask |= BIT(clk_type);
+
+	return ret;
 }
 
 int iris_disable_unprepare_clock(struct iris_core *core, enum platform_clk_type clk_type)
 {
 	struct clk *clock;
+	bool tracked = core->iris_platform_data->vpu_ops->power_off_checked;
+
+	if (tracked) {
+		if ((unsigned int)clk_type >= BITS_PER_LONG)
+			return -EINVAL;
+		if (!(core->power.clock_mask & BIT(clk_type)))
+			return 0;
+	}
 
 	clock = iris_get_clk_by_type(core, clk_type);
 	if (!clock)
 		return -EINVAL;
 
 	clk_disable_unprepare(clock);
+	if (tracked)
+		core->power.clock_mask &= ~BIT(clk_type);
 
 	return 0;
 }
diff --git a/drivers/media/platform/qcom/iris/iris_vpu3x.c b/drivers/media/platform/qcom/iris/iris_vpu3x.c
index 02c3950..f81b6be 100644
