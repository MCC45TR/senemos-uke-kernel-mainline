From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] media: iris: add SM7675 P010 input and sizing

SM7675 exposes only eight-bit encoder inputs and sizes its internal
buffers for eight-bit data. Add P010 and reuse the ten-bit allocation
helpers. Validate profile/format pairs before stream properties and
refuse layout changes while either queue has buffers. Report a checked
TRY_FMT layout, preserve visible raw dimensions and refresh the coded
buffer requirement after a bit-depth change.

OnePlus SM7675 modules 1138e00fee63582a0cc6a53af3286621786827b7 provides
the Cliffs P010 mask, Iris33 buffer bit-depth selection and 25 percent
bitstream headroom. The Uke Cliffs XML provides the Main10 source profile.
HFI linear stride is in pixels; V4L2 bytesperline is in bytes. The
encoder color format and HEVC profile select its bit depth. The decoder
LUMA_CHROMA_BIT_DEPTH startup property is unchanged.

This is source implementation, not PAS/HFI or physical encode acceptance.
VA Main10, metadata, extended controls and target validation remain.

diff --git a/drivers/media/platform/qcom/iris/iris_buffer.c b/drivers/media/platform/qcom/iris/iris_buffer.c
index 3e78be7..5c838cf 100644
--- a/drivers/media/platform/qcom/iris/iris_buffer.c
+++ b/drivers/media/platform/qcom/iris/iris_buffer.c
@@ -120,15 +120,9 @@ static u32 iris_yuv_buffer_size_nv12(struct iris_inst *inst)
  *
  * Note: All the alignments are hardware requirements.
  */
-static u32 iris_yuv_buffer_size_p010(struct iris_inst *inst)
+u32 iris_yuv_buffer_size_p010(const struct v4l2_format *f)
 {
 	u32 y_plane, uv_plane, y_stride, uv_stride, y_scanlines, uv_scanlines;
-	struct v4l2_format *f;
-
-	if (inst->domain == DECODER)
-		f = inst->fmt_dst;
-	else
-		f = inst->fmt_src;
 
 	y_stride = ALIGN(f->fmt.pix_mp.width * 2, Y_STRIDE_ALIGN_P010);
 	uv_stride = ALIGN(f->fmt.pix_mp.width * 2, UV_STRIDE_ALIGN_P010);
@@ -441,6 +435,9 @@ static u32 iris_enc_bitstream_buffer_size(struct iris_inst *inst)
 	    bitstream_size < yuv_size)
 		bitstream_size = (bitstream_size << 1);
 
+	if (iris_fmt_is_10bit(inst->fmt_src->fmt.pix_mp.pixelformat))
+		bitstream_size += bitstream_size >> 2;
+
 	return ALIGN(bitstream_size, 4096);
 }
 
@@ -457,7 +454,7 @@ int iris_get_buffer_size(struct iris_inst *inst,
 			else if (inst->fmt_dst->fmt.pix_mp.pixelformat == V4L2_PIX_FMT_QC10C)
 				return iris_yuv_buffer_size_qc10c(inst);
 			else if (inst->fmt_dst->fmt.pix_mp.pixelformat == V4L2_PIX_FMT_P010)
-				return iris_yuv_buffer_size_p010(inst);
+				return iris_yuv_buffer_size_p010(inst->fmt_dst);
 			else
 				return iris_yuv_buffer_size_nv12(inst);
 		case BUF_DPB:
@@ -473,6 +470,8 @@ int iris_get_buffer_size(struct iris_inst *inst,
 		case BUF_INPUT:
 			if (inst->fmt_src->fmt.pix_mp.pixelformat == V4L2_PIX_FMT_QC08C)
 				return iris_yuv_buffer_size_qc08c(inst);
+			else if (inst->fmt_src->fmt.pix_mp.pixelformat == V4L2_PIX_FMT_P010)
+				return iris_yuv_buffer_size_p010(inst->fmt_src);
 			else
 				return iris_yuv_buffer_size_nv12(inst);
 		case BUF_OUTPUT:
