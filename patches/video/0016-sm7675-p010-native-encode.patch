@@ -1637,6 +1639,7 @@ static inline u32 hfi_buffer_scratch1_enc(u32 frame_width, u32 frame_height,
 
 static u32 iris_vpu_enc_scratch1_size(struct iris_inst *inst)
 {
+	bool ten_bit = iris_fmt_is_10bit(inst->fmt_src->fmt.pix_mp.pixelformat);
