-					BIT(V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_STILL_PICTURE);
-	caps[PROFILE_HEVC].value = min(caps[PROFILE_HEVC].value, caps[PROFILE_HEVC].max);
