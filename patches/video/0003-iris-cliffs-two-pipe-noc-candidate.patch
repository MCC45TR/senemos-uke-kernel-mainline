diff --git a/drivers/media/platform/qcom/iris/iris_vpu33_2p.h b/drivers/media/platform/qcom/iris/iris_vpu33_2p.h
new file mode 100644
index 0000000..647f852
--- /dev/null
+++ b/drivers/media/platform/qcom/iris/iris_vpu33_2p.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc. */
+#ifndef __IRIS_VPU33_2P_H__
+#define __IRIS_VPU33_2P_H__
+
+#include <linux/io.h>
+
+#define IRIS33_2P_NOC_MAINCTL	0x13508
+#define IRIS33_2P_NOC_ERRCLR	0x13518
+#define IRIS33_2P_NOC_FAULTINEN	0x13240
+#define IRIS33_2P_NOC_SENSE0_LO	0x13300
+#define IRIS33_2P_NOC_SENSE0_HI	0x13304
+#define IRIS33_2P_NOC_SENSE1_HI	0x1330c
+#define IRIS33_2P_NOC_SENSE2_LO	0x13310
+#define IRIS33_2P_DMA_SPARE3	0x087b8
+
+/* Caller holds the XO reset and has enabled controller/hardware clocks. */
+static inline void iris_vpu33_2p_noc_init(u8 __iomem *base)
+{
+	writel(1, base + IRIS33_2P_NOC_ERRCLR);
+	writel(3, base + IRIS33_2P_NOC_MAINCTL);
+	writel(1, base + IRIS33_2P_NOC_FAULTINEN);
+}
+
+static inline void iris_vpu33_2p_write_presets(u8 __iomem *base)
+{
+	u32 value = readl(base + 0xb0088);
+
+	writel(value & ~0x11, base + 0xb0088);
+	writel(0x33332222, base + 0x10830);
+	writel(0x44444444, base + 0x10834);
+	writel(0x00001022, base + 0x10838);
+	writel(0x99, base + 0xa013c);
+	iris_vpu33_2p_noc_init(base);
+}
+
+static inline u32 iris_vpu33_2p_noc_busy(u8 __iomem *base)
+{
+	u32 busy;
+
+	busy = readl(base + IRIS33_2P_NOC_SENSE0_LO) & 0x00008000;
+	busy |= readl(base + IRIS33_2P_NOC_SENSE0_HI) & 0x00000800;
+	busy |= readl(base + IRIS33_2P_NOC_SENSE1_HI) & 0x00800000;
+	busy |= readl(base + IRIS33_2P_NOC_SENSE2_LO) & 0x00002000;
+
+	return busy;
+}
+
+#endif
diff --git a/drivers/media/platform/qcom/iris/iris_vpu3x.c b/drivers/media/platform/qcom/iris/iris_vpu3x.c
index 3dad47b..02c3950 100644
--- a/drivers/media/platform/qcom/iris/iris_vpu3x.c
