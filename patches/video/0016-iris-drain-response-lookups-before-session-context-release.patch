--- a/drivers/media/platform/qcom/iris/iris_vidc.c
+++ b/drivers/media/platform/qcom/iris/iris_vidc.c
@@ -87,6 +87,9 @@
 	struct iris_core *core = inst->core;
 	struct iris_inst *iter, *temp;
 
+	/* A response may already hold a pointer while waiting for inst->lock. */
+	lockdep_assert_not_held(&inst->lock);
+	mutex_lock(&core->response_lock);
 	mutex_lock(&core->lock);
 	list_for_each_entry_safe(iter, temp, &core->instances, list) {
 		if (iter->session_id == inst->session_id) {
@@ -95,6 +98,7 @@
 		}
 	}
 	mutex_unlock(&core->lock);
+	mutex_unlock(&core->response_lock);
 }
 
 static inline struct iris_inst *iris_get_inst(struct file *filp)
@@ -328,19 +332,32 @@
 int iris_close(struct file *filp)
 {
 	struct iris_inst *inst = iris_get_inst(filp);
+	int ret, err;
 
+	/* Preserve the framework's capture/output stop order without freeing queues. */
+	ret = v4l2_m2m_streamoff(filp, inst->m2m_ctx, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
+	err = v4l2_m2m_streamoff(filp, inst->m2m_ctx, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
+	if (!ret)
+		ret = err;
+	if (ret)
+		dev_err(inst->core->dev, "queue stop failed at close: %d\n", ret);
+
+	mutex_lock(&inst->lock);
+	iris_session_close(inst);
+	iris_inst_change_state(inst, IRIS_INST_DEINIT);
+	mutex_unlock(&inst->lock);
+
+	/* Drain old lookup users and detach before freeing their CPU context. */
+	iris_remove_session(inst);
 	v4l2_ctrl_handler_free(&inst->ctrl_handler);
 	v4l2_m2m_ctx_release(inst->m2m_ctx);
 	v4l2_m2m_release(inst->m2m_dev);
 	mutex_lock(&inst->lock);
-	iris_session_close(inst);
-	iris_inst_change_state(inst, IRIS_INST_DEINIT);
 	iris_v4l2_fh_deinit(inst, filp);
 	iris_destroy_all_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
 	iris_destroy_all_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
 	iris_check_num_queued_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_OUTPUT_MPLANE);
 	iris_check_num_queued_internal_buffers(inst, V4L2_BUF_TYPE_VIDEO_CAPTURE_MPLANE);
-	iris_remove_session(inst);
 	mutex_unlock(&inst->lock);
 	mutex_destroy(&inst->ctx_q_lock);
 	mutex_destroy(&inst->lock);
@@ -348,7 +365,7 @@
 	kfree(inst->fmt_dst);
 	kfree(inst);
 
-	return 0;
+	return ret;
 }
 
 static int iris_enum_fmt(struct file *filp, void *fh, struct v4l2_fmtdesc *f)
