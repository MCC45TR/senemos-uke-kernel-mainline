--- a/drivers/media/platform/qcom/iris/iris_core.h
+++ b/drivers/media/platform/qcom/iris/iris_core.h
@@ -45,6 +45,7 @@
  * @irq: iris irq
  * @irq_enabled: balanced driver ownership of the IRQ enable depth
  * @lifecycle_lock: serialize initialization and deinitialization across IRQ drains
+ * @response_lock: keep response lookups alive until their packet handler returns
  * @v4l2_dev: a holder for v4l2 device structure
  * @vdev_dec: iris video device structure for decoder
  * @vdev_enc: iris video device structure for encoder
@@ -129,6 +130,7 @@
 	struct iris_iface_q_info		debug_queue;
 	struct mutex				lock; /* lock for core related operations */
 	struct mutex				lifecycle_lock;
+	struct mutex				response_lock; /* guards HFI instance pointers */
 	u8					*response_packet;
 	u32					header_id;
 	u32					packet_id;
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen1_response.c
@@ -580,7 +580,7 @@
 	},
 };
 
-static void iris_hfi_gen1_handle_response(struct iris_core *core, void *response)
+static void iris_hfi_gen1_handle_response_locked(struct iris_core *core, void *response)
 {
 	struct hfi_pkt_hdr *hdr = (struct hfi_pkt_hdr *)response;
 	const struct iris_hfi_gen1_response_pkt_info *pkt_info;
@@ -659,6 +659,13 @@
 	}
 }
 
+static void iris_hfi_gen1_handle_response(struct iris_core *core, void *response)
+{
+	mutex_lock(&core->response_lock);
+	iris_hfi_gen1_handle_response_locked(core, response);
+	mutex_unlock(&core->response_lock);
+}
+
 static void iris_hfi_gen1_flush_debug_queue(struct iris_core *core, u8 *packet)
 {
 	struct hfi_msg_sys_coverage_pkt *pkt;
--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
@@ -891,8 +891,8 @@
 		subsc_params->coded_frames = 0;
 }
 
-static int iris_hfi_gen2_handle_session_response(struct iris_core *core,
-						 struct iris_hfi_header *hdr)
+static int iris_hfi_gen2_handle_session_response_locked(struct iris_core *core,
+							struct iris_hfi_header *hdr)
 {
 	u8 *pkt = (u8 *)((u8 *)hdr + sizeof(*hdr));
 	struct iris_inst_hfi_gen2 *inst_hfi_gen2;
@@ -956,6 +956,18 @@
 
 	return ret;
 }
+
+static int iris_hfi_gen2_handle_session_response(struct iris_core *core,
+						 struct iris_hfi_header *hdr)
+{
+	int ret;
+
+	mutex_lock(&core->response_lock);
+	ret = iris_hfi_gen2_handle_session_response_locked(core, hdr);
+	mutex_unlock(&core->response_lock);
+
+	return ret;
+}
 
 static int iris_hfi_gen2_handle_response(struct iris_core *core, void *response)
 {
--- a/drivers/media/platform/qcom/iris/iris_probe.c
+++ b/drivers/media/platform/qcom/iris/iris_probe.c
@@ -161,6 +161,7 @@
 
 	mutex_destroy(&core->lock);
 	mutex_destroy(&core->lifecycle_lock);
