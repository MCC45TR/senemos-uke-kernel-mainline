+#define _DT_BINDINGS_CLK_QCOM_VIDEO_CC_SM7675_H
+
+#include "qcom,sm8650-videocc.h"
+
+/* Additional Cliffs VCODEC clock reset; not the OEM numeric reset ABI. */
+#define VIDEO_CC_MVS0_CLK_ARES					8
+
+#endif
