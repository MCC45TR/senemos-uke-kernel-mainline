diff --git a/drivers/media/platform/qcom/iris/iris_dma.c b/drivers/media/platform/qcom/iris/iris_dma.c
new file mode 100644
index 0000000..8a22d54
--- /dev/null
+++ b/drivers/media/platform/qcom/iris/iris_dma.c
@@ -0,0 +1,192 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/component.h>
+#include <linux/dma-mapping.h>
+#include <linux/iommu.h>
+#include <linux/module.h>
+#include <linux/of_platform.h>
+
+#include "iris_core.h"
+#include "iris_dma.h"
+#include "iris_instance.h"
+
+static bool iris_dma_domain_valid(struct iommu_domain *domain)
+{
+	return domain && (domain->type == IOMMU_DOMAIN_DMA || domain->type == IOMMU_DOMAIN_DMA_FQ);
+}
+
+struct device *iris_buffer_dma_device(struct iris_inst *inst, enum iris_buffer_type type)
+{
+	struct iris_core *core = inst->core;
+	bool pixel;
+
+	if (!core->iris_platform_data->split_dma)
+		return core->dev;
+	if (!core->pixel_dev)
+		return ERR_PTR(-ENODEV);
+	if (inst->domain != DECODER && inst->domain != ENCODER)
+		return ERR_PTR(-EINVAL);
+	switch (type) {
+	case BUF_INPUT:
+		pixel = inst->domain == ENCODER;
+		break;
+	case BUF_OUTPUT:
+		pixel = inst->domain == DECODER;
+		break;
+	case BUF_DPB:
+	case BUF_VPSS:
+	case BUF_PARTIAL:
+		pixel = true;
+		break;
+	case BUF_ARP:
+	case BUF_BIN:
+	case BUF_COMV:
+	case BUF_NON_COMV:
+	case BUF_LINE:
+	case BUF_PERSIST:
+		pixel = false;
+		break;
+	default:
+		return ERR_PTR(-EINVAL);
+	}
+
+	return pixel ? core->pixel_dev : core->dev;
+}
+
+static int iris_pixel_bind(struct device *dev, struct device *master, void *data)
+{
+	struct iris_core *core = data;
+	struct iommu_domain *pixel = iommu_get_domain_for_dev(dev);
+	struct iommu_domain *control = iommu_get_domain_for_dev(master);
+
+	if (!iris_dma_domain_valid(pixel) || !iris_dma_domain_valid(control) || pixel == control)
+		return -EINVAL;
+	core->pixel_dev = dev;
+
+	return 0;
+}
+
+static void iris_pixel_unbind(struct device *dev, struct device *master, void *data)
+{
+	struct iris_core *core = data;
+
+	core->pixel_dev = NULL;
+}
+
+static const struct component_ops iris_pixel_ops = {
+	.bind = iris_pixel_bind,
+	.unbind = iris_pixel_unbind,
+};
+
+static int iris_pixel_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct iris_core *core;
+	int ret;
+
+	if (!dev->parent || !of_device_is_compatible(dev->parent->of_node, "qcom,sm7675-iris"))
+		return -EINVAL;
+	core = dev_get_drvdata(dev->parent);
+	if (!core)
+		return -EPROBE_DEFER;
+	if (!iris_dma_domain_valid(iommu_get_domain_for_dev(dev)))
+		return -ENODEV;
+	ret = dma_set_mask_and_coherent(dev, core->iris_platform_data->dma_mask);
+	if (ret)
+		return ret;
+	dma_set_max_seg_size(dev, DMA_BIT_MASK(32));
+	dma_set_seg_boundary(dev, DMA_BIT_MASK(32));
+
+	return component_add(dev, &iris_pixel_ops);
+}
+
+static void iris_pixel_remove(struct platform_device *pdev)
+{
+	component_del(&pdev->dev, &iris_pixel_ops);
+}
+
+static int iris_pixel_master_bind(struct device *dev)
+{
+	struct iris_core *core = dev_get_drvdata(dev);
+	int ret;
+
+	ret = component_bind_all(dev, core);
+	if (ret)
+		return ret;
+	ret = iris_register_video_devices(core);
+	if (ret)
+		component_unbind_all(dev, core);
+
+	return ret;
+}
+
+static void iris_pixel_master_unbind(struct device *dev)
+{
+	struct iris_core *core = dev_get_drvdata(dev);
+
+	/* shortcut: open-session removal is unsafe; keep the native match disabled. */
+	iris_unregister_video_devices(core);
+	component_unbind_all(dev, core);
+}
+
+static const struct component_master_ops iris_pixel_master_ops = {
+	.bind = iris_pixel_master_bind,
+	.unbind = iris_pixel_master_unbind,
+};
+
+static void iris_pixel_destroy(void *data)
+{
+	struct platform_device *pdev = data;
+
+	of_platform_device_destroy(&pdev->dev, NULL);
+}
+
+int iris_pixel_master_add(struct iris_core *core)
+{
+	struct component_match *match = NULL;
+	struct platform_device *pdev;
+	struct device_node *node;
+	int ret;
+
+	node = of_get_child_by_name(core->dev->of_node, "pixel");
+	if (!node)
+		return -EINVAL;
+	if (!of_device_is_available(node) ||
+	    !of_device_is_compatible(node, "qcom,sm7675-iris-pixel")) {
+		of_node_put(node);
+		return -EINVAL;
+	}
+	component_match_add_release(core->dev, &match, component_release_of,
+				    component_compare_of, node);
+	if (IS_ERR(match)) {
+		of_node_put(node);
+		return PTR_ERR(match);
+	}
+	pdev = of_platform_device_create(node, NULL, core->dev);
+	if (!pdev)
+		return -ENOMEM;
+	ret = devm_add_action_or_reset(core->dev, iris_pixel_destroy, pdev);
+	if (ret)
+		return ret;
+
+	return component_master_add_with_match(core->dev, &iris_pixel_master_ops, match);
+}
+
+void iris_pixel_master_del(struct iris_core *core)
+{
+	component_master_del(core->dev, &iris_pixel_master_ops);
+}
+
+static const struct of_device_id iris_pixel_match[] = {
+	{ .compatible = "qcom,sm7675-iris-pixel" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, iris_pixel_match);
+
+struct platform_driver iris_pixel_driver = {
+	.probe = iris_pixel_probe,
+	.remove = iris_pixel_remove,
+	.driver = {
+		.name = "qcom-iris-pixel",
+		.of_match_table = iris_pixel_match,
+	},
+};
