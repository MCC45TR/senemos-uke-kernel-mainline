 		ret = iris_hfi_gen2_set_num_comv(inst);
 		if (ret)
@@ -1340,8 +1354,11 @@ static int iris_hfi_gen2_session_release_buffer(struct iris_inst *inst, struct i
 	struct iris_inst_hfi_gen2 *inst_hfi_gen2 = to_iris_inst_hfi_gen2(inst);
