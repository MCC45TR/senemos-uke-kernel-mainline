Subject: [PATCH] media: iris: recycle empty VP9 non-display capture buffers

A valid VP9 hidden reference produces PICTURE_P|NOSHOW and an empty raw
completion without data-corrupt or overflow information on Cliffs. Returning
it as ERROR aborts strict native clients before the following display frame.

Recycle that unused linear capture buffer through the existing queue helper
in default display-order decoding. Retain errors, LAST/PSC handling and the
original behavior for decode-order clients, pending release, firmware-held
buffers, encoders and other codecs/formats. No frame is exposed for NOSHOW.

Base: Linux 7.3.0 with the accepted Uke kernel19 video patches.
License: GPL-2.0-only, matching iris_hfi_gen2_response.c.

--- a/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
+++ b/drivers/media/platform/qcom/iris/iris_hfi_gen2_response.c
@@ -348,6 +348,8 @@
 static int iris_hfi_gen2_handle_output_buffer(struct iris_inst *inst,
 					      struct iris_hfi_buffer *hfi_buffer)
 {
+	const struct iris_hfi_frame_info *frame =
+		&to_iris_inst_hfi_gen2(inst)->hfi_frame_info;
 	struct v4l2_m2m_ctx *m2m_ctx = inst->m2m_ctx;
 	struct v4l2_m2m_buffer *m2m_buffer, *n;
 	struct iris_buffer *buf;
@@ -381,6 +383,23 @@
 	if (!(buf->attr & BUF_ATTR_QUEUED))
 		return -EINVAL;
 
+	if (inst->domain == DECODER && inst->state == IRIS_INST_STREAMING &&
+	    inst->fmt_src->fmt.pix_mp.pixelformat == V4L2_PIX_FMT_VP9 &&
+	    (inst->fmt_dst->fmt.pix_mp.pixelformat == V4L2_PIX_FMT_NV12 ||
+	     inst->fmt_dst->fmt.pix_mp.pixelformat == V4L2_PIX_FMT_P010) &&
+	    !inst->fw_caps[DISPLAY_DELAY_ENABLE].value &&
+	    (frame->picture_type & HFI_GEN2_PICTURE_NOSHOW) &&
+	    !frame->data_corrupt && !frame->overflow &&
+	    !hfi_buffer->data_size && !hfi_buffer->data_offset &&
+	    !(buf->attr & BUF_ATTR_PENDING_RELEASE) &&
+	    !(hfi_buffer->flags & (HFI_BUF_FW_FLAG_READONLY |
+				   HFI_BUF_FW_FLAG_LAST | HFI_BUF_FW_FLAG_PSC_LAST))) {
+		/* The unused linear buffer remains owned by the capture queue. */
+		buf->data_offset = 0;
+		buf->data_size = 0;
+		return iris_queue_buffer(inst, buf);
+	}
+
 	buf->data_offset = hfi_buffer->data_offset;
 	buf->data_size = hfi_buffer->data_size;
 	buf->timestamp = hfi_buffer->timestamp;
