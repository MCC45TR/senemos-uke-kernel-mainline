diff --git a/drivers/media/platform/qcom/iris/iris_fw_mmap.c b/drivers/media/platform/qcom/iris/iris_fw_mmap.c
new file mode 100644
index 0000000..8d9864a
--- /dev/null
+++ b/drivers/media/platform/qcom/iris/iris_fw_mmap.c
@@ -0,0 +1,225 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/dma-mapping.h>
+#include <linux/iommu.h>
+#include <linux/overflow.h>
+#include <linux/platform_device.h>
+
+#include "iris_core.h"
+#include "iris_fw_mmap.h"
+#include "iris_vpu_register_defines.h"
+
+#define FW_DEVICE_REGION_ADDR (CPU_CS_BASE_OFFS + 0x24)
+#define FW_DEVICE_REGION_SIZE (CPU_CS_BASE_OFFS + 0x28)
+#define FW_QTBL_INFO          (CPU_CS_BASE_OFFS + 0x50)
+#define FW_QTBL_ADDR          (CPU_CS_BASE_OFFS + 0x54)
+#define FW_SFR_ADDR           (CPU_CS_BASE_OFFS + 0x5c)
+#define FW_MMAP_ADDR          (CPU_CS_BASE_OFFS + 0x60)
+#define FW_UC_REGION_ADDR     (CPU_CS_BASE_OFFS + 0x64)
+#define FW_UC_REGION_SIZE     (CPU_CS_BASE_OFFS + 0x68)
+
+static const char * const iris_fw_mmap_names[] = { "aon", "fence", "qtimer" };
+static const u32 iris_fw_mmap_words[] = { 11, 19, 21 };
+
+static u32 iris_fw_shared_size(void)
+{
+	return ALIGN(iris_hfi_queue_size() + SFR_SIZE + SZ_4K, SZ_1M);
+}
+
+static bool iris_fw_dma_range_valid(struct iris_core *core, dma_addr_t addr, size_t size)
+{
+	dma_addr_t last;
+	u64 mask = dma_get_mask(core->dev) & DMA_BIT_MASK(32);
+
+	return addr && size && IS_ALIGNED(addr, SZ_4K) && IS_ALIGNED(size, SZ_4K) &&
+		!check_add_overflow(addr, (dma_addr_t)size - 1, &last) &&
+		!((addr | last) & ~mask);
+}
+
+static int iris_fw_mmap_span(struct iris_core *core, u32 *base, u32 *size)
+{
+	struct iris_fw_mmap *map = &core->fw_mmap;
+	dma_addr_t low = DMA_BIT_MASK(32), high = 0, end, other_end;
+	u32 i, j;
+
+	if (!core->iface_q_table_vaddr || map->shared_size != iris_fw_shared_size() ||
+	    !iris_fw_dma_range_valid(core, core->iface_q_table_daddr, map->shared_size))
+		return -EINVAL;
+
+	for (i = 0; i < IRIS_FW_MMAP_REGIONS; i++) {
+		struct iris_fw_mmap_region *region = &map->regions[i];
+
+		if (region->size != SZ_4K ||
+		    !iris_fw_dma_range_valid(core, region->daddr, region->size))
+			return -ERANGE;
+		end = region->daddr + region->size;
+		other_end = core->iface_q_table_daddr + map->shared_size;
+		if (region->daddr < other_end && core->iface_q_table_daddr < end)
+			return -EINVAL;
+		for (j = 0; j < i; j++) {
+			other_end = map->regions[j].daddr + map->regions[j].size;
+			if (region->daddr < other_end && map->regions[j].daddr < end)
+				return -EINVAL;
+		}
+		low = min(low, region->daddr);
+		high = max(high, end);
+	}
+	/* The firmware exposes one MMIO interval; do not include allocator holes. */
+	if (high - low != IRIS_FW_MMAP_REGIONS * SZ_4K)
+		return -ERANGE;
+	*base = low;
+	*size = high - low;
+
+	return 0;
+}
+
+static __le32 iris_fw_mmap_word(struct iris_core *core, u32 word)
+{
+	u32 i;
+
+	if (!word)
+		return cpu_to_le32(1);
+	for (i = 0; i < IRIS_FW_MMAP_REGIONS; i++) {
+		if (word == iris_fw_mmap_words[i])
+			return cpu_to_le32(core->fw_mmap.regions[i].daddr);
+		if (word == iris_fw_mmap_words[i] + 1)
+			return cpu_to_le32(SZ_4K);
+	}
+	return 0;
+}
+
+static void iris_fw_mmap_fill(struct iris_core *core)
+{
+	u32 offset = iris_hfi_queue_size() + SFR_SIZE;
+	__le32 *payload = (__le32 *)((u8 *)core->iface_q_table_vaddr + offset);
+	u32 i;
+
+	for (i = 0; i < SZ_4K / sizeof(*payload); i++)
+		payload[i] = iris_fw_mmap_word(core, i);
+	dma_wmb();
+}
+
+static bool iris_fw_mmap_payload_valid(struct iris_core *core)
+{
+	u32 offset = iris_hfi_queue_size() + SFR_SIZE;
+	__le32 *payload = (__le32 *)((u8 *)core->iface_q_table_vaddr + offset);
+	u32 i;
+
+	for (i = 0; i < SZ_4K / sizeof(*payload); i++)
+		if (READ_ONCE(payload[i]) != iris_fw_mmap_word(core, i))
+			return false;
+	return true;
+}
+
+void iris_fw_mmap_deinit(struct iris_core *core)
+{
+	struct iris_fw_mmap *map = &core->fw_mmap;
+	u32 i = IRIS_FW_MMAP_REGIONS;
+
+	if (WARN_ON(core->fw_owned) || !map->shared_size)
+		return;
+	while (i--) {
+		if (map->regions[i].size)
+			dma_unmap_resource(core->dev, map->regions[i].daddr,
+					   map->regions[i].size, DMA_BIDIRECTIONAL, 0);
+	}
+	if (core->iface_q_table_vaddr && map->shared_size)
+		dma_free_attrs(core->dev, map->shared_size, core->iface_q_table_vaddr,
+			       core->iface_q_table_daddr, DMA_ATTR_WRITE_COMBINE);
+	memset(map, 0, sizeof(*map));
+	core->iface_q_table_vaddr = NULL;
+	core->iface_q_table_daddr = 0;
+	core->sfr_vaddr = NULL;
+	core->sfr_daddr = 0;
+}
+
+int iris_fw_mmap_init(struct iris_core *core)
+{
+	struct platform_device *pdev = to_platform_device(core->dev);
+	struct resource *resources[IRIS_FW_MMAP_REGIONS];
+	struct iommu_domain *domain;
+	struct iris_fw_mmap *map = &core->fw_mmap;
+	u32 i, j, base, size;
+	dma_addr_t addr;
+	int ret;
+
+	if (core->fw_owned || core->iface_q_table_vaddr || map->shared_size)
+		return -EBUSY;
+	domain = iommu_get_domain_for_dev(core->dev);
+	if (!domain || (domain->type != IOMMU_DOMAIN_DMA && domain->type != IOMMU_DOMAIN_DMA_FQ))
+		return -ENODEV;
+	for (i = 0; i < IRIS_FW_MMAP_REGIONS; i++) {
+		resources[i] = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+							    iris_fw_mmap_names[i]);
+		if (!resources[i] || resources[i]->end < resources[i]->start ||
+		    resource_size(resources[i]) != SZ_4K ||
+		    !IS_ALIGNED(resources[i]->start, SZ_4K))
+			return -EINVAL;
+		for (j = 0; j < i; j++)
+			if (resources[i]->start <= resources[j]->end &&
+			    resources[j]->start <= resources[i]->end)
+				return -EINVAL;
+	}
+	map->shared_size = iris_fw_shared_size();
+	core->iface_q_table_vaddr = dma_alloc_attrs(core->dev, map->shared_size,
+						    &core->iface_q_table_daddr,
+						    GFP_KERNEL, DMA_ATTR_WRITE_COMBINE);
+	if (!core->iface_q_table_vaddr) {
+		map->shared_size = 0;
+		core->iface_q_table_daddr = 0;
+		return -ENOMEM;
+	}
+	if (!iris_fw_dma_range_valid(core, core->iface_q_table_daddr, map->shared_size)) {
+		ret = -ERANGE;
+		goto fail;
+	}
+	memset(core->iface_q_table_vaddr, 0, map->shared_size);
+	core->sfr_vaddr = (u8 *)core->iface_q_table_vaddr + iris_hfi_queue_size();
+	core->sfr_daddr = core->iface_q_table_daddr + iris_hfi_queue_size();
+	for (i = 0; i < IRIS_FW_MMAP_REGIONS; i++) {
+		addr = dma_map_resource(core->dev, resources[i]->start, SZ_4K,
+					DMA_BIDIRECTIONAL, 0);
+		if (dma_mapping_error(core->dev, addr)) {
+			ret = -EIO;
+			goto fail;
+		}
+		map->regions[i].daddr = addr;
+		map->regions[i].size = SZ_4K;
+	}
+	ret = iris_fw_mmap_span(core, &base, &size);
+	if (ret)
+		goto fail;
+	iris_fw_mmap_fill(core);
+
+	return 0;
+fail:
+	iris_fw_mmap_deinit(core);
+	return ret;
+}
+
+int iris_fw_mmap_program(struct iris_core *core)
+{
+	u32 base, size, offset = iris_hfi_queue_size() + SFR_SIZE;
+	int ret;
+
+	if (!core->fw_owned)
+		return -EINVAL;
+	ret = iris_fw_mmap_span(core, &base, &size);
+	if (ret)
+		return ret;
+	if (core->sfr_daddr != core->iface_q_table_daddr + iris_hfi_queue_size() ||
+	    core->sfr_vaddr != (u8 *)core->iface_q_table_vaddr + iris_hfi_queue_size() ||
+	    core->iris_firmware_data->core_arch >= SZ_4K || !iris_fw_mmap_payload_valid(core))
+		return -EINVAL;
+	/* Never rewrite the table while PAS may still own it. */
+	dma_wmb();
+	writel(core->iface_q_table_daddr, core->reg_base + FW_UC_REGION_ADDR);
+	writel(core->fw_mmap.shared_size, core->reg_base + FW_UC_REGION_SIZE);
+	writel(core->iface_q_table_daddr, core->reg_base + FW_QTBL_ADDR);
+	writel(BIT(0), core->reg_base + FW_QTBL_INFO);
+	writel(core->iface_q_table_daddr + offset, core->reg_base + FW_MMAP_ADDR);
+	writel(base, core->reg_base + FW_DEVICE_REGION_ADDR);
+	writel(size, core->reg_base + FW_DEVICE_REGION_SIZE);
+	writel(core->sfr_daddr + core->iris_firmware_data->core_arch, core->reg_base + FW_SFR_ADDR);
+
+	return 0;
+}
