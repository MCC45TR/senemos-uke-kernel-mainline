From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] ASoC: qcom: admit only the Uke DisplayPort DMA frontend

Match the owned HDMI-only frontend and exact OEM audio-ion stream pair before
allocating a normal DMA context. Retain all other SID and ACTLR refusals and
firmware display reservations. Require a real DMA domain before ASoC can
construct or map a frontend PCM. The closed registration profile is unchanged.
Select the existing DP backend, codec and common jack helpers for the Uke card.
No identity DMA, amplifier, regulator or firmware setting is added.

--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
@@ -773,6 +773,24 @@
 	return match;
 }
 
+static bool qcom_uke_hdmi_dma(struct device *dev)
+{
+	struct iommu_fwspec *spec = dev_iommu_fwspec_get(dev);
+	struct device_node *node;
+	bool match;
+
+	if (!of_machine_is_compatible("xiaomi,uke") ||
+	    !of_device_is_compatible(dev->of_node, "qcom,q6apm-dais") ||
+	    !of_property_read_bool(dev->of_node, "xiaomi,hdmi-only") ||
+	    !spec || spec->num_ids != 2)
+		return false;
+	node = of_find_node_by_path("/soc/remoteproc-adsp@03000000/glink-edge/qcom,gpr/service@1/dais");
+	match = node && dev->of_node == node &&
+		spec->ids[0] == 0x801001 && spec->ids[1] == 0x1061;
+	of_node_put(node);
+	return match;
+}
+
 static int qcom_uke_smmu_cfg_probe(struct arm_smmu_device *smmu)
 {
 	const __be32 *handoff;
@@ -855,7 +873,8 @@
 		u32 sid = fwspec->ids[i];
 
 		if (sid != 0x40 && sid != 0xb6 &&
-		    !((qcom_uke_sensor_cb(dev) || sid == 0x60 || sid == 0xa3 || sid == 0x423 ||
+		    !((qcom_uke_sensor_cb(dev) || qcom_uke_hdmi_dma(dev) ||
+		       sid == 0x60 || sid == 0xa3 || sid == 0x423 ||
 		       sid == 0x436 || sid == 0x11400) &&
 		      of_device_is_compatible(smmu->dev->of_node, "qcom,sm7675-boot-smmu")))
 			return dev_err_probe(dev, -EOPNOTSUPP, "outside Uke boot SMMU scope\n");
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -14,6 +14,7 @@
 #include <asm/div64.h>
 #include <asm/dma.h>
 #include <linux/dma-mapping.h>
+#include <linux/iommu.h>
 #include <sound/pcm_params.h>
 #include "q6apm.h"
 
@@ -1037,6 +1038,20 @@
 	.remove_order   = SND_SOC_COMP_ORDER_EARLY,
 };
 
+static int q6apm_hdmi_dma_ready(struct device *dev)
+{
+	struct iommu_domain *domain;
+
+	if (!of_property_read_bool(dev->of_node, "xiaomi,hdmi-only"))
+		return 0;
+	if (!of_machine_is_compatible("xiaomi,uke"))
+		return -ENODEV;
+	domain = iommu_get_domain_for_dev(dev);
+	if (!domain)
+		return -EPROBE_DEFER;
+	return iommu_is_dma_domain(domain) ? 0 : -EINVAL;
+}
+
 static int q6apm_dai_probe(struct platform_device *pdev)
 {
 	struct device *dev = &pdev->dev;
@@ -1045,6 +1060,11 @@
 	struct of_phandle_args args;
 	int rc;
 
+	/* PCM construction maps DSP buffers before the first stream open. */
+	rc = q6apm_hdmi_dma_ready(dev);
+	if (rc)
+		return dev_err_probe(dev, rc, "HDMI frontend requires its DMA domain\n");
+
 	pdata = devm_kzalloc(dev, sizeof(*pdata), GFP_KERNEL);
 	if (!pdata)
 		return -ENOMEM;
--- a/sound/soc/qcom/Kconfig
+++ b/sound/soc/qcom/Kconfig
@@ -198,6 +198,8 @@
 config SND_SOC_UKE
 	tristate "Uke AudioReach card registration"
 	depends on QCOM_APR && OF
+	select SND_SOC_QCOM_COMMON
+	select SND_SOC_HDMI_CODEC
 	select SND_SOC_QDSP6_APM
 	select SND_SOC_QDSP6_APM_DAI
 	help
