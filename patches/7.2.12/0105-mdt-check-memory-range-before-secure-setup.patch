From: Uke Linux contributors <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] soc: qcom: validate MDT carveout bounds before PAS setup

Check the complete loadable image range before metadata initialization or
secure memory setup. The segment loader's later check cannot prevent PAS
side effects for an image that does not fit the reserved memory.

Pass the existing allocation size into the shared initializer. Preserve
absolute addresses for fixed images and page-round only relocatable setup
spans. Reject empty images, invalid file/memory lengths, missing buffers and
wrapping physical allocations. Promote ELF32 address/length addition before
it can wrap, including the shared image-size query used by GPU consumers.

Compared with signed Linux 7.2.12 mdt_loader.c and its PAS/GPU/media/wireless
callers; Xiaomi Uke 5712080a4b0c0b1a879e6d145c601c649ddaddfd, OnePlus
fc892483f1d61f245924681eb5abd563564d9cba, Palawan
0d9f7fdf720ae9f4ecfbee4fadaf1e3b5c442e95 and upstream
4056b3c9d3c92ea45955641dbafeb9b960e146ef have the same later-bounds pattern.
No donor board values or firmware payloads are copied. Signature checking,
SCM return values and segment-loading errors remain authoritative.

Signed-off-by: Uke Linux contributors <75160848+MCC45TR@users.noreply.github.com>
---
diff --git a/drivers/soc/qcom/mdt_loader.c b/drivers/soc/qcom/mdt_loader.c
index c004d44..35f003e 100644
--- a/drivers/soc/qcom/mdt_loader.c
+++ b/drivers/soc/qcom/mdt_loader.c
@@ -24,7 +24,7 @@ static bool mdt_header_valid(const struct firmware *fw)
 	size_t phend;
 	size_t shend;
 
-	if (fw->size < sizeof(*ehdr))
+	if (!fw || !fw->data || fw->size < sizeof(*ehdr))
 		return false;
 
 	ehdr = (struct elf32_hdr *)fw->data;
@@ -122,6 +122,8 @@ ssize_t qcom_mdt_get_size(const struct firmware *fw)
 	phdrs = (struct elf32_phdr *)(fw->data + ehdr->e_phoff);
 
 	for (i = 0; i < ehdr->e_phnum; i++) {
+		phys_addr_t end;
+
 		phdr = &phdrs[i];
 
 		if (!mdt_phdr_loadable(phdr))
@@ -130,8 +132,9 @@ ssize_t qcom_mdt_get_size(const struct firmware *fw)
 		if (phdr->p_paddr < min_addr)
 			min_addr = phdr->p_paddr;
 
-		if (phdr->p_paddr + phdr->p_memsz > max_addr)
-			max_addr = ALIGN(phdr->p_paddr + phdr->p_memsz, SZ_4K);
+		end = (phys_addr_t)phdr->p_paddr + phdr->p_memsz;
+		if (end > max_addr)
+			max_addr = ALIGN(end, SZ_4K);
 	}
 
 	return min_addr < max_addr ? max_addr - min_addr : -EINVAL;
@@ -229,41 +232,57 @@ EXPORT_SYMBOL_GPL(qcom_mdt_read_metadata);
 
 static int __qcom_mdt_pas_init(struct device *dev, const struct firmware *fw,
 			       const char *fw_name, int pas_id, phys_addr_t mem_phys,
-			       struct qcom_scm_pas_context *ctx)
+			       size_t mem_size, struct qcom_scm_pas_context *ctx)
 {
 	const struct elf32_phdr *phdrs;
 	const struct elf32_phdr *phdr;
 	const struct elf32_hdr *ehdr;
 	phys_addr_t min_addr = PHYS_ADDR_MAX;
 	phys_addr_t max_addr = 0;
+	phys_addr_t mem_reloc;
 	bool relocate = false;
 	size_t metadata_len;
 	void *metadata;
 	int ret;
 	int i;
 
-	if (!mdt_header_valid(fw))
+	if (!mem_phys || !mem_size || mem_size > PHYS_ADDR_MAX - mem_phys ||
+	    !mdt_header_valid(fw))
 		return -EINVAL;
 
 	ehdr = (struct elf32_hdr *)fw->data;
 	phdrs = (struct elf32_phdr *)(fw->data + ehdr->e_phoff);
 
 	for (i = 0; i < ehdr->e_phnum; i++) {
+		phys_addr_t end;
+
 		phdr = &phdrs[i];
 
 		if (!mdt_phdr_loadable(phdr))
 			continue;
 
+		if (phdr->p_filesz > phdr->p_memsz)
+			return -EINVAL;
+
 		if (phdr->p_flags & QCOM_MDT_RELOCATABLE)
 			relocate = true;
 
 		if (phdr->p_paddr < min_addr)
 			min_addr = phdr->p_paddr;
 
-		if (phdr->p_paddr + phdr->p_memsz > max_addr)
-			max_addr = ALIGN(phdr->p_paddr + phdr->p_memsz, SZ_4K);
+		end = (phys_addr_t)phdr->p_paddr + phdr->p_memsz;
+		if (end > max_addr)
+			max_addr = end;
 	}
 
+	mem_reloc = relocate ? min_addr : mem_phys;
+	if (relocate)
+		max_addr = ALIGN(max_addr, SZ_4K);
+	/* Refuse invalid geometry before changing secure PAS state. */
+	if (min_addr >= max_addr || min_addr < mem_reloc ||
+	    max_addr - mem_reloc > mem_size)
+		return -EINVAL;
+
 	metadata = qcom_mdt_read_metadata(fw, &metadata_len, fw_name, dev);
 	if (IS_ERR(metadata)) {
 		ret = PTR_ERR(metadata);
@@ -457,7 +476,10 @@ int qcom_mdt_load(struct device *dev, const struct firmware *fw,
 {
 	int ret;
 
-	ret = __qcom_mdt_pas_init(dev, fw, fw_name, pas_id, mem_phys, NULL);
+	if (!mem_region)
+		return -EINVAL;
+
+	ret = __qcom_mdt_pas_init(dev, fw, fw_name, pas_id, mem_phys, mem_size, NULL);
 	if (ret)
 		return ret;
 
@@ -488,7 +510,11 @@ int qcom_mdt_pas_load(struct qcom_scm_pas_context *ctx, const struct firmware *f
 {
 	int ret;
 
-	ret = __qcom_mdt_pas_init(ctx->dev, fw, firmware, ctx->pas_id, ctx->mem_phys, ctx);
+	if (!ctx || !mem_region)
+		return -EINVAL;
+
+	ret = __qcom_mdt_pas_init(ctx->dev, fw, firmware, ctx->pas_id,
+				ctx->mem_phys, ctx->mem_size, ctx);
 	if (ret)
 		return ret;
 
