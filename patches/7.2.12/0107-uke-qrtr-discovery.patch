From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] net: qrtr: initiate Uke SMD service discovery after receive setup

Adapt the per-endpoint HELLO worker from upstream 544d85de4dc2 (Chris Lew,
Deepak Kumar Singh and Pranav Mahesh Phansalkar). The Uke firmware may wait
for the host after the name server initial broadcast has already run.
Request HELLO only after the SMD receive context has been published. Retry
missing name-server readiness, allocation failure and transient transport
backpressure. Cancel pending work before endpoint teardown.

Retain the 7.2 name-server HELLO replies and normal control/data path. Do
not add the 544d85 HELLO gate: its name-server packet loss is described in
Igor Opaniuk's 19 October 2026 follow-up series. Include that series's
independent announce/lookup continuation fix, preserving its attribution.
No board GPIO, power/current limit, firmware or PCM activation changes.

References:
https://github.com/torvalds/linux/commit/544d85de4dc22c01badfd8cefa59829ce35c4858
https://lists.openwall.net/netdev/2026/10/19/240
https://lists.openwall.net/netdev/2026/10/19/242

Tablet boot and repeated discovery remain separate qualification gates.

--- a/net/qrtr/af_qrtr.c
+++ b/net/qrtr/af_qrtr.c
@@ -9,6 +9,7 @@
 #include <linux/termios.h>	/* For TIOCINQ/OUTQ */
 #include <linux/spinlock.h>
 #include <linux/wait.h>
+#include <linux/workqueue.h>
 
 #include <net/sock.h>
 
@@ -122,6 +123,7 @@
  * @qrtr_tx_lock: lock for qrtr_tx_flow inserts
  * @rx_queue: receive queue
  * @item: list item for broadcast list
+ * @say_hello: delayed work for a transport's explicit HELLO request
  */
 struct qrtr_node {
 	struct mutex ep_lock;
@@ -134,6 +136,7 @@
 
 	struct sk_buff_head rx_queue;
 	struct list_head item;
+	struct delayed_work say_hello;
 };
 
 /**
@@ -187,6 +190,8 @@
 	list_del(&node->item);
 	mutex_unlock(&qrtr_node_lock);
 
+	cancel_delayed_work_sync(&node->say_hello);
+
 	skb_queue_purge(&node->rx_queue);
 
 	/* Free tx flow counters */
@@ -416,7 +421,7 @@
 	spin_lock_irqsave(&qrtr_nodes_lock, flags);
 	radix_tree_insert(&qrtr_nodes, nid, node);
 	if (node->nid == QRTR_EP_NID_AUTO)
-		node->nid = nid;
+		WRITE_ONCE(node->nid, nid);
 	spin_unlock_irqrestore(&qrtr_nodes_lock, flags);
 }
 
@@ -570,6 +575,49 @@
 	return skb;
 }
 
+static void qrtr_hello_work(struct work_struct *work)
+{
+	struct sockaddr_qrtr from = {AF_QIPCRTR, 0, QRTR_PORT_CTRL};
+	struct sockaddr_qrtr to = {AF_QIPCRTR, 0, QRTR_PORT_CTRL};
+	struct qrtr_node *node;
+	struct qrtr_ctrl_pkt *pkt;
+	struct qrtr_sock *ctrl;
+	struct sk_buff *skb;
+	int ret;
+
+	node = container_of(to_delayed_work(work), struct qrtr_node, say_hello);
+	mutex_lock(&node->ep_lock);
+	if (!node->ep) {
+		mutex_unlock(&node->ep_lock);
+		return;
+	}
+	mutex_unlock(&node->ep_lock);
+	ctrl = qrtr_port_lookup(QRTR_PORT_CTRL);
+	if (!ctrl)
+		goto retry;
+	skb = qrtr_alloc_ctrl_packet(&pkt, GFP_KERNEL);
+	if (!skb) {
+		qrtr_port_put(ctrl);
+		goto retry;
+	}
+	pkt->cmd = cpu_to_le32(QRTR_TYPE_HELLO);
+	from.sq_node = qrtr_local_nid;
+	to.sq_node = READ_ONCE(node->nid);
+	ret = qrtr_node_enqueue(node, skb, QRTR_TYPE_HELLO, &from, &to);
+	qrtr_port_put(ctrl);
+	if (ret != -EAGAIN && ret != -ENOMEM)
+		return;
+retry:
+	schedule_delayed_work(&node->say_hello, msecs_to_jiffies(100));
+}
+
+/* The transport must publish its receive context before requesting HELLO. */
+void qrtr_endpoint_hello(struct qrtr_endpoint *ep)
+{
+	schedule_delayed_work(&ep->node->say_hello, 0);
+}
+EXPORT_SYMBOL_GPL(qrtr_endpoint_hello);
+
 /**
  * qrtr_endpoint_register() - register a new endpoint
  * @ep: endpoint to register
@@ -591,6 +639,7 @@
 
 	kref_init(&node->ref);
 	mutex_init(&node->ep_lock);
+	INIT_DELAYED_WORK(&node->say_hello, qrtr_hello_work);
 	skb_queue_head_init(&node->rx_queue);
 	node->nid = QRTR_EP_NID_AUTO;
 	node->ep = ep;
@@ -629,6 +678,7 @@
 	mutex_lock(&node->ep_lock);
 	node->ep = NULL;
 	mutex_unlock(&node->ep_lock);
+	cancel_delayed_work_sync(&node->say_hello);
 
 	/* Notify the local controller about the event */
 	spin_lock_irqsave(&qrtr_nodes_lock, flags);
--- a/net/qrtr/ns.c
+++ b/net/qrtr/ns.c
@@ -231,7 +231,7 @@
 				continue;
 
 			pr_err("failed to announce new service\n");
-			return ret;
+			/* the remote needs the other servers no less */
 		}
 	}
 	return 0;
@@ -517,10 +517,12 @@
 
 	if (srv->node == qrtr_ns.local_node) {
 		ret = service_announce_new(&qrtr_ns.bcast_sq, srv);
-		if (ret < 0) {
+		/*
+		 * A failed broadcast must not hide the server from the
+		 * lookups already registered for it.
+		 */
+		if (ret < 0)
 			pr_err("failed to announce new service\n");
-			return ret;
-		}
 	}
 
 	/* Notify any potential lookups about the new server */
--- a/net/qrtr/qrtr.h
+++ b/net/qrtr/qrtr.h
@@ -25,6 +25,8 @@
 
 int qrtr_endpoint_register(struct qrtr_endpoint *ep, unsigned int nid);
 
+void qrtr_endpoint_hello(struct qrtr_endpoint *ep);
+
 void qrtr_endpoint_unregister(struct qrtr_endpoint *ep);
 
 int qrtr_endpoint_post(struct qrtr_endpoint *ep, const void *data, size_t len);
--- a/net/qrtr/smd.c
+++ b/net/qrtr/smd.c
@@ -5,6 +5,7 @@
  */
 
 #include <linux/module.h>
+#include <linux/of.h>
 #include <linux/skbuff.h>
 #include <linux/rpmsg.h>
 
@@ -74,6 +75,8 @@
 		return rc;
 
 	dev_set_drvdata(&rpdev->dev, qdev);
+	if (of_machine_is_compatible("xiaomi,uke"))
+		qrtr_endpoint_hello(&qdev->ep);
 
 	dev_dbg(&rpdev->dev, "Qualcomm SMD QRTR driver probed\n");
 
