 	i2c_set_clientdata(client, fs19xx);
@@ -1005,6 +1040,25 @@ static int fs19xx_i2c_probe(struct i2c_client *client)
 			dev_info(dev, "preset loaded, position 0x%x\n", fs19xx->position);
 	}
 
+	if (fs19xx->require_protection) {
+		unsigned int expected;
+		switch (client->addr) {
+		case 0x34: expected = 8; break;
+		case 0x35: expected = 2; break;
+		case 0x36: expected = 4; break;
+		case 0x37: expected = 1; break;
+		default: return -EINVAL;
+		}
+		if (!fs19xx->preset || fs19xx->position != expected)
+			return dev_err_probe(dev, -EINVAL, "protected amplifier identity unavailable\n");
+		fs19xx->protection_listener.notifier_call = fs19xx_protection_event;
+		ret = q6apm_fs19xx_register(&fs19xx->protection_listener, fs19xx->position);
+		if (ret)
+			return dev_err_probe(dev, ret, "protection guard unavailable\n");
+		ret = devm_add_action_or_reset(dev, fs19xx_unregister_protection, fs19xx);
+		if (ret)
+			return ret;
+	}
 	return devm_snd_soc_register_component(dev, &fs19xx_component, &fs19xx_dai, 1);
 }
 
