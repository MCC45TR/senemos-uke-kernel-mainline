+/*
+ * Every failure is unwound by the core's stop transaction, including failures
+ * before authentication. Never release the DTB, mappings or power while SCM
+ * may still own either image. A failed authentication attempt is conservative:
+ * a refused shutdown retains ownership until retry or reboot.
+ */
+static int qcom_cliffs_cdsp_start_inner(struct rproc *rproc)
+{
+	struct qcom_pas *pas = rproc->priv;
+	int ret;
+
+	if (!qcom_pas_boot_allowed(pas))
+		return -EBUSY;
+	pas->stop_phase = QCOM_PAS_STOP_IDLE;
+	pas->cdsp_start_failed = true;
+
+	ret = qcom_q6v5_prepare(&pas->q6v5);
+	if (ret)
+		return ret;
+	pas->cdsp_prepared = true;
+	ret = qcom_pas_proxy_enable(pas);
+	if (ret)
+		return ret;
+	ret = clk_prepare_enable(pas->xo);
+	if (ret)
+		return ret;
+	pas->cdsp_xo_enabled = true;
+	ret = clk_prepare_enable(pas->aggre2_clk);
+	if (ret)
+		return ret;
+	pas->cdsp_aggre2_enabled = true;
+
+	ret = qcom_pas_map_carveout(rproc, pas->dtb_mem_phys, pas->dtb_mem_size);
+	if (ret)
+		return ret;
+	pas->cdsp_dtb_mapped = true;
+	pas->cdsp_dtb_live = true;
+	ret = qcom_pas_prepare_and_auth_reset(pas->dtb_pas_ctx);
+	if (ret)
+		return ret;
+
+	ret = qcom_mdt_pas_load(pas->pas_ctx, pas->firmware, rproc->firmware,
+				&pas->mem_reloc);
+	if (ret)
+		return ret;
+	qcom_pil_info_store(pas->info_name, pas->mem_phys, pas->mem_size);
+	ret = qcom_pas_map_carveout(rproc, pas->mem_phys, pas->mem_size);
+	if (ret)
+		return ret;
+	pas->cdsp_main_mapped = true;
+	pas->cdsp_primary_live = true;
+	ret = qcom_pas_prepare_and_auth_reset(pas->pas_ctx);
+	if (ret)
+		return ret;
+	ret = qcom_q6v5_wait_for_start(&pas->q6v5, msecs_to_jiffies(5000));
+	if (ret)
+		return ret;
+
+	qcom_pas_metadata_release(pas->pas_ctx);
+	qcom_pas_metadata_release(pas->dtb_pas_ctx);
+	pas->firmware = NULL;
+	pas->cdsp_start_failed = false;
+	return 0;
+}
+
+static int qcom_cliffs_cdsp_start(struct rproc *rproc)
+{
+	struct qcom_pas *pas = rproc->priv;
+	int ret = qcom_cliffs_cdsp_start_inner(rproc);
+
+	/* The core releases this borrowed request_firmware reference on return. */
+	pas->firmware = NULL;
+	return ret;
+}
+
+static const struct rproc_ops qcom_cliffs_cdsp_ops = {
+	.start_failure_needs_stop = true,
+	.unprepare = qcom_pas_unprepare,
+	.start = qcom_cliffs_cdsp_start,
+	.stop = qcom_pas_stop,
+	.prepare_stop = qcom_pas_prepare_stop,
+	.da_to_va = qcom_pas_da_to_va,
+	.parse_fw = qcom_pas_parse_firmware,
+	.load = qcom_pas_load,
+	.panic = qcom_pas_panic,
+	.coredump = qcom_pas_minidump,
+};
