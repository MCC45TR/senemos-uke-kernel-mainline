 {
 	const struct qcom_pas_data *desc;
@@ -1035,6 +1196,12 @@ static int qcom_pas_probe(struct platform_device *pdev)
 	const struct rproc_ops *ops = &qcom_pas_ops;
 	int ret;
 
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,cliffs-cdsp-pas")) {
+		ret = qcom_cliffs_cdsp_memory(&pdev->dev);
+		if (ret)
+			return ret;
+	}
+
 	desc = of_device_get_match_data(&pdev->dev);
 	if (!desc)
 		return -EINVAL;
@@ -1059,6 +1226,8 @@ static int qcom_pas_probe(struct platform_device *pdev)
 	if (desc->minidump_id)
 		ops = &qcom_pas_minidump_ops;
 
+	if (of_device_is_compatible(pdev->dev.of_node, "qcom,cliffs-cdsp-pas"))
+		ops = &qcom_cliffs_cdsp_ops;
 	rproc = devm_rproc_alloc(&pdev->dev, desc->sysmon_name, ops, fw_name, sizeof(*pas));
 
 	if (!rproc) {
@@ -1073,11 +1242,13 @@ static int qcom_pas_probe(struct platform_device *pdev)
 		rproc->auto_boot = true;
 		rproc->recovery_disabled = true;
 	}
-	rproc_coredump_set_elf_info(rproc, ELFCLASS32, EM_NONE);
+	rproc_coredump_set_elf_info(rproc, ops == &qcom_cliffs_cdsp_ops ?
+				    ELFCLASS64 : ELFCLASS32, EM_NONE);
 
 	pas = rproc->priv;
 	pas->dev = &pdev->dev;
 	pas->rproc = rproc;
+	pas->cdsp = ops == &qcom_cliffs_cdsp_ops;
 	pas->proxy_regulator_level = desc->proxy_regulator_level;
 	pas->proxy_regulator_count = desc->proxy_regulator_count ?: 2;
 	pas->proxy_regulator_load = desc->proxy_regulator_load;
@@ -1159,6 +1330,16 @@ static int qcom_pas_probe(struct platform_device *pdev)
 	pas->bam_dmux = of_platform_device_create(node, NULL, &pdev->dev);
 	of_node_put(node);
 
+	/*
+	 * This boot-FDT device is permanent. A void platform remove cannot
+	 * refuse devres teardown after a refused secure stop. Its dedicated
+	 * driver has no unbind attributes; retain its module until reboot too.
+	 * Other PAS devices retain their bind/unbind interface. The shared
+	 * module remains loaded while this permanent instance exists.
+	 */
+	if (pas->cdsp && THIS_MODULE)
+		__module_get(THIS_MODULE);
+
 	return 0;
 
