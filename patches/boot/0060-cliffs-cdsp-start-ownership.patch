+static int qcom_cliffs_cdsp_memory(struct device *dev)
+{
+	static const u64 base[] = { 0x99900000, 0x9ad00000, 0x82600000 };
+	static const u64 size[] = { 0x01400000, 0x00080000, 0x00100000 };
+	struct device_node *node;
+	struct resource res;
+	int i, ret;
+
+	if (!of_machine_is_compatible("xiaomi,uke") ||
+	    !of_machine_is_compatible("qcom,sm7675"))
+		return -ENODEV;
+	if (of_count_phandle_with_args(dev->of_node, "memory-region", NULL) != 3)
+		return -EINVAL;
+	for (i = 0; i < ARRAY_SIZE(base); i++) {
+		node = of_parse_phandle(dev->of_node, "memory-region", i);
+		if (!node)
+			return -EINVAL;
+		ret = of_address_to_resource(node, 0, &res);
+		if (!of_property_present(node, "no-map"))
+			ret = -EINVAL;
+		of_node_put(node);
+		if (ret || res.start != base[i] || resource_size(&res) != size[i])
+			return dev_err_probe(dev, -EINVAL, "Unexpected Uke CDSP memory region %d\n", i);
+	}
+	return 0;
+}
+
