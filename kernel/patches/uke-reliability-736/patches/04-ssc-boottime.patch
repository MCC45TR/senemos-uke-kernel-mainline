+/* The admitted streaming buffer and its clock are stable under c->state. */
+static s64 ssc_iio_timestamp(struct ssc_sensor *s)
+{
+#if defined(CONFIG_ARM64) && defined(CONFIG_ARM_ARCH_TIMER)
+	u64 before, after, counter, age, stamp;
+	u32 frequency;
+
+	if (ssc_timestamp_trial && !s->use_arrival_time &&
+	    s->attributes.stream_type == 0 &&
+	    (s->description->kind == SSC_GRAVITY ||
+	     !strcmp(s->description->datatype, "game_rv")) &&
+	    iio_device_get_clock(s->iio) == CLOCK_BOOTTIME) {
+		frequency = arch_timer_get_cntfrq();
+		before = ktime_get_boottime_ns();
+		counter = arch_timer_read_counter();
+		after = ktime_get_boottime_ns();
+		if (frequency == 19200000 && before && after >= before &&
+		    after - before <= 10 * NSEC_PER_USEC &&
+		    s->ticks && counter >= s->ticks && counter - s->ticks <= frequency / 10) {
+			age = div_u64((counter - s->ticks) * NSEC_PER_SEC, frequency);
+			stamp = before + (after - before) / 2;
+			if (stamp > age && stamp - age <= S64_MAX &&
+			    (s64)(stamp - age) > s->last_acquisition_ns) {
+				s->last_acquisition_ns = stamp - age;
+				return s->last_acquisition_ns;
+			}
+		}
+		/* Returning to acquisition time could date the next scan before
+		 * the fallback scan. Keep arrival time until the buffer is reopened.
+		 */
+		s->use_arrival_time = true;
+	}
+#endif
+	return iio_get_time_ns(s->iio);
+}
