+static int uke_mic_remove_duplicate_dp_widget(struct snd_soc_card *card)
+{
+	const struct snd_soc_dapm_widget *widgets = card->of_dapm_widgets;
+	struct snd_soc_dapm_widget *filtered;
+	int i;
+
+	/* Older Uke DTBOs also declare the jack supplied by the card helper. */
+	for (i = 0; i < card->num_of_dapm_widgets; i++) {
+		if (widgets[i].id == snd_soc_dapm_spk &&
+		    !strcmp(widgets[i].name, "DP0 Jack"))
+			break;
+	}
+	if (i == card->num_of_dapm_widgets)
+		return 0;
+
+	filtered = devm_kmemdup(card->dev, widgets,
+			       card->num_of_dapm_widgets * sizeof(*widgets), GFP_KERNEL);
+	if (!filtered)
+		return -ENOMEM;
+	card->num_of_dapm_widgets--;
+	memmove(&filtered[i], &filtered[i + 1],
+		(card->num_of_dapm_widgets - i) * sizeof(*filtered));
+	card->of_dapm_widgets = filtered;
+	return 0;
+}
