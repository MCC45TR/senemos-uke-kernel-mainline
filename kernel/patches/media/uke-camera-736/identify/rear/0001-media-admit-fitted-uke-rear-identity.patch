diff --git a/after/drivers/media/i2c/uke-rear-camera-id.c b/after/drivers/media/i2c/uke-rear-camera-id.c
new file mode 100644
index 0000000..584b379
--- /dev/null
+++ b/after/drivers/media/i2c/uke-rear-camera-id.c
@@ -0,0 +1,240 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <dt-bindings/gpio/gpio.h>
+#include <linux/device.h>
+#include <linux/i2c.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/slab.h>
+#include <linux/sysfs.h>
+
+#include "uke-rear-camera-power.h"
+
+struct uke_rear_camera_id {
+	struct uke_rear_camera_power power;
+	struct uke_rear_camera_sample sample;
+	struct mutex lock;
+	bool attempted;
+	int result;
+};
+
+static bool uke_rear_camera_check_bus(struct i2c_client *client)
+{
+	struct device_node *sensor = client->dev.of_node;
+	struct device_node *bus = client->adapter->dev.of_node;
+	struct device_node *parent __free(device_node) = of_get_parent(sensor);
+	struct device_node *cci __free(device_node) = of_get_parent(bus);
+	struct resource registers;
+	u32 master, frequency;
+
+	return of_machine_is_compatible("xiaomi,uke") &&
+	       of_machine_is_compatible("qcom,sm7675") &&
+	       sensor && !of_node_check_flag(sensor, OF_DYNAMIC) &&
+	       bus && parent == bus && cci && client->addr == 0x10 &&
+	       !(client->flags & I2C_CLIENT_TEN) &&
+	       i2c_check_functionality(client->adapter, I2C_FUNC_I2C) &&
+	       of_node_name_eq(bus, "i2c-bus") &&
+	       !of_property_read_u32(bus, "reg", &master) && master == 1 &&
+	       !of_property_read_u32(bus, "clock-frequency", &frequency) && frequency == 400000 &&
+	       of_device_is_compatible(cci, "qcom,sm7675-cci") &&
+	       !of_address_to_resource(cci, 0, &registers) &&
+	       registers.start == 0x0ac15000 && resource_size(&registers) == 0x1000;
+}
+
+static bool uke_rear_camera_pin_matches(struct device_node *sensor, struct device_node *tlmm,
+					const char *property, int index, const char *name)
+{
+	struct device_node *pin __free(device_node) = of_parse_phandle(sensor, property, index);
+	struct device_node *parent __free(device_node) = of_get_parent(pin);
+
+	return parent && parent == tlmm && of_node_name_eq(pin, name);
+}
+
+static int uke_rear_camera_check_pins(struct device_node *sensor)
+{
+	struct of_phandle_args gpio;
+	struct resource tlmm;
+	int ret;
+
+	if (of_property_count_strings(sensor, "pinctrl-names") != 2 ||
+	    of_property_match_string(sensor, "pinctrl-names", "sensor-active") != 0 ||
+	    of_property_match_string(sensor, "pinctrl-names", "sensor-parked") != 1 ||
+	    of_property_count_u32_elems(sensor, "pinctrl-0") != 2 ||
+	    of_property_count_u32_elems(sensor, "pinctrl-1") != 2 ||
+	    of_count_phandle_with_args(sensor, "reset-gpios", "#gpio-cells") != 1)
+		return -EINVAL;
+
+	ret = of_parse_phandle_with_args(sensor, "reset-gpios", "#gpio-cells", 0, &gpio);
+	if (ret)
+		return ret;
+	if (gpio.args_count != 2 || gpio.args[0] != 14 || gpio.args[1] != GPIO_ACTIVE_LOW ||
+	    !of_device_is_compatible(gpio.np, "qcom,cliffs-pinctrl") ||
+	    of_address_to_resource(gpio.np, 0, &tlmm) || tlmm.start != 0x0f000000 ||
+	    !uke_rear_camera_pin_matches(sensor, gpio.np, "pinctrl-0", 0, "cam_sensor_mclk0_active") ||
+	    !uke_rear_camera_pin_matches(sensor, gpio.np, "pinctrl-0", 1, "cam_sensor_wide_active_rst") ||
+	    !uke_rear_camera_pin_matches(sensor, gpio.np, "pinctrl-1", 0, "cam_sensor_mclk0_suspend") ||
+	    !uke_rear_camera_pin_matches(sensor, gpio.np, "pinctrl-1", 1, "cam_sensor_wide_suspend_rst"))
+		ret = -EINVAL;
+	of_node_put(gpio.np);
+	return ret;
+}
+
+static int uke_rear_camera_get_supplies(struct device *dev,
+					struct uke_rear_camera_power *power)
+{
+	unsigned int rail;
+
+	for (rail = 0; rail < UKE_REAR_SUPPLY_COUNT; rail++) {
+		const char *property = uke_rear_supply_spec[rail].property;
+		struct device_node *supply __free(device_node) = NULL;
+		const char *name;
+
+		if (of_property_count_u32_elems(dev->of_node, property) != 1)
+			return -EINVAL;
+
+		supply = of_parse_phandle(dev->of_node, property, 0);
+		if (!supply || of_property_read_string(supply, "regulator-name", &name) ||
+		    strcmp(name, uke_rear_supply_spec[rail].provider))
+			return -EINVAL;
+
+		power->supplies[rail] = devm_regulator_get_optional(dev, uke_rear_supply_spec[rail].name);
+		if (IS_ERR(power->supplies[rail]))
+			return PTR_ERR(power->supplies[rail]);
+	}
+	return 0;
+}
+
+static int uke_rear_camera_get_resources(struct device *dev,
+					 struct uke_rear_camera_power *power)
+{
+	int ret;
+
+	ret = uke_rear_camera_get_supplies(dev, power);
+	if (ret)
+		return ret;
+
+	power->clock = uke_camera_sensor_clock_get(dev, CAM_CC_MCLK0_CLK,
+						  "uke-rear-camera-domain");
+	if (IS_ERR(power->clock))
+		return PTR_ERR(power->clock);
+
+	power->pinctrl = devm_pinctrl_get(dev);
+	if (IS_ERR(power->pinctrl))
+		return PTR_ERR(power->pinctrl);
+	power->active = pinctrl_lookup_state(power->pinctrl, "sensor-active");
+	if (IS_ERR(power->active))
+		return PTR_ERR(power->active);
+	power->parked = pinctrl_lookup_state(power->pinctrl, "sensor-parked");
+	if (IS_ERR(power->parked))
+		return PTR_ERR(power->parked);
+	power->reset = devm_gpiod_get(dev, "reset", GPIOD_ASIS);
+	if (IS_ERR(power->reset))
+		return PTR_ERR(power->reset);
+
+	return gpiod_is_active_low(power->reset) ? 0 : -EINVAL;
+}
+
+static int uke_rear_camera_identify(struct device *dev, struct uke_rear_camera_id *sensor)
+{
+	struct uke_rear_camera_power *power = &sensor->power;
+	void *resources;
+	int ret;
+
+	if (sensor->attempted)
+		return sensor->result;
+
+	resources = devres_open_group(dev, NULL, GFP_KERNEL);
+	if (!resources)
+		return -ENOMEM;
+
+	ret = uke_rear_camera_get_resources(dev, power);
+	if (!ret) {
+		sensor->attempted = true;
+		ret = uke_rear_camera_sample(to_i2c_client(dev), power, &sensor->sample);
+		sensor->result = ret;
+	}
+	if (power->fault) {
+		devres_remove_group(dev, resources);
+		dev_err(dev, "rear camera power ownership retained after error %d\n", power->fault);
+	} else {
+		devres_release_group(dev, resources);
+	}
+
+	return ret == -EPROBE_DEFER ? -EAGAIN : ret;
+}
+
+static ssize_t sensor_id_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct uke_rear_camera_id *sensor = i2c_get_clientdata(to_i2c_client(dev));
+	int ret;
+
+	guard(mutex)(&sensor->lock);
+	ret = uke_rear_camera_identify(dev, sensor);
+	if (ret)
+		return ret;
+	if (sensor->sample.oem_result)
+		return sensor->sample.oem_result;
+	return sysfs_emit(buf, "0x%04x\n", sensor->sample.oem_id);
+}
+
+static ssize_t model_id_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct uke_rear_camera_id *sensor = i2c_get_clientdata(to_i2c_client(dev));
+	int ret;
+
+	guard(mutex)(&sensor->lock);
+	ret = uke_rear_camera_identify(dev, sensor);
+	if (ret)
+		return ret;
+	if (sensor->sample.model_result)
+		return sensor->sample.model_result;
+	return sysfs_emit(buf, "0x%06x\n", sensor->sample.model_id);
+}
+
+static DEVICE_ATTR(sensor_id, 0400, sensor_id_show, NULL);
+static DEVICE_ATTR(model_id, 0400, model_id_show, NULL);
+
+static struct attribute *uke_rear_camera_attrs[] = {
+	&dev_attr_sensor_id.attr,
+	&dev_attr_model_id.attr,
+	NULL,
+};
+
+ATTRIBUTE_GROUPS(uke_rear_camera);
+
+static int uke_rear_camera_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct uke_rear_camera_id *sensor;
+	int ret;
+
+	if (!uke_rear_camera_check_bus(client))
+		return -ENODEV;
+	ret = uke_rear_camera_check_pins(dev->of_node);
+	if (ret)
+		return ret;
+
+	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	if (!sensor)
+		return -ENOMEM;
+	mutex_init(&sensor->lock);
+	i2c_set_clientdata(client, sensor);
+	return 0;
+}
+
+static const struct of_device_id uke_rear_camera_of_match[] = {
+	{ .compatible = "xiaomi,uke-rear-camera-identify" },
+	{ }
+};
+
+static struct i2c_driver uke_rear_camera_driver = {
+	.driver = {
+		.name = "uke-rear-camera-identify",
+		.of_match_table = uke_rear_camera_of_match,
+		.suppress_bind_attrs = true,
+		.dev_groups = uke_rear_camera_groups,
+	},
+	.probe = uke_rear_camera_probe,
+};
+
+builtin_i2c_driver(uke_rear_camera_driver);
diff --git a/after/drivers/media/i2c/uke-rear-camera-power.h b/after/drivers/media/i2c/uke-rear-camera-power.h
new file mode 100644
index 0000000..9e68d7a
--- /dev/null
+++ b/after/drivers/media/i2c/uke-rear-camera-power.h
@@ -0,0 +1,234 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef UKE_REAR_CAMERA_POWER_H
+#define UKE_REAR_CAMERA_POWER_H
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/limits.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+
+#include "uke-camera-sensor-clock.h"
+
+enum uke_rear_supply {
+	UKE_REAR_BOB,
+	UKE_REAR_CUSTOM,
+	UKE_REAR_VANA,
+	UKE_REAR_VDIG,
+	UKE_REAR_VIO,
+	UKE_REAR_SUPPLY_COUNT,
+};
+
+static const struct {
+	const char *name;
+	const char *property;
+	const char *provider;
+	int microvolts;
+	int microamps;
+} uke_rear_supply_spec[UKE_REAR_SUPPLY_COUNT] = {
+	[UKE_REAR_BOB] = { "bob", "bob-supply", "pmxr2230_bob", 3296000, 103000 },
+	[UKE_REAR_CUSTOM] = { "custom", "custom-supply", "pmxr2230_s2", 1256000, 454000 },
+	[UKE_REAR_VANA] = { "vana", "vana-supply", "camera_wide_avdd_ldo", 2800000, 102000 },
+	[UKE_REAR_VDIG] = { "vdig", "vdig-supply", "pmr735a_l6", 1200000, 130000 },
+	[UKE_REAR_VIO] = { "vio", "vio-supply", "pmxr2230_l20", 1800000, 106000 },
+};
+
+struct uke_rear_camera_power {
+	struct uke_camera_sensor_clock *clock;
+	struct pinctrl *pinctrl;
+	struct pinctrl_state *active;
+	struct pinctrl_state *parked;
+	struct gpio_desc *reset;
+	struct regulator *supplies[UKE_REAR_SUPPLY_COUNT];
+	unsigned long voltage_votes;
+	unsigned long load_votes;
+	unsigned long enabled;
+	bool pins_active;
+	bool reset_configured;
+	int fault;
+};
+
+static int uke_rear_rail_enable(struct uke_rear_camera_power *power, unsigned int rail)
+{
+	struct regulator *supply = power->supplies[rail];
+	int voltage = uke_rear_supply_spec[rail].microvolts;
+	int ret;
+
+	ret = regulator_set_voltage(supply, voltage, voltage);
+	if (ret)
+		return ret;
+	power->voltage_votes |= BIT(rail);
+	ret = regulator_set_load(supply, uke_rear_supply_spec[rail].microamps);
+	if (ret)
+		return ret;
+	power->load_votes |= BIT(rail);
+	ret = regulator_enable(supply);
+	if (!ret)
+		power->enabled |= BIT(rail);
+	return ret;
+}
+
+static int uke_rear_rail_disable(struct uke_rear_camera_power *power, unsigned int rail)
+{
+	struct regulator *supply = power->supplies[rail];
+	int ret;
+
+	if (power->enabled & BIT(rail)) {
+		ret = regulator_disable(supply);
+		if (ret)
+			return ret;
+		power->enabled &= ~BIT(rail);
+	}
+	if (power->load_votes & BIT(rail)) {
+		ret = regulator_set_load(supply, 0);
+		if (ret)
+			return ret;
+		power->load_votes &= ~BIT(rail);
+	}
+	if (power->voltage_votes & BIT(rail)) {
+		ret = regulator_set_voltage(supply, 0, INT_MAX);
+		if (ret)
+			return ret;
+		power->voltage_votes &= ~BIT(rail);
+	}
+	return 0;
+}
+
+static int uke_rear_camera_power_off(struct uke_rear_camera_power *power)
+{
+	int ret, clock_ret;
+	unsigned int rail;
+
+	/* Stop MCLK before asserting reset, even when domain teardown fails. */
+	clock_ret = uke_camera_sensor_clock_off(power->clock);
+	if (power->reset_configured) {
+		ret = gpiod_direction_output(power->reset, 1);
+		if (ret)
+			goto fault;
+		fsleep(2000);
+		power->reset_configured = false;
+	}
+	if (clock_ret) {
+		ret = clock_ret;
+		goto fault;
+	}
+	for (rail = UKE_REAR_SUPPLY_COUNT; rail-- > 0;) {
+		ret = uke_rear_rail_disable(power, rail);
+		if (ret)
+			goto fault;
+	}
+	if (power->pins_active) {
+		ret = pinctrl_select_state(power->pinctrl, power->parked);
+		if (ret)
+			goto fault;
+		power->pins_active = false;
+	}
+	return 0;
+
+fault:
+	/* Preserve dependent votes and ownership until the next boot. */
+	power->fault = ret;
+	return ret;
+}
+
+static int uke_rear_camera_power_on(struct uke_rear_camera_power *power)
+{
+	unsigned int rail;
+	int ret, cleanup;
+
+	if (power->fault)
+		return power->fault;
+	ret = qcom_sm7675_camcc_status();
+	if (ret)
+		return ret;
+
+	power->pins_active = true;
+	ret = pinctrl_select_state(power->pinctrl, power->active);
+	if (ret)
+		goto unwind;
+
+	for (rail = UKE_REAR_BOB; rail <= UKE_REAR_CUSTOM; rail++) {
+		ret = uke_rear_rail_enable(power, rail);
+		if (ret)
+			goto unwind;
+		fsleep(1000);
+	}
+
+	power->reset_configured = true;
+	ret = gpiod_direction_output(power->reset, 1);
+	if (ret)
+		goto unwind;
+	fsleep(2000);
+
+	for (rail = UKE_REAR_VANA; rail < UKE_REAR_SUPPLY_COUNT; rail++) {
+		ret = uke_rear_rail_enable(power, rail);
+		if (ret)
+			goto unwind;
+	}
+	ret = uke_camera_sensor_clock_on(power->clock);
+	if (ret)
+		goto unwind;
+	fsleep(10000);
+	ret = gpiod_direction_output(power->reset, 0);
+	if (ret)
+		goto unwind;
+	fsleep(2000);
+	return 0;
+
+unwind:
+	cleanup = uke_rear_camera_power_off(power);
+	return cleanup ?: ret;
+}
+
+struct uke_rear_camera_sample {
+	int oem_result;
+	int model_result;
+	u16 oem_id;
+	u32 model_id;
+};
+
+static int uke_rear_camera_read_register(struct i2c_client *client, u16 reg,
+					u8 *data, unsigned int length)
+{
+	u8 address[2] = { reg >> 8, reg };
+	struct i2c_msg messages[] = {
+		{ .addr = client->addr, .len = sizeof(address), .buf = address },
+		{ .addr = client->addr, .flags = I2C_M_RD, .len = length, .buf = data },
+	};
+	const int count = ARRAY_SIZE(messages);
+	int ret = i2c_transfer(client->adapter, messages, count);
+
+	if (ret == count)
+		return 0;
+	return ret < 0 ? ret : -EIO;
+}
+
+static int uke_rear_camera_sample(struct i2c_client *client,
+				  struct uke_rear_camera_power *power,
+				  struct uke_rear_camera_sample *sample)
+{
+	u8 data[3];
+	int ret;
+
+	ret = uke_rear_camera_power_on(power);
+	if (ret)
+		return ret;
+
+	sample->oem_result = uke_rear_camera_read_register(client, 0x300b, data, 2);
+	sample->model_result = sample->oem_result;
+	if (!sample->oem_result) {
+		sample->oem_id = get_unaligned_be16(data);
+		sample->model_result = -ENODEV;
+		if (sample->oem_id == 0x0d42) {
+			sample->model_result = uke_rear_camera_read_register(client, 0x300a, data, 3);
+			if (!sample->model_result)
+				sample->model_id = get_unaligned_be24(data);
+		}
+	}
+
+	return uke_rear_camera_power_off(power);
+}
+
+#endif
