diff --git a/after/Documentation/devicetree/bindings/media/i2c/xiaomi,uke-rear-camera-identify.yaml b/after/Documentation/devicetree/bindings/media/i2c/xiaomi,uke-rear-camera-identify.yaml
new file mode 100644
index 0000000..c10a999
--- /dev/null
+++ b/after/Documentation/devicetree/bindings/media/i2c/xiaomi,uke-rear-camera-identify.yaml
@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/xiaomi,uke-rear-camera-identify.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Xiaomi Uke fitted rear camera identity interface
+
+maintainers:
+  - Uke Linux Maintainers <75160848+MCC45TR@users.noreply.github.com>
+
+description:
+  Fitted rear sensor on the second master of CCI0. The native driver powers the
+  module on demand for chip identification and leaves capture provisioning to
+  the sensor and media graph.
+
+properties:
+  compatible:
+    const: xiaomi,uke-rear-camera-identify
+
+  reg:
+    const: 0x10
+
+  clocks:
+    maxItems: 1
+
+  clock-names:
+    const: xclk
+
+  reset-gpios:
+    maxItems: 1
+
+  bob-supply:
+    description: 3.296 V parent camera supply.
+
+  custom-supply:
+    description: 1.256 V supplemental camera supply.
+
+  vana-supply:
+    description: 2.8 V switched analog rail.
+
+  vdig-supply:
+    description: 1.2 V digital core rail.
+
+  vio-supply:
+    description: 1.8 V I/O rail.
+
+  pinctrl-names:
+    items:
+      - const: sensor-active
+      - const: sensor-parked
+
+  pinctrl-0: true
+  pinctrl-1: true
+
+  camera-clock-domain:
+    type: object
+    additionalProperties: false
+    properties:
+      power-domains:
+        maxItems: 1
+    required:
+      - power-domains
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - reset-gpios
+  - bob-supply
+  - custom-supply
+  - vana-supply
+  - vdig-supply
+  - vio-supply
+  - pinctrl-names
+  - pinctrl-0
+  - pinctrl-1
+  - camera-clock-domain
+
+additionalProperties: false
+...
