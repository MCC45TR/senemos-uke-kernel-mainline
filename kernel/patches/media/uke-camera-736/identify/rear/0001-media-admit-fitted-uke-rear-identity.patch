diff --git a/after/arch/arm64/kernel/uke-rear-camera-id-dt.h b/after/arch/arm64/kernel/uke-rear-camera-id-dt.h
new file mode 100644
index 0000000..81abefd
--- /dev/null
+++ b/after/arch/arm64/kernel/uke-rear-camera-id-dt.h
@@ -0,0 +1,184 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef UKE_REAR_CAMERA_ID_DT_H
+#define UKE_REAR_CAMERA_ID_DT_H
+
+#include <dt-bindings/gpio/gpio.h>
+
+#define UKE_REAR_MASTER "/soc/i2c@ac15000/i2c-bus@1"
+#define UKE_REAR_RPMH "/soc/rsc@17a00000/drv@2/"
+#define UKE_REAR_VANA "/soc/gpio-regulator@1"
+
+static int UKE_INIT uke_rear_camera_id_graph(void *fdt)
+{
+	static const char pin_names[] = "sensor-active\0sensor-parked";
+	static const char oem_pins[] = "cam_default\0cam_suspend";
+	static const char supply_names[] =
+		"cam_vana\0cam_vio\0cam_vdig\0cam_v_custom1\0cam_vaf\0cam_clk\0cam_bob";
+	static const struct {
+		const char *path;
+		const char *provider;
+		const char *old_property;
+		const char *new_property;
+	} rails[] = {
+		{ UKE_REAR_VANA, "camera_wide_avdd_ldo", "cam_vana-supply", "vana-supply" },
+		{ UKE_REAR_RPMH "rpmh-regulator-ldob20/regulator-pmxr2230-l20",
+		  "pmxr2230_l20", "cam_vio-supply", "vio-supply" },
+		{ UKE_REAR_RPMH "rpmh-regulator-ldoe6/regulator-pmr735a-l6",
+		  "pmr735a_l6", "cam_vdig-supply", "vdig-supply" },
+		{ UKE_REAR_RPMH "rpmh-regulator-smpb2/regulator-pmxr2230-s2",
+		  "pmxr2230_s2", "cam_v_custom1-supply", "custom-supply" },
+		{ UKE_REAR_RPMH "rpmh-regulator-bobb1/regulator-pmxr2230-bob1",
+		  "pmxr2230_bob", "cam_bob-supply", "bob-supply" },
+	};
+	static const char * const pins[] = {
+		"cam_sensor_mclk0_active", "cam_sensor_wide_active_rst",
+		"cam_sensor_mclk0_suspend", "cam_sensor_wide_suspend_rst",
+	};
+	const fdt32_t supply_volts[] = {
+		cpu_to_fdt32(2800000), cpu_to_fdt32(1800000), cpu_to_fdt32(1200000),
+		cpu_to_fdt32(1256000), cpu_to_fdt32(2800000), 0, cpu_to_fdt32(3296000),
+	};
+	const fdt32_t supply_loads[] = {
+		cpu_to_fdt32(102000), cpu_to_fdt32(106000), cpu_to_fdt32(130000),
+		cpu_to_fdt32(454000), cpu_to_fdt32(150000), 0, cpu_to_fdt32(103000),
+	};
+	fdt32_t pin_refs[4], reset[3], legacy_gpios[6], clock[2], domain[2];
+	fdt32_t vana_gpio[3];
+	unsigned int providers[ARRAY_SIZE(rails)];
+	int bus, legacy, cci, node, anchor, camcc, tlmm, vana, ret, i;
+	unsigned int clock_provider, gpio_provider;
+
+	if (fdt_node_check_compatible(fdt, 0, "xiaomi,uke") ||
+	    fdt_node_check_compatible(fdt, 0, "qcom,sm7675"))
+		return 0;
+	bus = fdt_path_offset(fdt, UKE_REAR_MASTER);
+	legacy = fdt_path_offset(fdt, UKE_CCI0_OEM "/qcom,cam-sensor0");
+	tlmm = fdt_path_offset(fdt, UKE_CCI0_TLMM);
+	camcc = fdt_path_offset(fdt, UKE_CCI0_CAMCC);
+	if (bus < 0 || legacy < 0 || tlmm < 0 || camcc < 0)
+		return 0;
+	cci = fdt_parent_offset(fdt, bus);
+	if (cci < 0 || fdt_node_check_compatible(fdt, cci, "qcom,sm7675-cci") ||
+	    !uke_front_bytes(fdt, cci, "status", "okay", sizeof("okay")) ||
+	    !uke_front_u32(fdt, bus, "reg", 1) ||
+	    !uke_front_u32(fdt, bus, "clock-frequency", 400000) ||
+	    !uke_front_u32(fdt, bus, "#address-cells", 1) ||
+	    !uke_front_u32(fdt, bus, "#size-cells", 0) ||
+	    fdt_first_subnode(fdt, bus) != -FDT_ERR_NOTFOUND ||
+	    fdt_node_check_compatible(fdt, legacy, "qcom,cam-sensor") ||
+	    !uke_front_disabled(fdt, legacy) ||
+	    !uke_front_u32(fdt, legacy, "cell-index", 0) ||
+	    !uke_front_u32(fdt, legacy, "cci-master", 1) ||
+	    !uke_front_u32(fdt, legacy, "csiphy-sd-index", 1) ||
+	    !uke_front_u32(fdt, legacy, "gpio-reset", 1) ||
+	    !uke_front_u32(fdt, legacy, "clock-rates", 19200000) ||
+	    !uke_front_bytes(fdt, legacy, "clock-names", "cam_clk", sizeof("cam_clk")) ||
+	    !uke_front_bytes(fdt, legacy, "pinctrl-names", oem_pins, sizeof(oem_pins)) ||
+	    !uke_front_bytes(fdt, legacy, "regulator-names", supply_names, sizeof(supply_names)) ||
+	    !uke_front_bytes(fdt, legacy, "rgltr-min-voltage", supply_volts, sizeof(supply_volts)) ||
+	    !uke_front_bytes(fdt, legacy, "rgltr-max-voltage", supply_volts, sizeof(supply_volts)) ||
+	    !uke_front_bytes(fdt, legacy, "rgltr-load-current", supply_loads, sizeof(supply_loads)))
+		return 0;
+
+	clock_provider = fdt_get_phandle(fdt, camcc);
+	gpio_provider = fdt_get_phandle(fdt, tlmm);
+	if (!clock_provider || !gpio_provider ||
+	    fdt_node_check_compatible(fdt, camcc, "qcom,sm7675-camcc") ||
+	    fdt_node_check_compatible(fdt, tlmm, "qcom,cliffs-pinctrl") ||
+	    !uke_front_u32(fdt, tlmm, "#gpio-cells", 2))
+		return 0;
+
+	clock[0] = domain[0] = cpu_to_fdt32(clock_provider);
+	clock[1] = cpu_to_fdt32(CAM_CC_MCLK0_CLK);
+	domain[1] = cpu_to_fdt32(CAM_CC_TITAN_TOP_GDSC);
+	reset[0] = legacy_gpios[0] = legacy_gpios[3] = vana_gpio[0] = cpu_to_fdt32(gpio_provider);
+	reset[1] = legacy_gpios[4] = cpu_to_fdt32(14);
+	reset[2] = cpu_to_fdt32(GPIO_ACTIVE_LOW);
+	legacy_gpios[1] = cpu_to_fdt32(64);
+	legacy_gpios[2] = legacy_gpios[5] = 0;
+	vana_gpio[1] = cpu_to_fdt32(79);
+	vana_gpio[2] = 0;
+	if (!uke_front_bytes(fdt, legacy, "clocks", clock, sizeof(clock)) ||
+	    !uke_front_bytes(fdt, legacy, "gpios", legacy_gpios, sizeof(legacy_gpios)))
+		return 0;
+
+	for (i = 0; i < (int)ARRAY_SIZE(pins); i++) {
+		int offset = fdt_subnode_offset(fdt, tlmm, pins[i]);
+		int mux, config;
+		const char *line = i % 2 ? "gpio14" : "gpio64";
+		const char *function = i % 2 ? "gpio" : "cam_mclk";
+		bool output_low = i == 3;
+
+		if (offset < 0)
+			return 0;
+		mux = fdt_subnode_offset(fdt, offset, "mux");
+		config = fdt_subnode_offset(fdt, offset, "config");
+		if (mux < 0 || config < 0 ||
+		    !uke_front_bytes(fdt, mux, "pins", line, strlen(line) + 1) ||
+		    !uke_front_bytes(fdt, mux, "function", function, strlen(function) + 1) ||
+		    !uke_front_bytes(fdt, config, "pins", line, strlen(line) + 1) ||
+		    !uke_front_u32(fdt, config, "drive-strength", i % 2 ? 2 : 4) ||
+		    !uke_front_bytes(fdt, config, i < 2 ? "bias-disable" : "bias-pull-down", "", 0) ||
+		    fdt_getprop(fdt, config, i < 2 ? "bias-pull-down" : "bias-disable", NULL) ||
+		    fdt_getprop(fdt, config, "bias-pull-up", NULL) ||
+		    fdt_getprop(fdt, config, "output-high", NULL) ||
+		    (!!fdt_getprop(fdt, config, "output-low", NULL) != output_low))
+			return 0;
+		pin_refs[i] = cpu_to_fdt32(fdt_get_phandle(fdt, offset));
+		if (!pin_refs[i])
+			return 0;
+	}
+	if (!uke_front_bytes(fdt, legacy, "pinctrl-0", pin_refs, 2 * sizeof(fdt32_t)) ||
+	    !uke_front_bytes(fdt, legacy, "pinctrl-1", &pin_refs[2], 2 * sizeof(fdt32_t)))
+		return 0;
+
+	vana = fdt_path_offset(fdt, UKE_REAR_VANA);
+	if (vana < 0 || fdt_node_check_compatible(fdt, vana, "regulator-fixed") ||
+	    !uke_front_u32(fdt, vana, "regulator-min-microvolt", 2800000) ||
+	    !uke_front_u32(fdt, vana, "regulator-max-microvolt", 2800000) ||
+	    !uke_front_u32(fdt, vana, "regulator-enable-ramp-delay", 100) ||
+	    !uke_front_bytes(fdt, vana, "enable-active-high", "", 0) ||
+	    !uke_front_bytes(fdt, vana, "gpio", vana_gpio, sizeof(vana_gpio)))
+		return 0;
+	for (i = 0; i < (int)ARRAY_SIZE(rails); i++) {
+		int offset = fdt_path_offset(fdt, rails[i].path);
+
+		if (offset < 0 || uke_front_disabled(fdt, offset) ||
+		    !uke_front_bytes(fdt, offset, "regulator-name", rails[i].provider,
+				     strlen(rails[i].provider) + 1))
+			return 0;
+		providers[i] = fdt_get_phandle(fdt, offset);
+		if (!providers[i] || !uke_front_u32(fdt, legacy, rails[i].old_property, providers[i]))
+			return 0;
+	}
+
+	if (fdt_totalsize(fdt) - fdt_off_dt_strings(fdt) - fdt_size_dt_strings(fdt) < 1024)
+		return 0;
+	node = fdt_add_subnode(fdt, bus, "camera@10");
+	if (node < 0)
+		return node;
+	if ((ret = fdt_setprop_string(fdt, node, "status", "disabled")) ||
+	    (ret = fdt_setprop_string(fdt, node, "compatible", "xiaomi,uke-rear-camera-identify")) ||
+	    (ret = fdt_setprop_u32(fdt, node, "reg", 0x10)) ||
+	    (ret = fdt_setprop(fdt, node, "reset-gpios", reset, sizeof(reset))) ||
+	    (ret = fdt_setprop(fdt, node, "clocks", clock, sizeof(clock))) ||
+	    (ret = fdt_setprop_string(fdt, node, "clock-names", "xclk")) ||
+	    (ret = fdt_setprop(fdt, node, "pinctrl-names", pin_names, sizeof(pin_names))) ||
+	    (ret = fdt_setprop(fdt, node, "pinctrl-0", pin_refs, 2 * sizeof(fdt32_t))) ||
+	    (ret = fdt_setprop(fdt, node, "pinctrl-1", &pin_refs[2], 2 * sizeof(fdt32_t))))
+		return ret;
+	for (i = 0; i < (int)ARRAY_SIZE(rails); i++) {
+		ret = fdt_setprop_u32(fdt, node, rails[i].new_property, providers[i]);
+		if (ret)
+			return ret;
+	}
+	anchor = fdt_add_subnode(fdt, node, "camera-clock-domain");
+	if (anchor < 0)
+		return anchor;
+	ret = fdt_setprop(fdt, anchor, "power-domains", domain, sizeof(domain));
+	if (ret)
+		return ret;
+	return fdt_setprop_string(fdt, node, "status", "okay");
+}
+
+#endif
diff --git a/after/drivers/media/i2c/uke-camera-sensor-clock.h b/after/drivers/media/i2c/uke-camera-sensor-clock.h
new file mode 100644
index 0000000..e8a41e1
--- /dev/null
+++ b/after/drivers/media/i2c/uke-camera-sensor-clock.h
@@ -0,0 +1,212 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef UKE_CAMERA_SENSOR_CLOCK_H
+#define UKE_CAMERA_SENSOR_CLOCK_H
+
+#include <dt-bindings/clock/qcom,sm7675-camcc.h>
+#include <linux/clk.h>
+#include <linux/device.h>
+#include <linux/device/driver.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+#include <linux/pm_runtime.h>
+#include <linux/property.h>
+#include <linux/slab.h>
+#include <linux/soc/qcom/sm7675-camcc.h>
+
+#define UKE_CAMERA_MCLK_HZ 19200000UL
+
+struct uke_camera_sensor_clock {
+	struct platform_device *anchor;
+	struct device *domain;
+	struct clk *mclk;
+	bool domain_held;
+	bool enabled;
+};
+
+/* Called by a permanent driver, with the sensor's power lock held. */
+static int uke_camera_sensor_clock_off(struct uke_camera_sensor_clock *clock)
+{
+	int ret;
+
+	if (clock->enabled) {
+		clk_disable_unprepare(clock->mclk);
+		clk_rate_exclusive_put(clock->mclk);
+		clock->enabled = false;
+	}
+	if (!clock->domain_held)
+		return 0;
+
+	ret = pm_runtime_put_sync_suspend(clock->domain);
+	if (ret < 0) {
+		/* The failed put consumed the count but did not prove suspension. */
+		pm_runtime_get_noresume(clock->domain);
+		return ret;
+	}
+	clock->domain_held = false;
+	return 0;
+}
+
+static int uke_camera_sensor_clock_on(struct uke_camera_sensor_clock *clock)
+{
+	int ret, cleanup;
+
+	if (clock->enabled || clock->domain_held)
+		return -EBUSY;
+
+	ret = qcom_sm7675_camcc_status();
+	if (ret)
+		return ret;
+	ret = pm_runtime_resume_and_get(clock->domain);
+	if (ret < 0)
+		return ret;
+	clock->domain_held = true;
+	ret = qcom_sm7675_camcc_status();
+	if (ret)
+		goto put_domain;
+
+	ret = clk_set_rate_exclusive(clock->mclk, UKE_CAMERA_MCLK_HZ);
+	if (ret)
+		goto put_domain;
+	if (clk_get_rate(clock->mclk) != UKE_CAMERA_MCLK_HZ) {
+		ret = -ERANGE;
+		goto put_rate;
+	}
+	ret = clk_prepare_enable(clock->mclk);
+	if (ret)
+		goto put_rate;
+	clock->enabled = true;
+	return 0;
+
+put_rate:
+	clk_rate_exclusive_put(clock->mclk);
+put_domain:
+	cleanup = uke_camera_sensor_clock_off(clock);
+	return cleanup ?: ret;
+}
+
+static void uke_camera_sensor_clock_release(void *data)
+{
+	struct uke_camera_sensor_clock *clock = data;
+	struct device *domain;
+
+	if (clock->enabled || clock->domain_held) {
+		dev_err(&clock->anchor->dev, "camera clock ownership retained until reboot\n");
+		return;
+	}
+
+	/* Hold the object while generic GenPD removes and unregisters it. */
+	domain = get_device(clock->domain);
+	dev_pm_domain_detach(domain, true);
+	if (domain->pm_domain) {
+		dev_err(&clock->anchor->dev, "camera domain detach failed\n");
+		put_device(domain);
+		return;
+	}
+	put_device(domain);
+	platform_device_unregister(clock->anchor);
+	kfree(clock);
+}
+
+static int uke_camera_sensor_clock_graph(struct device_node *sensor,
+					struct device_node *anchor, unsigned int expected_mclk)
+{
+	struct of_phandle_args pd, clk;
+	int ret;
+
+	if (of_property_present(sensor, "power-domains") ||
+	    of_property_present(anchor, "compatible") ||
+	    of_property_present(anchor, "required-opps") ||
+	    of_count_phandle_with_args(anchor, "power-domains", "#power-domain-cells") != 1 ||
+	    of_count_phandle_with_args(sensor, "clocks", "#clock-cells") != 1 ||
+	    of_property_match_string(sensor, "clock-names", "xclk") != 0)
+		return -EINVAL;
+
+	ret = of_parse_phandle_with_args(anchor, "power-domains",
+					"#power-domain-cells", 0, &pd);
+	if (ret)
+		return ret;
+	ret = of_parse_phandle_with_args(sensor, "clocks", "#clock-cells", 0, &clk);
+	if (!ret) {
+		if (pd.args_count != 1 || pd.args[0] != CAM_CC_TITAN_TOP_GDSC ||
+		    clk.args_count != 1 || clk.args[0] != expected_mclk ||
+		    clk.np != pd.np || !of_device_is_compatible(pd.np, "qcom,sm7675-camcc"))
+			ret = -EINVAL;
+		of_node_put(clk.np);
+	}
+	of_node_put(pd.np);
+	return ret;
+}
+
+/*
+ * Give GenPD a separate firmware device so I2C can probe with the domain off.
+ * The virtual GenPD device has no runtime-PM dependency on the sensor itself.
+ */
+static struct uke_camera_sensor_clock *
+uke_camera_sensor_clock_get(struct device *sensor, unsigned int expected_mclk,
+			    const char *anchor_name)
+{
+	struct uke_camera_sensor_clock *clock;
+	struct device_node *node;
+	struct platform_device *anchor;
+	int ret;
+
+	if (!of_machine_is_compatible("xiaomi,uke") || !sensor->of_node ||
+	    of_node_check_flag(sensor->of_node, OF_DYNAMIC) ||
+	    !sensor->driver || sensor->driver->owner ||
+	    !sensor->driver->suppress_bind_attrs)
+		return ERR_PTR(-EINVAL);
+
+	node = of_get_child_by_name(sensor->of_node, "camera-clock-domain");
+	if (!node)
+		return ERR_PTR(-EINVAL);
+	ret = uke_camera_sensor_clock_graph(sensor->of_node, node, expected_mclk);
+	if (ret)
+		goto put_node;
+	ret = qcom_sm7675_camcc_status();
+	if (ret)
+		goto put_node;
+
+	clock = kzalloc_obj(*clock);
+	if (!clock) {
+		ret = -ENOMEM;
+		goto put_node;
+	}
+	clock->mclk = devm_clk_get(sensor, "xclk");
+	if (IS_ERR(clock->mclk)) {
+		ret = PTR_ERR(clock->mclk);
+		goto free_clock;
+	}
+	anchor = platform_device_alloc(anchor_name, PLATFORM_DEVID_AUTO);
+	if (!anchor) {
+		ret = -ENOMEM;
+		goto free_clock;
+	}
+	device_set_node(&anchor->dev, fwnode_handle_get(of_fwnode_handle(node)));
+	ret = platform_device_add(anchor);
+	if (ret) {
+		platform_device_put(anchor);
+		goto free_clock;
+	}
+	clock->anchor = anchor;
+	clock->domain = dev_pm_domain_attach_by_id(&anchor->dev, 0);
+	if (IS_ERR_OR_NULL(clock->domain)) {
+		ret = clock->domain ? PTR_ERR(clock->domain) : -ENODEV;
+		platform_device_unregister(anchor);
+		goto free_clock;
+	}
+
+	of_node_put(node);
+	ret = devm_add_action_or_reset(sensor, uke_camera_sensor_clock_release, clock);
+	if (ret)
+		return ERR_PTR(ret);
+	return clock;
+
+free_clock:
+	kfree(clock);
+put_node:
+	of_node_put(node);
+	return ERR_PTR(ret);
+}
+
+#endif
