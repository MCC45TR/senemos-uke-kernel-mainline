-		return ret;
-	ret = pm_runtime_resume_and_get(clock->domain);
-	if (ret < 0)
-		return ret;
-	clock->domain_held = true;
-	ret = qcom_sm7675_camcc_status();
-	if (ret)
-		goto put_domain;
-
-	ret = clk_set_rate_exclusive(clock->mclk, UKE_FRONT_MCLK_HZ);
-	if (ret)
-		goto put_domain;
-	if (clk_get_rate(clock->mclk) != UKE_FRONT_MCLK_HZ) {
