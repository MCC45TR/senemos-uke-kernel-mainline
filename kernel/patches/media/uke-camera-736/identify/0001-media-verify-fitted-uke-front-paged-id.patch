+/*
+ * The fitted OEM profile matches 0x5647 using a two-byte address, but
+ * uses paged byte commands to configure the sensor. Check the public
+ * OV08D10 identity sequence only after the OEM match in this power cycle.
+ */
+static int uke_front_sensor_paged_id(struct i2c_client *client, u16 *id)
+{
+	u16 oem_id;
+	int high, low, ret;
+
+	ret = uke_front_sensor_oem_id(client, &oem_id);
+	if (ret)
+		return ret;
+	if (oem_id != 0x5647)
+		return -ENODEV;
+
+	ret = i2c_smbus_write_byte_data(client, 0xfd, 0);
+	if (ret < 0)
+		return ret;
+	high = i2c_smbus_read_byte_data(client, 0);
+	if (high < 0)
+		return high;
+	low = i2c_smbus_read_byte_data(client, 1);
+	if (low < 0)
+		return low;
+
+	*id = (high << 8) | low;
+	return 0;
+}
