diff --git a/after/arch/arm64/kernel/uke-camera-stream-dt.h b/after/arch/arm64/kernel/uke-camera-stream-dt.h
new file mode 100644
index 0000000..ae96465
--- /dev/null
+++ b/after/arch/arm64/kernel/uke-camera-stream-dt.h
@@ -0,0 +1,147 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef UKE_CAMERA_STREAM_DT_H
+#define UKE_CAMERA_STREAM_DT_H
+
+#define UKE_STREAM_CAMSS "/soc/" UKE_CAMSS_NATIVE
+#define UKE_REAR_STREAM_SENSOR "/soc/i2c@ac15000/i2c-bus@1/camera@10"
+#define UKE_FRONT_STREAM_SENSOR UKE_FRONT_BUS "/camera@10"
+#define UKE_REAR_STREAM_COMPATIBLE "xiaomi,uke-ov13b10"
+#define UKE_REAR_ID_COMPATIBLE "xiaomi,uke-rear-camera-identify"
+#define UKE_FRONT_STREAM_COMPATIBLE "xiaomi,uke-ov08d10"
+#define UKE_FRONT_ID_COMPATIBLE "xiaomi,uke-front-camera-identify"
+#define UKE_CSI2_DPHY 4
+#define UKE_CAMERA_STREAM_RESERVE 2048
+
+struct uke_camera_stream_route {
+	const char *sensor;
+	const char *identity;
+	const char *compatible;
+	const char *port;
+	unsigned int phy;
+	unsigned int lanes;
+	unsigned int rotation;
+	unsigned int orientation;
+	unsigned int frequency_count;
+	unsigned int frequencies[2];
+};
+
+static const struct uke_camera_stream_route uke_camera_stream_routes[] = {
+	{ UKE_REAR_STREAM_SENSOR, UKE_REAR_ID_COMPATIBLE, UKE_REAR_STREAM_COMPATIBLE,
+	  "port@1", 1, 4, 90, 1, 1, { 560000000 } },
+	{ UKE_FRONT_STREAM_SENSOR, UKE_FRONT_ID_COMPATIBLE, UKE_FRONT_STREAM_COMPATIBLE,
+	  "port@4", 4, 2, 270, 0, 2, { 360000000, 720000000 } },
+};
+
+static bool UKE_INIT uke_camera_stream_sensor(const void *fdt,
+					      const struct uke_camera_stream_route *route)
+{
+	int node = fdt_path_offset(fdt, route->sensor);
+
+	return uke_camss_available(fdt, node) &&
+	       uke_front_bytes(fdt, node, "compatible", route->identity,
+			       strlen(route->identity) + 1) &&
+	       uke_front_u32(fdt, node, "reg", 0x10) &&
+	       fdt_subnode_offset(fdt, node, "port") == -FDT_ERR_NOTFOUND &&
+	       fdt_subnode_offset(fdt, node, "ports") == -FDT_ERR_NOTFOUND &&
+	       !fdt_getprop(fdt, node, "orientation", NULL) &&
+	       !fdt_getprop(fdt, node, "rotation", NULL);
+}
+
+static int UKE_INIT uke_camera_stream_endpoint(void *fdt, int port,
+					       const struct uke_camera_stream_route *route,
+					       unsigned int phandle, unsigned int remote,
+					       bool sensor)
+{
+	const fdt32_t lanes[] = { 0, cpu_to_fdt32(1), cpu_to_fdt32(2), cpu_to_fdt32(3) };
+	fdt64_t frequencies[ARRAY_SIZE(route->frequencies)];
+	unsigned int i;
+	int node, ret;
+
+	node = fdt_add_subnode(fdt, port, "endpoint");
+	if (node < 0)
+		return node;
+	if ((ret = fdt_setprop_u32(fdt, node, "phandle", phandle)) ||
+	    (ret = fdt_setprop_u32(fdt, node, "remote-endpoint", remote)) ||
+	    (ret = fdt_setprop_u32(fdt, node, "bus-type", UKE_CSI2_DPHY)))
+		return ret;
+
+	/* The SM7675 PHY numbers data wires separately from its dedicated clock. */
+	ret = fdt_setprop(fdt, node, "data-lanes", lanes, route->lanes * sizeof(*lanes));
+	if (ret || !sensor)
+		return ret;
+	for (i = 0; i < route->frequency_count; i++)
+		frequencies[i] = cpu_to_fdt64(route->frequencies[i]);
+	return fdt_setprop(fdt, node, "link-frequencies", frequencies,
+			   route->frequency_count * sizeof(*frequencies));
+}
+
+static int UKE_INIT uke_camera_stream_route(void *fdt,
+					   const struct uke_camera_stream_route *route,
+					   unsigned int phandle)
+{
+	int ports, port, sensor, ret;
+
+	ports = fdt_path_offset(fdt, UKE_STREAM_CAMSS "/ports");
+	port = fdt_add_subnode(fdt, ports, route->port);
+	if (port < 0)
+		return port;
+	if ((ret = fdt_setprop_u32(fdt, port, "reg", route->phy)) ||
+	    (ret = uke_camera_stream_endpoint(fdt, port, route, phandle, phandle + 1, false)))
+		return ret;
+
+	sensor = fdt_path_offset(fdt, route->sensor);
+	port = fdt_add_subnode(fdt, sensor, "port");
+	if (port < 0)
+		return port;
+	if ((ret = uke_camera_stream_endpoint(fdt, port, route, phandle + 1, phandle, true)) ||
+	    (ret = fdt_setprop_u32(fdt, sensor, "orientation", route->orientation)) ||
+	    (ret = fdt_setprop_u32(fdt, sensor, "rotation", route->rotation)))
+		return ret;
+
+	return fdt_setprop_string(fdt, sensor, "compatible", route->compatible);
+}
+
+static int UKE_INIT uke_camera_stream_graph(void *fdt, bool rear, bool front)
+{
+	bool wanted[] = { rear, front };
+	unsigned int i, enabled = 0;
+	int camss, ports, ret;
+	uint32_t phandle;
+
+	if (fdt_node_check_compatible(fdt, 0, "xiaomi,uke") ||
+	    fdt_node_check_compatible(fdt, 0, "qcom,sm7675"))
+		return 0;
+	camss = fdt_path_offset(fdt, UKE_STREAM_CAMSS);
+	if (!uke_camss_available(fdt, camss) ||
+	    !uke_front_bytes(fdt, camss, "compatible", "qcom,sm7675-camss",
+			     sizeof("qcom,sm7675-camss")) ||
+	    fdt_subnode_offset(fdt, camss, "ports") != -FDT_ERR_NOTFOUND ||
+	    fdt_totalsize(fdt) - fdt_off_dt_strings(fdt) - fdt_size_dt_strings(fdt) <
+	    UKE_CAMERA_STREAM_RESERVE)
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(wanted); i++) {
+		wanted[i] = wanted[i] && uke_camera_stream_sensor(fdt, &uke_camera_stream_routes[i]);
+		enabled += wanted[i];
+	}
+	if (!enabled || fdt_generate_phandle(fdt, &phandle) ||
+	    phandle > FDT_MAX_PHANDLE - (2 * enabled - 1))
+		return 0;
+
+	ports = fdt_add_subnode(fdt, camss, "ports");
+	if (ports < 0)
+		return ports;
+	if ((ret = fdt_setprop_u32(fdt, ports, "#address-cells", 1)) ||
+	    (ret = fdt_setprop_u32(fdt, ports, "#size-cells", 0)))
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(wanted); i++) {
+		if (!wanted[i])
+			continue;
+		ret = uke_camera_stream_route(fdt, &uke_camera_stream_routes[i], phandle);
+		if (ret)
+			return ret;
+		phandle += 2;
+	}
+	return 0;
+}
+
+#endif
