+		.pm = pm_ptr(&ov08d10_uke_pm_ops),
+		.suppress_bind_attrs = true,
+	},
+	.probe = ov08d10_probe,
+	.remove = ov08d10_remove,
+	.shutdown = ov08d10_uke_shutdown,
+};
+builtin_i2c_driver(ov08d10_uke_driver);
+#endif
