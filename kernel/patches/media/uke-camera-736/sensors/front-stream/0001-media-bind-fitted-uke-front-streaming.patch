+static int __maybe_unused ov08d10_uke_system_suspend(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov08d10 *ov08d10 = to_ov08d10(sd);
+	int ret;
+
+	if (!sd->ctrl_handler)
+		return READ_ONCE(ov08d10->uke_power->fault);
+	mutex_lock(&ov08d10->mutex);
+	ret = ov08d10->uke_power->fault;
+	if (!ret)
+		ret = ov08d10->uke_streaming ? -EBUSY : pm_runtime_force_suspend(dev);
+	mutex_unlock(&ov08d10->mutex);
+	return ret;
+}
+
+static void ov08d10_uke_shutdown(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	int ret;
+
+	if (!sd->ctrl_handler)
+		return;
+	ret = ov08d10_set_stream(sd, 0);
+	if (ret)
+		dev_err(&client->dev, "front camera shutdown: %d\n", ret);
+}
+
+static const struct dev_pm_ops ov08d10_uke_pm_ops = {
+	SET_RUNTIME_PM_OPS(ov08d10_power_off, ov08d10_power_on, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(ov08d10_uke_system_suspend, pm_runtime_force_resume)
+};
