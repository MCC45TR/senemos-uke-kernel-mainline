diff --git a/after/drivers/media/i2c/uke-front-camera-resources.h b/after/drivers/media/i2c/uke-front-camera-resources.h
new file mode 100644
index 0000000..5fa77fa
--- /dev/null
+++ b/after/drivers/media/i2c/uke-front-camera-resources.h
@@ -0,0 +1,76 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef UKE_FRONT_CAMERA_RESOURCES_H
+#define UKE_FRONT_CAMERA_RESOURCES_H
+
+#include <linux/of_address.h>
+
+#include "uke-front-sensor-power.h"
+
+static const struct {
+	const char *name;
+	const char *property;
+	const char *provider;
+} uke_front_supplies[UKE_FRONT_RAIL_COUNT] = {
+	[UKE_FRONT_BOB] = { "bob", "bob-supply", "pmxr2230_bob" },
+	[UKE_FRONT_CUSTOM] = { "custom", "custom-supply", "pmxr2230_s2" },
+	[UKE_FRONT_VIO] = { "vio", "vio-supply", "pmxr2230_l20" },
+	[UKE_FRONT_VANA] = { "vana", "vana-supply", "camera_front_avdd_ldo" },
+	[UKE_FRONT_VDIG] = { "vdig", "vdig-supply", "pm_v6c_l3" },
+};
+
+static int uke_front_camera_check_bus(struct i2c_client *client)
+{
+	struct device_node *bus = of_get_parent(client->dev.of_node);
+	struct resource registers;
+	bool matched;
+
+	matched = bus && client->addr == 0x10 &&
+		  !(client->flags & I2C_CLIENT_TEN) &&
+		  i2c_check_functionality(client->adapter, I2C_FUNC_I2C) &&
+		  of_device_is_compatible(bus, "qcom,geni-i2c") &&
+		  !of_address_to_resource(bus, 0, &registers) &&
+		  registers.start == 0x880000;
+	of_node_put(bus);
+	return matched ? 0 : -ENODEV;
+}
+
+static int uke_front_camera_get_supplies(struct uke_front_sensor_power *power)
+{
+	struct device *dev = power->sensor;
+	struct device_node *node, *supply;
+	const char *name;
+	unsigned int i;
+	bool matched;
+
+	node = dev->of_node;
+	for (i = 0; i < UKE_FRONT_RAIL_COUNT; i++) {
+		if (of_property_count_u32_elems(node, uke_front_supplies[i].property) != 1)
+			return -EINVAL;
+		supply = of_parse_phandle(node, uke_front_supplies[i].property, 0);
+		if (!supply)
+			return -EINVAL;
+		matched = !of_property_read_string(supply, "regulator-name", &name) &&
+			  !strcmp(name, uke_front_supplies[i].provider);
+		of_node_put(supply);
+		if (!matched)
+			return -EINVAL;
+		power->supplies[i] = devm_regulator_get_optional(dev, uke_front_supplies[i].name);
+		if (IS_ERR(power->supplies[i]))
+			return PTR_ERR(power->supplies[i]);
+	}
+	return 0;
+}
+
+static int uke_front_camera_get_resources(struct uke_front_sensor_power *power)
+{
+	int ret;
+
+	ret = uke_front_camera_get_supplies(power);
