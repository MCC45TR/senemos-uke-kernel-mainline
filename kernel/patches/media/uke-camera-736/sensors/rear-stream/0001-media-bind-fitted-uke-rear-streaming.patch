+#ifdef OV13B10_UKE
+static int __maybe_unused ov13b10_uke_system_suspend(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct ov13b10 *ov13b = to_ov13b10(sd);
+	int ret;
+
+	if (!sd->ctrl_handler)
+		return READ_ONCE(ov13b->uke_power->fault);
+
+	mutex_lock(&ov13b->mutex);
+	ret = ov13b->uke_power->fault;
+	if (!ret)
+		ret = ov13b->uke_streaming ? -EBUSY : pm_runtime_force_suspend(dev);
+	mutex_unlock(&ov13b->mutex);
+	return ret;
+}
+
+static void ov13b10_uke_shutdown(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	int ret;
+
+	if (!sd->ctrl_handler)
+		return;
+	ret = ov13b10_set_stream(sd, 0);
+	if (ret)
+		dev_err(&client->dev, "rear camera shutdown: %d\n", ret);
+}
+
+static const struct dev_pm_ops ov13b10_uke_pm_ops = {
+	SET_RUNTIME_PM_OPS(ov13b10_suspend, ov13b10_resume, NULL)
+	SET_SYSTEM_SLEEP_PM_OPS(ov13b10_uke_system_suspend, pm_runtime_force_resume)
+};
+
+static const struct of_device_id ov13b10_uke_of_match[] = {
+	{ .compatible = "xiaomi,uke-ov13b10" },
+	{ }
+};
+
+static struct i2c_driver ov13b10_uke_driver = {
+	.driver = {
+		.name = "uke-ov13b10",
+		.of_match_table = ov13b10_uke_of_match,
+		.pm = pm_ptr(&ov13b10_uke_pm_ops),
+		.suppress_bind_attrs = true,
+	},
+	.probe = ov13b10_probe,
+	.remove = ov13b10_remove,
+	.shutdown = ov13b10_uke_shutdown,
+};
+builtin_i2c_driver(ov13b10_uke_driver);
+#endif
+
 MODULE_AUTHOR("Kao, Arec <arec.kao@intel.com>");
 MODULE_DESCRIPTION("Omnivision ov13b10 sensor driver");
 MODULE_LICENSE("GPL v2");
