+static bool dpu_crtc_gamma_is_identity(const struct drm_property_blob *blob)
+{
+	const struct drm_color_lut *lut = blob->data;
+	unsigned int i;
+
+	if (blob->length != DPU_GAMMA_LUT_SIZE * sizeof(*lut))
+		return false;
+
+	/* The PGC stores one 10-bit result for each 10-bit input. */
+	for (i = 0; i < DPU_GAMMA_LUT_SIZE; i++) {
+		if (drm_color_lut_extract(lut[i].red, 10) != i ||
+		    drm_color_lut_extract(lut[i].green, 10) != i ||
+		    drm_color_lut_extract(lut[i].blue, 10) != i)
+			return false;
+	}
+
+	return true;
+}
