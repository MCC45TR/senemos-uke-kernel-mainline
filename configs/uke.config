# Uke/SM7675 source-build candidate. Hardware acceptance remains untested.
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_CLIFFS=y
CONFIG_SM_GCC_CLIFFS=y
CONFIG_QCOM_GDSC_REGULATOR_UKE=y
CONFIG_INTERCONNECT_QCOM_CLIFFS_USB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMH_UKE=y
CONFIG_REGULATOR_QCOM_RPMH_UKE=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_I2C_QCOM_GENI=m
CONFIG_QCOM_GPI_DMA=m
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=m
CONFIG_USB_PHY_QCOM_UKE=m
CONFIG_USB_REPEATER=y
CONFIG_USB_REPEATER_QCOM_UKE=m
CONFIG_USB_WCD939X_UKE=y
CONFIG_USB_G_SERIAL=m
CONFIG_USB_F_ACM=m
CONFIG_USB_F_SERIAL=m
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
