# Uke SM7675 / Linux 7.3.1: experimental scheduling and memory profile.
# Not part of the source-locked native release image until separately qualified.
# EEVDF is the upstream fair scheduler; there is no CONFIG_EEVDF switch.
# ARM64 compatible toolchain: ARCH=arm64 LLVM=1 LLVM_IAS=1.
# Avoid whole-kernel -march / -mcpu flags; ARM64 cpufeature alternatives remain enabled.

CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y

CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ENERGY_MODEL=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y

CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# sched_ext and CO-RE BPF prerequisites
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_JIT_DEFAULT_ON=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_NONE is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FUNCTION_TRACER=y

# Preserve the current source-locked build's LTO selection in this first cohort.
# Test ThinLTO in an independent follow-up cohort.
CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_LTO_CLANG_FULL is not set
