+int qcom_uke_dsi_abm_register(struct mipi_dsi_device *dsi,
+		struct drm_panel *panel,
+		int (*apply)(struct drm_panel *panel, unsigned int level))
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	int ret = 0;
+
+	if (!dsi || !panel || !master || !master->host ||
+	    dsi->host != master->host || !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
+	    !of_machine_is_compatible("xiaomi,uke") ||
+	    !of_machine_is_compatible("qcom,sm7675") ||
+	    (!of_device_is_compatible(dsi->dev.of_node, "xiaomi,o82-42-02-0b") &&
+	     !of_device_is_compatible(dsi->dev.of_node, "xiaomi,o82-36-02-0a")))
+		return -EOPNOTSUPP;
+	mutex_lock(&uke_dfps_panel_lock);
+	if (msm_dsim_glb.uke_abm_panel && msm_dsim_glb.uke_abm_panel != panel) {
+		ret = -EBUSY;
+	} else {
+		msm_dsim_glb.uke_abm_panel = apply ? panel : NULL;
+		msm_dsim_glb.uke_abm_apply = apply;
+	}
+	mutex_unlock(&uke_dfps_panel_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_uke_dsi_abm_register);
+
+int msm_dsi_manager_uke_abm_apply(struct drm_encoder *encoder, unsigned int level)
+{
+	struct drm_bridge *bridge = drm_bridge_chain_get_first_bridge(encoder);
+	struct dsi_bridge *b;
+	int ret = -EOPNOTSUPP;
+
+	if (level > 4)
+		goto out;
+	if (!bridge || bridge->funcs != &dsi_mgr_bridge_funcs ||
+	    !IS_BONDED_DSI() || !IS_SYNC_NEEDED())
+		goto out;
+	b = to_dsi_bridge(bridge);
+	mutex_lock(&uke_dfps_panel_lock);
+	if (IS_MASTER_DSI_LINK(b->id) && b->powered && b->video_enabled &&
+	    b->o82_panel && msm_dsim_glb.uke_abm_panel == b->o82_panel &&
+	    msm_dsim_glb.uke_abm_apply && !msm_dsi_manager_uke_dfps_failed())
+		ret = msm_dsim_glb.uke_abm_apply(b->o82_panel, level);
+	mutex_unlock(&uke_dfps_panel_lock);
+out:
+	drm_bridge_put(bridge);
+	return ret;
+}
+
