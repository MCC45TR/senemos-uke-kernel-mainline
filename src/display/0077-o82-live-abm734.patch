+static int o82_abm_apply_locked(struct o82_panel *ctx, unsigned int level)
+{
+	int ret = 0, rollback;
+
+	lockdep_assert_held(&ctx->abm_lock);
+	if (level > 4)
+		return -EINVAL;
+	if (!ctx->abm_valid)
+		return -EIO;
+	if (level == ctx->applied_abm_level)
+		return 0;
+	ret = o82_apply_abm(ctx, level);
+	if (!ret) {
+		ctx->applied_abm_level = level;
+	} else {
+		/* One bounded restore; never reset or blank the running panel. */
+		rollback = o82_apply_abm(ctx, ctx->applied_abm_level);
+		if (rollback) {
+			ctx->abm_valid = false;
+			dev_err(&ctx->dsi[0]->dev,
+				"O82 ABM restore failed: %d; updates wait for next prepare\n",
+				rollback);
+		}
+	}
+	return ret;
+}
+
+static int o82_abm_update(struct drm_panel *panel, unsigned int level)
+{
+	struct o82_panel *ctx = container_of(panel, struct o82_panel, panel);
+	int ret = 0;
+
+	if (level > 4)
+		return -EINVAL;
+	mutex_lock(&ctx->lock);
+	if (ctx->removing || ctx->gesture_retained) {
+		ret = -ESHUTDOWN;
+		goto out;
+	}
+	if (!ctx->prepared) {
+		ret = -EHOSTDOWN;
+		goto out;
+	}
+	mutex_lock(&ctx->abm_lock);
+	ctx->requested_abm_level = level;
+	/* The existing first-frame worker owns commands until it marks ready. */
+	if (atomic64_read(&ctx->touch_state) & 1)
+		ret = o82_abm_apply_locked(ctx, level);
+	mutex_unlock(&ctx->abm_lock);
+out:
+	mutex_unlock(&ctx->lock);
+	return ret;
+}
+
+static void o82_abm_first_frame_complete(struct o82_panel *ctx)
+{
+	int ret;
+
+	/* Disable holds ctx->lock while canceling work; never take it here. */
+	mutex_lock(&ctx->abm_lock);
+	ret = o82_abm_apply_locked(ctx, ctx->requested_abm_level);
+	if (ret)
+		dev_err(&ctx->dsi[0]->dev, "O82 deferred ABM update failed: %d\n", ret);
+	o82_touch_state(ctx, false, true);
+	mutex_unlock(&ctx->abm_lock);
+}
