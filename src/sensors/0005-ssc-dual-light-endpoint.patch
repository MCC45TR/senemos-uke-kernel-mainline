From: Uke contributors
Subject: [PATCH] iio: uke-ssc: add a board-linked dual-light IIO endpoint

Retain raw channels and existing QMI admission. Share native streams,
select rear-only under a verified closed lid and use passive input events
for lifecycle changes without a new polling task.

--- a/drivers/iio/common/uke-ssc/uke-ssc-iio.c
+++ b/drivers/iio/common/uke-ssc/uke-ssc-iio.c
@@ -8,6 +8,7 @@
 #include <linux/iio/buffer.h>
 #include <linux/iio/iio.h>
 #include <linux/iio/kfifo_buf.h>
+#include <linux/input.h>
 #include <linux/jiffies.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
@@ -21,6 +22,7 @@
 #include <linux/sysfs.h>
 #include <linux/workqueue.h>
 #include "uke-ssc-protocol.h"
+#include "uke-ssc-dual-light.h"
 
 #define SSC_SERVICE 400
 #define SSC_TIMEOUT msecs_to_jiffies(5000)
@@ -30,6 +32,8 @@
 #define SSC_REPORT_TYPE_LARGE 1
 #define SSC_QMI_REPORT_MAX (UKE_SSC_MESSAGE_MAX + 16)
 #define SSC_SENSOR_COUNT 8
+#define SSC_FRONT_LIGHT 3
+#define SSC_REAR_LIGHT 4
 
 /* Separate consumers of one SSC SUID, serialized by controller->control. */
 enum ssc_stream_user {
@@ -84,6 +88,23 @@
 	struct sockaddr_qrtr address;
 };
 
+struct ssc_dual_light {
+	struct iio_dev *iio;
+	struct iio_chan_spec channel[2];
+	struct device_node *lid_node;
+	struct input_handler lid_handler;
+	struct uke_ssc_light_pair pair;
+	u64 epoch, lid_revision, front_floor_sequence;
+	struct completion sample_done;
+	u64 result_sequence;
+	s64 result;
+	int error;
+	bool registered, handler_registered, connected;
+	bool buffered, buffer_fault, reset_pending;
+	bool direct, result_valid;
+	bool lid_known, lid_closed, front_needs_fresh;
+};
+
 enum ssc_failure_stage {
 	SSC_FAILURE_NONE, SSC_FAILURE_CLIENT, SSC_FAILURE_LOOKUP,
 	SSC_FAILURE_ATTRIBUTES, SSC_FAILURE_REGISTRATION,
@@ -108,6 +129,7 @@
 	struct list_head endpoints;
 	struct sockaddr_qrtr peer;
 	struct ssc_sensor sensor[SSC_SENSOR_COUNT];
+	struct ssc_dual_light dual;
 	unsigned int endpoint_count;
 	u64 generation, client_generation;
 	u64 client_id;
@@ -294,6 +316,18 @@
 		queue_work(c->workqueue, &c->reconcile);
 }
 
+static void ssc_dual_reset_locked(struct ssc_controller *c, int error)
+{
+	struct ssc_dual_light *d = &c->dual;
+
+	uke_ssc_light_end(&d->pair);
+	d->reset_pending = true;
+	d->result_valid = false;
+	d->result = 0;
+	d->error = error;
+	complete_all(&d->sample_done);
+}
+
 static void ssc_invalidate_locked(struct ssc_controller *c)
 {
 	unsigned int i;
@@ -302,6 +336,7 @@
 	c->last_discovery_error = 0;
 	c->last_discovery_stage = SSC_FAILURE_NONE;
 	c->pending_sample_valid = false;
+	ssc_dual_reset_locked(c, -ENOTCONN);
 	memset(c->pending_sample, 0, sizeof(c->pending_sample));
 	for (i = 0; i < SSC_SENSOR_COUNT; i++) {
 		struct ssc_sensor *s = &c->sensor[i];
@@ -375,6 +410,8 @@
 	spin_unlock_irqrestore(&c->state, flags);
 }
 
+static void ssc_dual_feed_locked(struct ssc_sensor *s);
+
 /* The caller holds c->state; values have passed the sensor's exact API decoder. */
 static void ssc_publish_locked(struct ssc_sensor *s, const s64 value[3], u64 ticks)
 {
@@ -392,6 +429,15 @@
 		iio_push_to_buffers_with_ts(s->iio, scan, sizeof(scan), iio_get_time_ns(s->iio));
 	}
 	complete(&s->sample_done);
+	ssc_dual_feed_locked(s);
+	/* Coalesce acquisition events in the existing serialized worker. It
+	 * performs no new request when the demanded streams are unchanged.
+	 */
+	if ((s == &s->controller->sensor[SSC_FRONT_LIGHT] ||
+	     s == &s->controller->sensor[SSC_REAR_LIGHT]) &&
+	    (s->controller->dual.direct || s->controller->dual.buffered) &&
+	    s->controller->dual.reset_pending && !s->controller->dual.buffer_fault)
+		ssc_schedule_locked(s->controller);
 }
 
 static void ssc_response(struct qmi_handle *qmi, struct sockaddr_qrtr *peer,
@@ -652,6 +698,8 @@
 				memset(c->pending_sample, 0, sizeof(c->pending_sample));
 			}
 			if (event->message == 128) {
+				if (i == SSC_FRONT_LIGHT || i == SSC_REAR_LIGHT)
+					ssc_dual_reset_locked(c, -EAGAIN);
 				ret = uke_ssc_decode_attributes(event->payload, s->description->datatype,
 							 s->description->api, &attributes);
 				s->ready = false;
@@ -673,6 +721,13 @@
 				continue;
 			}
 			if (event->message == 130) {
+				if (i == SSC_FRONT_LIGHT || i == SSC_REAR_LIGHT) {
+					ssc_dual_reset_locked(c, -EREMOTEIO);
+					/* A failed front sensor does not own rear-only mode. */
+					if (i == SSC_REAR_LIGHT ||
+					    !c->dual.lid_known || !c->dual.lid_closed)
+						c->dual.buffer_fault |= c->dual.buffered;
+				}
