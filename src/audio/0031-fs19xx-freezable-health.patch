From: Uke Linux contributors <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] ASoC: fs19xx: freeze delayed health work across system sleep

The health worker performs I2C transfers. Do not let it run after adapters
have suspended. The system freezable queue drains before device suspend and
thaws after device resume. Keep all five delays, mute/STOP/fault callbacks,
registers, gain and cancel paths unchanged. Runtime PM remains separate.

--- a/sound/soc/codecs/fs19xx.c
+++ b/sound/soc/codecs/fs19xx.c
@@ -522,7 +522,7 @@
 		 */
 		if (fs19xx->require_protection && q6apm_fs19xx_configured() &&
 		    time_before(now, fs19xx->stop_deadline)) {
-			mod_delayed_work(system_percpu_wq, &fs19xx->unmute_work,
+			mod_delayed_work(system_freezable_wq, &fs19xx->unmute_work,
 					 fs19xx->stop_deadline - now);
 			return;
 		}
@@ -532,7 +532,7 @@
 	if (fs19xx->require_protection && !q6apm_fs19xx_running()) {
 		if (!fs19xx->unmuted && q6apm_fs19xx_configured() &&
 		    ++fs19xx->pll_polls < FS19XX_LOCK_POLL_COUNT) {
-			mod_delayed_work(system_percpu_wq, &fs19xx->unmute_work,
+			mod_delayed_work(system_freezable_wq, &fs19xx->unmute_work,
 					 msecs_to_jiffies(FS19XX_LOCK_POLL_MS));
 			return;
 		}
@@ -550,7 +550,7 @@
 		goto stop;
 	if (!(status & FS19XX_STATUS_PLLS)) {
 		if (++fs19xx->pll_polls < FS19XX_LOCK_POLL_COUNT) {
-			mod_delayed_work(system_percpu_wq, &fs19xx->unmute_work,
+			mod_delayed_work(system_freezable_wq, &fs19xx->unmute_work,
 					 msecs_to_jiffies(FS19XX_LOCK_POLL_MS));
 			return;
 		}
@@ -562,7 +562,7 @@
 		goto stop;
 	fs19xx->unmuted = true;
 monitor:
-	mod_delayed_work(system_percpu_wq, &fs19xx->unmute_work,
+	mod_delayed_work(system_freezable_wq, &fs19xx->unmute_work,
 			 msecs_to_jiffies(FS19XX_HEALTH_POLL_MS));
 	return;
 
@@ -604,7 +604,7 @@
 	fs19xx->powered = true;
 	fs19xx->unmuted = false;
 	fs19xx->pll_polls = 0;
-	mod_delayed_work(system_percpu_wq, &fs19xx->unmute_work,
+	mod_delayed_work(system_freezable_wq, &fs19xx->unmute_work,
 			 msecs_to_jiffies(FS19XX_UNMUTE_DELAY_MS));
 	return 0;
 }
