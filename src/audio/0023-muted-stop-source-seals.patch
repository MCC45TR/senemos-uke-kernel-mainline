From: Uke Linux contributors <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] packaging: seal muted STOP bytes before retained source checks

Keep all historical source assertions on authenticated preimages. Require exact
new production bytes and finite-drain contracts before selecting those views.
Legacy isolated fixtures retain their original dependencies before the new layer.

--- a/packaging/native/check-oob-runtime731.sh
+++ b/packaging/native/check-oob-runtime731.sh
@@ -2,9 +2,16 @@
 # Retain the original runtime comparison, then require the exact OOB postimage.
 set -Eeuo pipefail
 kernel=$(realpath "${1:?Prepared cumulative kernel}")
+# Admit the muted deadline delta before selecting retained exact source views.
+uke_stop_codec_view=$kernel/sound/soc/codecs/fs19xx.c
+uke_stop_runtime_view=$kernel/sound/soc/qcom/qdsp6/uke-fs19xx-runtime.c
+uke_stop_muted_view=$kernel/sound/soc/codecs/uke-fs19xx-muted-stop.h
+if [[ -e $kernel/native-generated/codec-before-stop-deadline.c ]];then
+ source "$kernel/native-profile/packaging/native/stop-deadline-source-view.sh" "$kernel"
+fi
 # Authenticate idle18 before running exact retained17 source seals.
-idle_runtime=$kernel/sound/soc/qcom/qdsp6/uke-fs19xx-runtime.c
-idle_codec=$kernel/sound/soc/codecs/fs19xx.c
+idle_runtime=$uke_stop_runtime_view
+idle_codec=$uke_stop_codec_view
 if [[ -e $kernel/native-generated/runtime-before-idle-stop.c ]];then
  printf '%s  %s\n' \
  d9bf78985dd1de6db50daddce2c544d2b88496b085f821bcfdab86a44c4da157 "$idle_runtime" \
@@ -28,7 +35,7 @@
   e2ca68c256f47bb7bc339ffb4dfb5833dc5787904828eed68f75dafd613f77b8 "$kernel/native-generated/codec-before-protected-stop.c" \
   4c7ce07b2868cdc76fc0534f9bfe46805b956ebdb6200dacd44fa205579651e2 "$idle_codec" \
   465cf1060b9e0252ae5febf3b669034be67c08c86d6e00f42f669bea32c1804c "$kernel/sound/soc/qcom/qdsp6/uke-fs19xx-runtime.h" \
-  aac729f7c7c893cf69048da8c21c8c0cdf078dd9563ddf0a594c63323a004955 "$kernel/sound/soc/codecs/uke-fs19xx-muted-stop.h" \
+  aac729f7c7c893cf69048da8c21c8c0cdf078dd9563ddf0a594c63323a004955 "$uke_stop_muted_view" \
   aac729f7c7c893cf69048da8c21c8c0cdf078dd9563ddf0a594c63323a004955 "$profile/src/audio/uke-fs19xx-muted-stop.h" | sha256sum -c --strict --quiet -
  actual=$before_stop
 fi
