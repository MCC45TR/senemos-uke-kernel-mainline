From: Uke Linux contributors <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] tests: retain provisioning replay checks with enable control

Import the real added control descriptor, retain all old replay assertions,
and verify the third read-only control cannot restore a provisioning write.
Actual getter behavior is independently tested in617 lifecycle cases.

--- a/tests/audio-speaker-state-store-contract.sh
+++ b/tests/audio-speaker-state-store-contract.sh
@@ -25,6 +25,15 @@ static int fs19xx_control_put(void) { return 0; }
 static int fs19xx_state_info(void) { return 0; }
 static int fs19xx_state_get(void) { return 0; }
 C
+if grep -Fq 'UKE_FS19XX_ENABLE_CONTROL,' "$kernel/sound/soc/qcom/qdsp6/uke-fs19xx-runtime.c";then
+ cat >> "$stage/check.c" <<'C'
+static int fs19xx_enable_info(void) { return 0; }
+static int fs19xx_enable_get(void) { return 0; }
+C
+ awk '/^#define UKE_FS19XX_ENABLE_CONTROL[[:space:]]/ {emit=1;found++}
+ emit {print;if($0!~/\\$/)emit=0} END {if(found!=1)exit 1}' \
+  "$kernel/sound/soc/qcom/qdsp6/uke-fs19xx-enable-control.h" >> "$stage/check.c"
+fi
 awk '/^static const struct snd_kcontrol_new fs19xx_controls\[\] = [{]/ {emit=1}
  emit {print} emit && /^};/ {exit}' "$kernel/sound/soc/qcom/qdsp6/uke-fs19xx-runtime.c" >> "$stage/check.c"
 cat >> "$stage/check.c" <<'C'
@@ -57,6 +66,15 @@ int main(void)
  assert(!strcmp(fs19xx_controls[1].name, UKE_FS19XX_STATUS));
  assert(fs19xx_controls[1].access & SNDRV_CTL_ELEM_ACCESS_READ);
  assert(!(fs19xx_controls[1].access & SNDRV_CTL_ELEM_ACCESS_WRITE));
+#ifdef UKE_FS19XX_ENABLE_CONTROL
+ assert(sizeof(fs19xx_controls)/sizeof(fs19xx_controls[0]) == 3);
+ assert(!strcmp(fs19xx_controls[2].name, "FS19xx DSP Enable State"));
+ assert(fs19xx_controls[2].access & SNDRV_CTL_ELEM_ACCESS_READ);
+ assert(fs19xx_controls[2].access & SNDRV_CTL_ELEM_ACCESS_VOLATILE);
+ assert(!(fs19xx_controls[2].access & SNDRV_CTL_ELEM_ACCESS_WRITE));
+ assert(!fs19xx_controls[2].put);
+ assert(store_restore(&fs19xx_controls[2], &state) == 1 && state.status == UKE_FS_READY);
+#endif
  puts("Actual speaker control descriptor: legacy volatile zero replay faults; write-only provisioning preserves READY and exposes status separately; synthetic state only");
 }
 C
