From: Uke contributors <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] clk: qcom: retain unpublished CRM quarantine across s2idle

The permanent provider deliberately retains its resources when firmware CRM
is refused before publication. Generic forced runtime suspend interprets that
quarantine as an I/O fault and aborts every system suspend. Use dedicated system
sleep callbacks for this exact unpublished state, retaining the existing power
and ownership without clearing the camera refusal or claiming runtime suspend.
Deeper sleep and uncertain/partially published states retain the old refusal.

--- a/src/camera/camcc-sm7675.c
+++ b/src/camera/camcc-sm7675.c
@@ -16,4 +16,5 @@
 #include "provider/camcc-sm7675-clocks.h"
 #include "provider/camcc-sm7675-handoff.h"
 #include "provider/camcc-sm7675-registration.h"
+#include "provider/camcc-sm7675-sleep.h"
 
@@ -112,4 +113,4 @@
-		.pm = &cam_cc_power_pm_ops,
+		.pm = &cam_cc_native_pm_ops,
 		.sync_state = cam_cc_native_sync_state,
 		.suppress_bind_attrs = true,
 		.dev_groups = cam_cc_native_groups,
--- a/src/camera/provider/camcc-sm7675-owner.h
+++ b/src/camera/provider/camcc-sm7675-owner.h
@@ -7,4 +7,6 @@
 #include <linux/of.h>
 #include <linux/string.h>
 
+static const struct dev_pm_ops cam_cc_native_pm_ops;
+
 static bool cam_cc_owner_busy(void)
@@ -82,4 +84,5 @@
 	    dev->pm_domain || of_find_property(dev->of_node, "power-domains", NULL) ||
 	    !dev->driver || dev->driver->owner || !dev->driver->suppress_bind_attrs ||
-	    dev->driver->pm != &cam_cc_power_pm_ops)
+	    (dev->driver->pm != &cam_cc_power_pm_ops &&
+	     dev->driver->pm != &cam_cc_native_pm_ops))
 		return ERR_PTR(-EINVAL);
