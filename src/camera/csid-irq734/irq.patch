+				       csid->base + CSID_BUF_DONE_IRQ_CLEAR);
+				writel(IRQ_CMD_CLEAR, csid->base + CSID_IRQ_CMD);
+				writel(BIT(BUF_DONE_IRQ_STATUS_RDI_OFFSET + i),
