+/* Exact SM7675 CSID860/lite860 tables select CSID880/lite880 IRQs.
+ * Copyright (c) 2023 Qualcomm Innovation Center, Inc. All rights reserved.
+ * Firmware/controller ownership and power must already belong to CAMSS.
+ */
+static int csid_reset_irqs_7675(struct csid_device *csid)
+{
+	u32 top = TOP_IRQ_STATUS_RESET_DONE, done = 0;
+	int i;
+
+	/* The native full VFE has three RDI lines; lite has four. */
+	if (csid->phy.en_vc & ~GENMASK(csid_is_lite(csid) ? 3 : 2, 0))
+		return -EINVAL;
+
+	/* Keep delivery masked until all owned status and masks are prepared. */
+	writel(0, csid->base + CSID_TOP_IRQ_MASK);
+	for (i = 0; i < MSM_CSID_MAX_SRC_STREAMS; i++) {
+		if (!(csid->phy.en_vc & BIT(i)))
+			continue;
+		top |= BIT(8 + i);
+		done |= BIT(BUF_DONE_IRQ_STATUS_RDI_OFFSET + i);
+		writel(RUP_DONE_IRQ_STATUS,
+		       csid->base + CSID_CSI2_RDIN_IRQ_CLEAR(i));
+		writel(RUP_DONE_IRQ_STATUS,
+		       csid->base + CSID_CSI2_RDIN_IRQ_MASK(i));
+	}
+	if (done)
+		top |= BIT(13);
+	writel(done, csid->base + CSID_BUF_DONE_IRQ_CLEAR);
+	writel(done, csid->base + CSID_BUF_DONE_IRQ_MASK);
+	writel(top, csid->base + CSID_TOP_IRQ_CLEAR);
+	writel(IRQ_CMD_CLEAR, csid->base + CSID_IRQ_CMD);
+	writel(top, csid->base + CSID_TOP_IRQ_MASK);
+	return 0;
+}
