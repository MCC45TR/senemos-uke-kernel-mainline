+void require_super_root_note(const std::vector<uint8_t>& image) {
+    constexpr char descriptor[] = "super-root-v1;role=rescue;root=dm-uke-rescue;readonly;noresume;seed=4GiB";
+    std::vector<uint8_t> note(16 + (sizeof(descriptor) + 3) / 4 * 4, 0);
+    put32(note.data(), 4);
+    put32(note.data() + 4, sizeof(descriptor));
+    put32(note.data() + 8, 0x554b4503);
+    std::memcpy(note.data() + 12, "UKE", 4);
+    std::memcpy(note.data() + 16, descriptor, sizeof(descriptor));
+    auto first = std::search(image.begin(), image.end(), note.begin(), note.end());
+    if (first == image.end() || static_cast<size_t>(first - image.begin()) % 4 ||
+        std::search(first + 1, image.end(), note.begin(), note.end()) != image.end())
+        throw std::runtime_error("Super profiles require one exact aligned seed4 kernel capability note");
+    auto text = std::search(image.begin(), image.end(), descriptor, descriptor + sizeof(descriptor) - 1);
+    if (text != first + 16 || std::search(text + 1, image.end(), descriptor,
+                                       descriptor + sizeof(descriptor) - 1) != image.end())
+        throw std::runtime_error("Duplicate or malformed super-profile capability declaration");
+}
