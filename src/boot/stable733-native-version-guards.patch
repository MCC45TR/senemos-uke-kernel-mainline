From: Uke Linux contributors <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] build: admit signed Linux7.3.3 and sequential unstable tuples

Keep every retained hardware check and existing supported tuple.

--- a/prepare.sh
+++ b/prepare.sh
@@ -148,7 +148,7 @@
     git -C "$kernel" apply "$profile/patches/boot/0009-uke-displayport-dma-scope.patch"
     bash "$profile/tests/dp-audio-admission-contract.sh" "$kernel"
     sha256sum "$profile/patches/boot/0009-uke-displayport-dma-scope.patch" >> "$output/abl-source-SHA256SUMS"
-    if [[ $(jq -er .version "$kernel/senemos-adaptation/source-lock.json") == 7.3.[01] ]]; then
+    if [[ $(jq -er .version "$kernel/senemos-adaptation/source-lock.json") == 7.3.[01] || $(jq -er .version "$kernel/senemos-adaptation/source-lock.json") == 7.3.3 ]]; then
         git -C "$kernel" apply --check "$profile/patches/display/0057-uke-displayport-eld-notification.patch"
         git -C "$kernel" apply "$profile/patches/display/0057-uke-displayport-eld-notification.patch"
         bash "$profile/tests/dp-eld-notification-contract.sh" "$kernel/sound/soc/codecs/hdmi-codec.c"
--- a/src/boot/prepare-abl-source.sh
+++ b/src/boot/prepare-abl-source.sh
@@ -13,7 +13,7 @@
     *) echo 'Unknown LLCC source profile' >&2; exit 2;;
 esac
 version=$(jq -er .version "$kernel/senemos-adaptation/source-lock.json")
-case $version in 7.2.9|7.2.10|7.2.11|7.2.12|7.3.0|7.3.1) ;; *) exit 1;; esac
+case $version in 7.2.9|7.2.10|7.2.11|7.2.12|7.3.0|7.3.1|7.3.3) ;; *) exit 1;; esac
 series=$(jq -er '.patch_series // .version' "$kernel/senemos-adaptation/source-lock.json")
 case $series in 7.2.9|7.2.10|7.2.11|7.2.12|7.3.0) ;; *) exit 1;; esac
 [[ $(awk '/^VERSION =/ {v=$3} /^PATCHLEVEL =/ {p=$3} /^SUBLEVEL =/ {s=$3} END {print v "." p "." s}' "$kernel/Makefile") == "$version" ]]
--- a/src/display/prepare-source.sh
+++ b/src/display/prepare-source.sh
@@ -5,7 +5,7 @@
 kernel=$(realpath "$1")
 here=$(cd -- "$(dirname -- "$0")" && pwd)
 version=$(jq -er .version "$kernel/senemos-adaptation/source-lock.json")
-case $version in 7.2.9|7.2.10|7.2.11|7.2.12|7.3.0|7.3.1) ;; *) exit 1;; esac
+case $version in 7.2.9|7.2.10|7.2.11|7.2.12|7.3.0|7.3.1|7.3.3) ;; *) exit 1;; esac
 [[ $(awk '/^VERSION =/ {v=$3} /^PATCHLEVEL =/ {p=$3} /^SUBLEVEL =/ {s=$3} END {print v "." p "." s}' "$kernel/Makefile") == "$version" ]]
 cmp "$kernel/senemos-applied-patches.txt" <(jq -er '.patches[].path | split("/") | last' "$kernel/senemos-adaptation/source-lock.json")
 patch=$here/../../patches/display/7.2.10/0001-native-display-providers.patch
@@ -22,7 +22,7 @@
     include/drm/uke-o82-mode.h
     include/drm/uke-o82-avr.h
 )
-if [[ $version == 7.3.0 || $version == 7.3.1 ]]; then
+if [[ $version == 7.3.0 || $version == 7.3.1 || $version == 7.3.3 ]]; then
     paths+=(drivers/gpu/drm/msm/dp/dp_dsc.c drivers/gpu/drm/msm/dp/dp_dsc.h)
 fi
 for path in "${paths[@]}"; do [[ ! -e $kernel/$path ]]; done
@@ -89,7 +89,7 @@
     git -C "$kernel" apply --check "$patch"
     git -C "$kernel" apply "$patch"
 done
-if [[ $version == 7.3.0 || $version == 7.3.1 ]]; then
+if [[ $version == 7.3.0 || $version == 7.3.1 || $version == 7.3.3 ]]; then
     patch=$here/../../patches/display/0059-uke-displayport-rgb-dsc-fec.patch
     git -C "$kernel" apply --check "$patch"
     git -C "$kernel" apply "$patch"
--- a/src/display/prepare-o82-regdma.sh
+++ b/src/display/prepare-o82-regdma.sh
@@ -3,7 +3,7 @@
 set -Eeuo pipefail
 kernel=$(realpath "${1:?Pass the prepared kernel source}")
 owner=$(cd -- "$(dirname -- "$0")/../.." && pwd)
-[[ $(jq -er .version "$kernel/senemos-adaptation/source-lock.json") == 7.3.1 ]]
+[[ $(jq -er .version "$kernel/senemos-adaptation/source-lock.json") == 7.3.1 || $(jq -er .version "$kernel/senemos-adaptation/source-lock.json") == 7.3.3 ]]
 git -C "$kernel" apply --check "$owner/patches/display/0072-o82-regdma-resource.patch"
 git -C "$kernel" apply "$owner/patches/display/0072-o82-regdma-resource.patch"
 git -C "$kernel" apply --check "$owner/patches/display/0073-o82-regdma-power.patch"
--- a/src/video/prepare-source.sh
+++ b/src/video/prepare-source.sh
@@ -6,7 +6,7 @@
 manifest=$root/manifests/video-linux73-candidate-20261025.json
 jq -e '.upstream_version == "7.3.0"' "$manifest" >/dev/null
 version=$(awk '/^VERSION =/{v=$3} /^PATCHLEVEL =/{p=$3} /^SUBLEVEL =/{s=$3} END{print v "." p "." s}' "$kernel/Makefile")
-case $version in 7.3.0|7.3.1) ;; *) exit 1;; esac
+case $version in 7.3.0|7.3.1|7.3.3) ;; *) exit 1;; esac
 [[ ! -e $kernel/include/linux/qcom-uke-video.h ]]
 mkdir -p "$kernel/native-generated"
 : > "$kernel/native-generated/video-source-SHA256SUMS"
--- a/tests/camcc-native-object.sh
+++ b/tests/camcc-native-object.sh
@@ -7,14 +7,14 @@
 output=$(realpath -m -- "$2")
 config=$(realpath -- "$3")
 release=$4
-[[ $release =~ ^7\.3\.1-[1-9][0-9]{3,4}(-unstable)?$ ]]
+[[ $release =~ ^7\.3\.1-[1-9][0-9]{3,4}(-unstable)?$ || $release =~ ^7\.3\.3-[1-9][0-9]*-unstable$ ]]
 project=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
 mkdir -p "$output"
 test ! -e "$output/arch/arm64/boot/Image"
 cp "$config" "$output/.config"
 bash "$kernel/scripts/config" --file "$output/.config" --set-str INITRAMFS_SOURCE ''
 make -C "$kernel" ARCH=arm64 LLVM=1 LLVM_IAS=1 O="$output" \
-    LOCALVERSION="-${release#7.3.1-}" olddefconfig prepare modules_prepare
+    LOCALVERSION="-${release#*-}" olddefconfig prepare modules_prepare
 stage=$output/camcc-native-object
 mkdir -p "$stage"
 cp "$project/src/camera/camcc-sm7675.c" "$stage/camcc-native-builtin.c"
@@ -23,7 +23,7 @@
     'CFLAGS_camcc-native-inspect.o += -DUKE_CAMCC_OBJECT_TEST' \
     "ccflags-y += -I$project/src/camera -I$project/src/camera/include -I$kernel/drivers/clk/qcom" > "$stage/Makefile"
 make -C "$kernel" ARCH=arm64 LLVM=1 LLVM_IAS=1 O="$output" M="$stage" \
-    LOCALVERSION="-${release#7.3.1-}" KCFLAGS=-Werror -j4 \
+    LOCALVERSION="-${release#*-}" KCFLAGS=-Werror -j4 \
     camcc-native-builtin.o camcc-native-inspect.o
 for variant in builtin inspect; do
     llvm-readelf -h "$stage/camcc-native-$variant.o" | grep -E 'Machine:.*AArch64'
--- a/tests/camss-sm7675-module731-object.sh
+++ b/tests/camss-sm7675-module731-object.sh
@@ -5,7 +5,7 @@
 kernel=$(realpath "$1")
 output=$(realpath "$2")
 release=$3
-[[ $release =~ ^7\.3\.1-[1-9][0-9]{3,4}(-unstable)?$ ]]
+[[ $release =~ ^7\.3\.1-[1-9][0-9]{3,4}(-unstable)?$ || $release =~ ^7\.3\.3-[1-9][0-9]*-unstable$ ]]
 test -f "$output/include/generated/autoconf.h"
 grep -Fx 'CONFIG_VIDEO_QCOM_CAMSS=m' "$output/.config"
 test ! -e "$output/arch/arm64/boot/Image"
@@ -15,7 +15,7 @@
 cp "$kernel/drivers/media/platform/qcom/camss/"*.c "$stage/"
 cp "$kernel/drivers/media/platform/qcom/camss/"*.h "$stage/"
 make -C "$kernel" ARCH=arm64 LLVM=1 LLVM_IAS=1 O="$output" M="$stage" \
- LOCALVERSION="-${release#7.3.1-}" KCFLAGS=-Werror -j4 qcom-camss.o
+ LOCALVERSION="-${release#*-}" KCFLAGS=-Werror -j4 qcom-camss.o
 llvm-readelf -h "$stage/qcom-camss.o" | grep -E 'Machine:.*AArch64'
 llvm-nm --defined-only "$stage/qcom-camss.o" | awk '$NF=="csiphy_ops_sm7675" {found=1} END {exit !found}'
 test ! -e "$output/arch/arm64/boot/Image"
--- a/tests/camss-sm7675-phy-object.sh
+++ b/tests/camss-sm7675-phy-object.sh
@@ -5,7 +5,7 @@
 kernel=$(realpath "$1")
 output=$(realpath "$2")
 release=$3
-[[ $release =~ ^7\.3\.1-[1-9][0-9]{3,4}(-unstable)?$ ]]
+[[ $release =~ ^7\.3\.1-[1-9][0-9]{3,4}(-unstable)?$ || $release =~ ^7\.3\.3-[1-9][0-9]*-unstable$ ]]
 project=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
 test -f "$output/include/generated/autoconf.h"
 test ! -e "$output/arch/arm64/boot/Image"
@@ -29,7 +29,7 @@
 printf '%s\n' 'obj-y += camss-sm7675-phy.o' \
  "ccflags-y += -I$project/src/camera/camss -I$kernel/drivers/media/platform/qcom/camss" > "$stage/Makefile"
 make -C "$kernel" ARCH=arm64 LLVM=1 LLVM_IAS=1 O="$output" M="$stage" \
- LOCALVERSION="-${release#7.3.1-}" KCFLAGS=-Werror camss-sm7675-phy.o
+ LOCALVERSION="-${release#*-}" KCFLAGS=-Werror camss-sm7675-phy.o
 llvm-readelf -h "$stage/camss-sm7675-phy.o" | grep -E 'Machine:.*AArch64'
 test -z "$(llvm-readelf -SW "$stage/camss-sm7675-phy.o" | grep -F '.initcall' || true)"
 test ! -e "$output/arch/arm64/boot/Image"
