[Unit]
Description=Uke CDC ACM gadget for the explicit Core debug profile
Documentation=https://docs.kernel.org/usb/gadget_serial.html
After=systemd-udev-trigger.service
ConditionKernelCommandLine=senemos.debug=cdc-acm
ConditionPathExists=/sys/firmware/devicetree/base/compatible

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/uke-boot-status --cdc --wait 15
ExecStart=/usr/sbin/modprobe g_serial use_acm=1
ExecStop=/usr/sbin/modprobe -r g_serial
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
