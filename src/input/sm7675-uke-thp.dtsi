#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>

/* Explicit candidate: existing Uke IRQ54, high panel-ID26 and native O82 panel. */
/ {
	fragment@240 {
		target-path = "/soc/qcom,qupv3_0_geni_se@ac0000/spi@a90000/novatek@0";
		__overlay__ {
			compatible = "novatek,nt36532-uke-thp";
			interrupt-parent = <&tlmm>;
			interrupts = <54 IRQ_TYPE_EDGE_RISING>;
			panel-id-gpios = <&tlmm 26 GPIO_ACTIVE_HIGH>;
			panel = <&uke_panel>;
			wakeup-source;
		};
	};
};
